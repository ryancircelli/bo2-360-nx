+bool SharedMemory::CaptureRanges(const Range* ranges, uint32_t range_count,
+                                 std::vector<uint8_t>& arena,
+                                 std::vector<CapturedRun>& runs) {
+  capture_page_runs_.clear();
+  {
+    auto global_lock = global_critical_region_.Acquire();
+    uint64_t* valid_flags = active_valid_flags_.load(std::memory_order_relaxed);
+    for (uint32_t i = 0; i < range_count; ++i) {
+      const Range& range = ranges[i];
+      if (!range.length) {
+        continue;
+      }
+      if (range.start >= kBufferSize ||
+          (kBufferSize - range.start) < range.length) {
+        return false;
+      }
+      uint32_t page_first = range.start >> page_size_log2_;
+      uint32_t page_last = (range.start + range.length - 1) >> page_size_log2_;
+      uint32_t run_first = UINT32_MAX;
+      for (uint32_t page = page_first; page <= page_last; ++page) {
+        uint64_t block = valid_flags[page >> 6];
+        if (block == UINT64_MAX && !(page & 63) && page + 63 <= page_last &&
+            run_first == UINT32_MAX) {
+          page += 63;
+          continue;
+        }
+        bool valid = (block >> (page & 63)) & 1;
+        if (!valid) {
+          if (run_first == UINT32_MAX) {
+            run_first = page;
+          }
+        } else if (run_first != UINT32_MAX) {
+          capture_page_runs_.emplace_back(run_first, page);
+          run_first = UINT32_MAX;
+        }
+      }
+      if (run_first != UINT32_MAX) {
+        capture_page_runs_.emplace_back(run_first, page_last + 1);
+      }
+    }
+  }
+  if (capture_page_runs_.empty()) {
+    return true;
+  }
+  std::sort(capture_page_runs_.begin(), capture_page_runs_.end());
+  size_t merged = 0;
+  for (size_t i = 0; i < capture_page_runs_.size(); ++i) {
+    if (merged && capture_page_runs_[i].first <= capture_page_runs_[merged - 1].second) {
+      capture_page_runs_[merged - 1].second =
+          std::max(capture_page_runs_[merged - 1].second, capture_page_runs_[i].second);
+    } else {
+      capture_page_runs_[merged++] = capture_page_runs_[i];
+    }
+  }
+  capture_page_runs_.resize(merged);
+  const uint8_t* guest = memory().TranslatePhysical<const uint8_t*>(0);
+  for (const auto& page_run : capture_page_runs_) {
+    CapturedRun run;
+    run.start = page_run.first << page_size_log2_;
+    run.length = (page_run.second - page_run.first) << page_size_log2_;
+    run.arena_offset = uint32_t(arena.size());
+    // Valid (and watched) first, then copy: a guest write racing the copy
+    // invalidates the pages again, as in the upload paths.
+    MakeRangeValid(run.start, run.length, false);
+    arena.resize(arena.size() + run.length);
+    std::memcpy(arena.data() + run.arena_offset, guest + run.start, run.length);
+    runs.push_back(run);
+  }
+  return true;
 }
 
+bool SharedMemory::UploadCapturedRun(const CapturedRun& run,
+                                     const uint8_t* arena) {
+  if (!run.length) {
+    return true;
+  }
+  if (!EnsureHostGpuMemoryAllocated(run.start, run.length)) {
+    return false;
+  }
+  uint32_t page_first = run.start >> page_size_log2_;
+  uint32_t page_last = (run.start + run.length - 1) >> page_size_log2_;
+  FireWatches(page_first, page_last, false);
+  std::pair<uint32_t, uint32_t> upload(page_first, page_last - page_first + 1);
+  captured_upload_base_ = arena + run.arena_offset - run.start;
+  bool result = UploadRanges(&upload, 1);
+  captured_upload_base_ = nullptr;
+  return result;
+}
