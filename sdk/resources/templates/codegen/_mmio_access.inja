//=============================================================================
// MMIO
//=============================================================================

#define REX_IS_MMIO_ADDR(addr) ((u32)(addr) >= 0x7F000000u && (u32)(addr) < 0x80000000u)

#define REX_MM_STORE_U8(addr, val)                                                         \
  do {                                                                                     \
    u32 _mmio_addr = (addr);                                                               \
    if (REX_IS_MMIO_ADDR(_mmio_addr)) {                                                    \
      rex::runtime::MMIOHandler::global_handler()->CheckStore(_mmio_addr,                  \
                                                              static_cast<u32>(val));      \
    } else {                                                                               \
      *(volatile u8*)(base + _mmio_addr + REX_PHYS_HOST_OFFSET(_mmio_addr)) = (val);       \
    }                                                                                      \
  } while (0)

#define REX_MM_STORE_U16(addr, val)                                                        \
  do {                                                                                     \
    u32 _mmio_addr = (addr);                                                               \
    if (REX_IS_MMIO_ADDR(_mmio_addr)) {                                                    \
      rex::runtime::MMIOHandler::global_handler()->CheckStore(_mmio_addr,                  \
                                                              static_cast<u32>(val));      \
    } else {                                                                               \
      *(volatile u16*)(base + _mmio_addr + REX_PHYS_HOST_OFFSET(_mmio_addr)) =             \
          __builtin_bswap16(val);                                                          \
    }                                                                                      \
  } while (0)

#define REX_MM_STORE_U32(addr, val)                                                        \
  do {                                                                                     \
    u32 _mmio_addr = (addr);                                                               \
    if (REX_IS_MMIO_ADDR(_mmio_addr)) {                                                    \
      rex::runtime::MMIOHandler::global_handler()->CheckStore(_mmio_addr,                  \
                                                              static_cast<u32>(val));      \
    } else {                                                                               \
      *(volatile u32*)(base + _mmio_addr + REX_PHYS_HOST_OFFSET(_mmio_addr)) =             \
          __builtin_bswap32(val);                                                          \
    }                                                                                      \
  } while (0)

#define REX_MM_STORE_U64(addr, val)                                                               \
  do {                                                                                            \
    u32 _mmio_addr = (addr);                                                                      \
    if (REX_IS_MMIO_ADDR(_mmio_addr)) {                                                           \
      u64 _v64 = static_cast<u64>(val);                                                           \
      rex::runtime::MMIOHandler::global_handler()->CheckStore(_mmio_addr,                         \
                                                              static_cast<u32>(_v64 >> 32));      \
      rex::runtime::MMIOHandler::global_handler()->CheckStore(_mmio_addr + 4,                     \
                                                              static_cast<u32>(_v64));            \
    } else {                                                                                      \
      *(volatile u64*)(base + _mmio_addr + REX_PHYS_HOST_OFFSET(_mmio_addr)) =                    \
          __builtin_bswap64(val);                                                                 \
    }                                                                                             \
  } while (0)

#define REX_MM_LOAD_U8(addr)                                           \
  (REX_IS_MMIO_ADDR(addr) ? ({                                         \
    u32 _v;                                                            \
    rex::runtime::MMIOHandler::global_handler()->CheckLoad(addr, &_v); \
    static_cast<u8>(_v);                                               \
  })                                                                   \
                          : *(volatile u8*)(base + (u32)(addr) + REX_PHYS_HOST_OFFSET(addr)))

#define REX_MM_LOAD_U16(addr)                                                 \
  (REX_IS_MMIO_ADDR(addr)                                                     \
       ? ({                                                                   \
           u32 _v;                                                            \
           rex::runtime::MMIOHandler::global_handler()->CheckLoad(addr, &_v); \
           static_cast<u16>(_v);                                              \
         })                                                                   \
       : __builtin_bswap16(*(volatile u16*)(base + (u32)(addr) + REX_PHYS_HOST_OFFSET(addr))))

#define REX_MM_LOAD_U32(addr)                                                 \
  (REX_IS_MMIO_ADDR(addr)                                                     \
       ? ({                                                                   \
           u32 _v;                                                            \
           rex::runtime::MMIOHandler::global_handler()->CheckLoad(addr, &_v); \
           _v;                                                                \
         })                                                                   \
       : __builtin_bswap32(*(volatile u32*)(base + (u32)(addr) + REX_PHYS_HOST_OFFSET(addr))))

#define REX_MM_LOAD_U64(addr)                                                        \
  (REX_IS_MMIO_ADDR(addr)                                                            \
       ? ({                                                                          \
           u32 _hi, _lo;                                                             \
           rex::runtime::MMIOHandler::global_handler()->CheckLoad(addr, &_hi);       \
           rex::runtime::MMIOHandler::global_handler()->CheckLoad((addr) + 4, &_lo); \
           (static_cast<u64>(_hi) << 32) | _lo;                                      \
         })                                                                          \
       : __builtin_bswap64(*(volatile u64*)(base + (u32)(addr) + REX_PHYS_HOST_OFFSET(addr))))