+namespace {
+
+std::atomic<bool> text_input_open_{false};
+std::atomic<int64_t> text_input_closed_ms_{std::numeric_limits<int64_t>::min() / 2};
+
+int64_t TextInputNow() {
+  return std::chrono::duration_cast<std::chrono::milliseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+}  // namespace
+
+bool ShowTextInput(std::string title, std::string default_text, size_t max_length,
+                   std::function<void(std::optional<std::string>)> done) {
+  bool expected = false;
+  if (!text_input_open_.compare_exchange_strong(expected, true)) {
+    return false;
+  }
+  try {
+    std::thread([title = std::move(title), default_text = std::move(default_text), max_length,
+                 done = std::move(done)]() mutable {
+      std::optional<std::string> result;
+      auto* kernel_state = REX_KERNEL_STATE();
+      const Runtime* emulator = kernel_state ? kernel_state->emulator() : nullptr;
+      ui::ImGuiDrawer* drawer = emulator ? emulator->imgui_drawer() : nullptr;
+      if (drawer) {
+        auto close = [&result](KeyboardInputDialog* dialog) -> X_RESULT {
+          if (!dialog->cancelled()) {
+            result = dialog->text();
+          }
+          return X_ERROR_SUCCESS;
+        };
+        xeXamDispatchDialog<KeyboardInputDialog>(
+            new KeyboardInputDialog(drawer, title, "", default_text, max_length + 1), close, 0);
+      }
+      text_input_closed_ms_ = TextInputNow();
+      text_input_open_ = false;
+      done(std::move(result));
+    }).detach();
+  } catch (const std::system_error&) {
+    text_input_open_ = false;
+    return false;
+  }
+  return true;
+}
+
+bool TextInputOpen() {
+  return text_input_open_.load(std::memory_order_relaxed) ||
+         TextInputNow() - text_input_closed_ms_.load(std::memory_order_relaxed) < 300;
+}
