diff --git a/src/system/system_link_socket.cpp b/src/system/system_link_socket.cpp
new file mode 100644
index 00000000..aec92bc6
--- /dev/null
+++ b/src/system/system_link_socket.cpp
@@ -0,0 +1,552 @@
+// SPDX-License-Identifier: 0BSD
+#include <rex/platform.h>
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstring>
+#include <deque>
+#include <map>
+#include <mutex>
+#include <vector>
+
+#include <rex/logging.h>
+#include <rex/system/online_link.h>
+#include <rex/system/online_relay.h>
+#include <rex/system/system_link.h>
+#include <rex/system/xsocket.h>
+
+#include "system_link_socket.h"
+
+#if REX_PLATFORM_WIN32
+#include <WinSock2.h>
+#include <WS2tcpip.h>
+#else
+#include <arpa/inet.h>
+#include <fcntl.h>
+#include <netinet/in.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#endif
+
+namespace rex::system::system_link {
+namespace {
+
+using Clock = std::chrono::steady_clock;
+
+sockaddr_in HostAddress(uint32_t ip, uint16_t port) {
+  sockaddr_in address{};
+#if REX_PLATFORM_MAC
+  address.sin_len = sizeof(address);
+#endif
+  address.sin_family = AF_INET;
+  address.sin_addr.s_addr = htonl(ip);
+  address.sin_port = htons(port);
+  return address;
+}
+
+int SendRaw(int64_t socket, uint32_t ip, uint16_t port, const uint8_t* data, size_t size,
+            int flags) {
+  if (socket < 0) {
+    return -1;
+  }
+  const auto address = HostAddress(ip, port);
+  return int(sendto(socket, reinterpret_cast<const char*>(data), int(size), flags,
+                    reinterpret_cast<const sockaddr*>(&address), sizeof(address)));
+}
+
+struct Console {
+  uint32_t public_ip = 0;
+  uint64_t session = 0;
+  uint32_t lan_ip = 0;
+  uint32_t stand_in = 0;
+  std::array<uint16_t, 3> seeded{};
+  std::array<uint16_t, 3> heard_ports{};
+  std::array<Clock::time_point, 3> heard{};
+};
+
+struct PeerObservation {
+  uint32_t ip = 0;
+  Clock::time_point heard{};
+};
+
+struct SidePacket {
+  std::vector<uint8_t> data;
+  uint32_t ip = 0;
+  uint16_t port = 0;
+};
+
+struct SocketState {
+  std::mutex mutex;
+  std::map<int64_t, uint16_t> title_sockets;
+  std::vector<Console> consoles;
+  std::map<uint16_t, PeerObservation> last_peer;
+  int64_t side = -1;
+  int side_users = 0;
+  uint16_t side_port = 0;
+  bool side_bound = false;
+  std::deque<SidePacket> side_packets;
+};
+
+SocketState state;
+
+int PortIndex(uint16_t guest_port) {
+  if (guest_port >= 1000 && guest_port <= 1002) {
+    return guest_port - 1000;
+  }
+  return -1;
+}
+
+Console& ConsoleFor(uint32_t public_ip, uint64_t session) {
+  for (Console& console : state.consoles) {
+    if (console.public_ip == public_ip && (!session || !console.session || console.session == session)) {
+      if (session) {
+        console.session = session;
+      }
+      return console;
+    }
+  }
+  if (state.consoles.size() >= 32) {
+    state.consoles.erase(state.consoles.begin());
+  }
+  Console console;
+  console.public_ip = public_ip;
+  console.session = session;
+  const uint32_t own = online::PublicAddress();
+  const bool shared = own && own == public_ip;
+  for (const Console& other : state.consoles) {
+    if (other.public_ip == public_ip && other.stand_in) {
+      console.stand_in = 0xF0420000u + uint32_t(state.consoles.size() % 250 + 1);
+      break;
+    }
+  }
+  if (shared && !console.stand_in) {
+    console.stand_in = 0xF0420000u + uint32_t(state.consoles.size() % 250 + 1);
+  }
+  state.consoles.push_back(console);
+  return state.consoles.back();
+}
+
+Console* FindConsole(uint32_t title_ip) {
+  for (Console& console : state.consoles) {
+    if (console.public_ip == title_ip || console.stand_in == title_ip) {
+      return &console;
+    }
+  }
+  return nullptr;
+}
+
+uint32_t TitleViewUnlocked(uint32_t ip) {
+  Console* console = FindConsole(ip);
+  return console && console->stand_in ? console->stand_in : ip;
+}
+
+uint32_t TitleView(uint32_t ip) {
+  std::lock_guard lock(state.mutex);
+  return TitleViewUnlocked(ip);
+}
+
+void NoteHeardLocked(uint32_t ip, uint16_t source_port, uint16_t guest_port, uint64_t session) {
+  const auto now = Clock::now();
+  state.last_peer[guest_port] = {TitleViewUnlocked(ip), now};
+  Console& console = ConsoleFor(ip, session);
+  const int index = PortIndex(guest_port);
+  if (index >= 0) {
+    console.heard_ports[index] = source_port;
+    console.heard[index] = now;
+  }
+}
+
+void NoteHeard(uint32_t ip, uint16_t source_port, uint16_t guest_port, uint64_t session = 0) {
+  std::lock_guard lock(state.mutex);
+  NoteHeardLocked(ip, source_port, guest_port, session);
+}
+
+uint32_t Read32(const uint8_t* bytes) {
+  return (uint32_t(bytes[0]) << 24) | (uint32_t(bytes[1]) << 16) |
+         (uint32_t(bytes[2]) << 8) | bytes[3];
+}
+
+uint64_t Read64(const uint8_t* bytes) {
+  return (uint64_t(Read32(bytes)) << 32) | Read32(bytes + 4);
+}
+
+void Write32(uint8_t* out, uint32_t value) {
+  out[0] = uint8_t(value >> 24);
+  out[1] = uint8_t(value >> 16);
+  out[2] = uint8_t(value >> 8);
+  out[3] = uint8_t(value);
+}
+
+void Write64(uint8_t* out, uint64_t value) {
+  Write32(out, uint32_t(value >> 32));
+  Write32(out + 4, uint32_t(value));
+}
+
+void ConsumeRelayLocked(uint32_t ip, uint16_t port, const uint8_t* data, int size) {
+  if (size >= 18 && std::memcmp(data, "BO2ZMPCH", 8) == 0) {
+    const uint64_t session = Read64(data + 8);
+    const uint16_t guest_port = uint16_t(data[16] << 8 | data[17]);
+    Console& peer = ConsoleFor(ip, session);
+    const int index = PortIndex(guest_port);
+    if (index >= 0) {
+      peer.seeded[index] = port;
+    }
+    NoteHeardLocked(ip, port, guest_port, session);
+  }
+}
+
+void ConsumeRelay(uint32_t ip, uint16_t port, const uint8_t* data, int size) {
+  std::lock_guard lock(state.mutex);
+  ConsumeRelayLocked(ip, port, data, size);
+}
+
+void PumpSideSocketLocked() {
+  if (state.side < 0) {
+    return;
+  }
+  while (true) {
+    uint8_t buffer[65536];
+    sockaddr_in source{};
+    socklen_t source_size = sizeof(source);
+    const int count = recvfrom(state.side, reinterpret_cast<char*>(buffer), sizeof(buffer), 0,
+                               reinterpret_cast<sockaddr*>(&source), &source_size);
+    if (count <= 0) {
+      break;
+    }
+    uint32_t ip = ntohl(source.sin_addr.s_addr);
+    uint16_t port = ntohs(source.sin_port);
+    const online::Datagram kind = online::Classify(state.side_port, ip, port, buffer, count);
+    if (kind != online::Datagram::kTitle) {
+      if (kind == online::Datagram::kPunch) {
+        ConsumeRelayLocked(ip, port, buffer, count);
+      }
+      continue;
+    }
+    if (state.side_packets.size() >= 64) {
+      state.side_packets.pop_front();
+    }
+    state.side_packets.push_back(
+        {std::vector<uint8_t>(buffer, buffer + count), TitleViewUnlocked(ip), port});
+    NoteHeardLocked(ip, port, 1002, 0);
+  }
+}
+
+}  // namespace
+
+void RegisterTitleSocket(int64_t socket, uint16_t guest_port) {
+  if (guest_port > 0 && guest_port < 1024) {
+    std::lock_guard lock(state.mutex);
+    state.title_sockets[socket] = guest_port;
+  }
+}
+
+void UnregisterTitleSocket(int64_t socket) {
+  std::lock_guard lock(state.mutex);
+  state.title_sockets.erase(socket);
+}
+
+bool FilterTitlePacket(uint16_t guest_port, uint32_t* ip, uint16_t* port, const uint8_t* data,
+                       int size) {
+  const online::Datagram kind = online::Classify(HostPort(guest_port), *ip, *port, data, size);
+  if (kind != online::Datagram::kTitle) {
+    if (kind == online::Datagram::kPunch) {
+      ConsumeRelay(*ip, *port, data, size);
+    }
+    return false;
+  }
+  if (!IsSelf(*ip)) {
+    NoteHeard(*ip, *port, guest_port);
+  }
+  if (online::PublicAddress() && !OnLan(*ip) && !IsSelf(*ip)) {
+    *ip = TitleView(*ip);
+    *port = guest_port;
+  }
+  return true;
+}
+
+bool SendOnline(int64_t socket, uint32_t ip, uint16_t guest_port, uint16_t host_port,
+                const uint8_t* data, size_t size, int flags, int* result) {
+  if (!online::PublicAddress()) {
+    return false;
+  }
+  std::lock_guard lock(state.mutex);
+  Console* console = FindConsole(ip);
+  const bool internet = console || (!OnLan(ip) && !IsSelf(ip));
+  if (!internet) {
+    return false;
+  }
+  uint32_t destination = console ? console->public_ip : ip;
+  uint16_t destination_port = host_port;
+  const int index = PortIndex(guest_port);
+  if (console && index >= 0 && host_port == HostPort(guest_port)) {
+    if (console->heard_ports[index]) {
+      destination_port = console->heard_ports[index];
+    } else if (console->seeded[index]) {
+      destination_port = console->seeded[index];
+    }
+  }
+  *result = SendRaw(socket, destination, destination_port, data, size, flags);
+  return true;
+}
+
+void BroadcastOnline(int64_t socket, uint16_t guest_port, const uint8_t* data, size_t size,
+                     int flags) {
+  if (!online::PublicAddress() || guest_port == 0 || guest_port >= 1024) {
+    return;
+  }
+  std::vector<std::pair<uint32_t, uint16_t>> targets;
+  {
+    std::lock_guard lock(state.mutex);
+    const auto now = Clock::now();
+    const int index = PortIndex(guest_port);
+    for (Console& console : state.consoles) {
+      if (index >= 0 && console.heard_ports[index] &&
+          now - console.heard[index] <= std::chrono::seconds(15)) {
+        targets.emplace_back(console.public_ip, console.heard_ports[index]);
+      } else if (index >= 0 && console.seeded[index]) {
+        targets.emplace_back(console.public_ip, console.seeded[index]);
+      }
+    }
+    const uint32_t target = online::Target();
+    if (target) {
+      uint16_t port = HostPort(guest_port);
+      if (Console* console = FindConsole(target)) {
+        if (index >= 0 && console->heard_ports[index]) {
+          port = console->heard_ports[index];
+        } else if (index >= 0 && console->seeded[index]) {
+          port = console->seeded[index];
+        }
+      }
+      targets.emplace_back(target, port);
+    }
+  }
+  std::sort(targets.begin(), targets.end());
+  targets.erase(std::unique(targets.begin(), targets.end()), targets.end());
+  for (const auto& [ip, port] : targets) {
+    SendRaw(socket, ip, port, data, size, flags);
+  }
+}
+
+bool LastPeer(uint16_t guest_port, uint32_t* ip, int64_t* age_ms) {
+  std::lock_guard lock(state.mutex);
+  const auto peer = state.last_peer.find(guest_port);
+  if (peer == state.last_peer.end()) {
+    return false;
+  }
+  if (ip) {
+    *ip = peer->second.ip;
+  }
+  if (age_ms) {
+    *age_ms = std::chrono::duration_cast<std::chrono::milliseconds>(Clock::now() -
+                                                                   peer->second.heard)
+                  .count();
+  }
+  return true;
+}
+
+int64_t OpenSideSocket(uint16_t port, bool* bound) {
+  std::lock_guard lock(state.mutex);
+  if (state.side >= 0) {
+    ++state.side_users;
+    if (bound) {
+      *bound = state.side_bound;
+    }
+    return state.side;
+  }
+  const int64_t socket = ::socket(AF_INET, SOCK_DGRAM, 0);
+  if (socket < 0) {
+    return -1;
+  }
+#if REX_PLATFORM_WIN32
+  u_long enabled = 1;
+  ioctlsocket(socket, FIONBIO, &enabled);
+#else
+  const int current = fcntl(socket, F_GETFL, 0);
+  fcntl(socket, F_SETFL, current | O_NONBLOCK);
+#endif
+  int enabled = 1;
+  setsockopt(socket, SOL_SOCKET, SO_BROADCAST, reinterpret_cast<const char*>(&enabled),
+             sizeof(enabled));
+  const auto address = HostAddress(0, port);
+  state.side_bound = bind(socket, reinterpret_cast<const sockaddr*>(&address), sizeof(address)) == 0;
+  state.side = socket;
+  state.side_users = 1;
+  state.side_port = port;
+  if (bound) {
+    *bound = state.side_bound;
+  }
+  return socket;
+}
+
+void CloseSideSocket(int64_t socket) {
+  std::lock_guard lock(state.mutex);
+  if (socket != state.side || state.side < 0) {
+    return;
+  }
+  if (--state.side_users > 0) {
+    return;
+  }
+#if REX_PLATFORM_WIN32
+  closesocket(state.side);
+#else
+  close(state.side);
+#endif
+  state.side = -1;
+  state.side_port = 0;
+  state.side_bound = false;
+  state.side_packets.clear();
+}
+
+int SideSend(int64_t socket, uint32_t ip, uint16_t port, const void* data, uint32_t size) {
+  int result = -1;
+  if (SendOnline(socket, ip, 1002, port, static_cast<const uint8_t*>(data), size, 0, &result)) {
+    return result;
+  }
+  return SendRaw(socket, ip, port, static_cast<const uint8_t*>(data), size, 0);
+}
+
+int SideReceive(int64_t socket, void* data, uint32_t capacity, uint32_t* ip, uint16_t* port) {
+  std::lock_guard lock(state.mutex);
+  if (socket != state.side) {
+    return -1;
+  }
+  PumpSideSocketLocked();
+  if (state.side_packets.empty()) {
+    return -1;
+  }
+  SidePacket packet = std::move(state.side_packets.front());
+  state.side_packets.pop_front();
+  const size_t copied = std::min<size_t>(capacity, packet.data.size());
+  std::memcpy(data, packet.data.data(), copied);
+  if (ip) {
+    *ip = packet.ip;
+  }
+  if (port) {
+    *port = packet.port;
+  }
+  return int(copied);
+}
+
+void PumpSideSocket() {
+  std::lock_guard lock(state.mutex);
+  PumpSideSocketLocked();
+}
+
+int SendFromPort(uint16_t host_port, uint32_t ip, uint16_t port, const void* data, size_t size) {
+  int64_t socket = -1;
+  {
+    std::lock_guard lock(state.mutex);
+    if (state.side >= 0 && state.side_port == host_port) {
+      socket = state.side;
+    } else {
+      for (const auto& [handle, guest] : state.title_sockets) {
+        if (HostPort(guest) == host_port) {
+          socket = handle;
+          break;
+        }
+      }
+    }
+  }
+  return SendRaw(socket, ip, port, static_cast<const uint8_t*>(data), size, 0);
+}
+
+void SeedInternetPeer(uint32_t ip, uint16_t guest_port, uint16_t host_port, uint64_t console) {
+  std::lock_guard lock(state.mutex);
+  Console& peer = ConsoleFor(ip, console);
+  const int index = PortIndex(guest_port);
+  if (index >= 0) {
+    peer.seeded[index] = host_port;
+  }
+}
+
+bool HeardInternetPeer(uint32_t ip, uint16_t host_port, uint16_t* guest_port) {
+  std::lock_guard lock(state.mutex);
+  Console* peer = FindConsole(ip);
+  if (!peer) {
+    return false;
+  }
+  for (size_t i = 0; i < 3; ++i) {
+    if (peer->heard_ports[i] == host_port && peer->seeded[i]) {
+      if (guest_port) {
+        *guest_port = uint16_t(1000 + i);
+      }
+      return true;
+    }
+  }
+  return false;
+}
+
+void ForgetInternetPeers() {
+  std::lock_guard lock(state.mutex);
+  state.consoles.clear();
+}
+
+void NameConsoleLan(uint32_t ip, uint64_t console, uint32_t lan_ip) {
+  std::lock_guard lock(state.mutex);
+  ConsoleFor(ip, console).lan_ip = lan_ip;
+}
+
+void MakeXnAddr(uint32_t ip, uint8_t out[36]) {
+  std::memset(out, 0, 36);
+  Write32(out, ip);
+  out[10] = 0x02;
+  out[11] = 0x42;
+  Write32(out + 12, ip);
+}
+
+void MakeOwnXnAddr(uint8_t out[36]) {
+  uint32_t ip = 0;
+  TitleAddress(&ip);
+  MakeXnAddr(ip, out);
+  const uint64_t session = online::relay::TagSession();
+  if (online::PublicAddress() && session) {
+    uint32_t lan = 0;
+    LanAddress(&lan, nullptr);
+    out[16] = 'B';
+    out[17] = 'Z';
+    out[18] = 1;
+    out[19] = 0;
+    Write64(out + 20, session);
+    Write32(out + 28, lan);
+  }
+}
+
+void MakeTitleXnAddr(uint32_t ip, uint8_t out[36]) {
+  std::lock_guard lock(state.mutex);
+  Console* console = FindConsole(ip);
+  if (!console) {
+    MakeXnAddr(ip, out);
+    return;
+  }
+  MakeXnAddr(console->stand_in ? console->stand_in : console->public_ip, out);
+  if (console->session) {
+    out[16] = 'B';
+    out[17] = 'Z';
+    out[18] = 1;
+    Write64(out + 20, console->session);
+    Write32(out + 28, console->lan_ip);
+  }
+}
+
+uint32_t XnAddrToTitleIp(const uint8_t address[36]) {
+  const uint32_t ip = Read32(address);
+  if (address[16] != 'B' || address[17] != 'Z' || address[18] != 1) {
+    return ip;
+  }
+  const uint64_t session = Read64(address + 20);
+  const uint32_t lan = Read32(address + 28);
+  if (session == online::relay::TagSession()) {
+    return ip;
+  }
+  std::lock_guard lock(state.mutex);
+  Console& console = ConsoleFor(ip, session);
+  console.lan_ip = lan;
+  const uint32_t own = online::PublicAddress();
+  if (own && ip == own) {
+    return lan;
+  }
+  return console.stand_in ? console.stand_in : ip;
+}
+
+}  // namespace rex::system::system_link
