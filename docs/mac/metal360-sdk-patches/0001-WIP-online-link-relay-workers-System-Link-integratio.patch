+  Clock::time_point next_join_post{};
+  relay::Status status;
+  std::atomic<uint64_t> status_version{0};
+  std::mt19937_64 random{std::random_device{}()};
+
+  ~RelayRuntime() {
+    exiting = true;
+    shutdown = true;
+    wake.notify_all();
+    if (worker.joinable()) {
+      worker.join();
+    }
