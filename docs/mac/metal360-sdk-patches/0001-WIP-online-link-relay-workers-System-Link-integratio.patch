+  uint8_t punch[18] = {};
+  std::memcpy(punch, "BO2ZMPCH", 8);
+  CHECK(online::Classify(31000, 0, 0, punch, sizeof(punch)) == online::Datagram::kPunch);
+  uint8_t stun[20] = {};
+  stun[0] = 0x01;
+  stun[1] = 0x01;
+  stun[4] = 0x21;
+  stun[5] = 0x12;
+  stun[6] = 0xA4;
+  stun[7] = 0x42;
+  CHECK(online::Classify(31000, 0, 0, stun, sizeof(stun)) == online::Datagram::kStun);
+  stun[1] = 0x11;
+  CHECK(online::Classify(31000, 0, 0, stun, sizeof(stun)) == online::Datagram::kStun);
+  uint8_t title[] = {0xFF, 0xFF, 0xFF, 0xFF};
+  CHECK(online::Classify(31000, 0, 0, title, sizeof(title)) == online::Datagram::kTitle);
