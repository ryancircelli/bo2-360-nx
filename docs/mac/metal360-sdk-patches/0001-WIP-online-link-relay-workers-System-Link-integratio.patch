+  uint32_t lease = 3600;
+};
+
+struct LinkRuntime {
+  std::mutex mutex;
+  std::condition_variable wake;
+  std::thread worker;
+  std::atomic<bool> shutdown{false};
+  std::atomic<bool> exiting{false};
+  std::atomic<uint64_t> job{0};
+  uint64_t handled = 0;
+  std::atomic<uint64_t> report_version{0};
+  Role requested_role = Role::kNone;
+  uint32_t requested_target = 0;
+  Report report;
+  MappingState mappings;
+  std::atomic<uint32_t> public_address{0};
+  std::atomic<uint32_t> target_address{0};
+
+  ~LinkRuntime() {
+    exiting = true;
+    shutdown = true;
+    public_address = 0;
+    target_address = 0;
+    wake.notify_all();
+    if (worker.joinable()) {
+      worker.join();
+    }
+  }
+};
+
+LinkRuntime link;
+
+std::string Trim(std::string_view value) {
+  size_t first = 0;
+  while (first < value.size() && std::isspace(static_cast<unsigned char>(value[first]))) {
+    ++first;
+  }
+  size_t last = value.size();
+  while (last > first && std::isspace(static_cast<unsigned char>(value[last - 1]))) {
+    --last;
+  }
+  return std::string(value.substr(first, last - first));
+}
+
+std::string Lower(std::string_view value) {
+  std::string result(value);
+  std::transform(result.begin(), result.end(), result.begin(),
+                 [](unsigned char c) { return char(std::tolower(c)); });
+  return result;
+}
+
+std::string AddressText(uint32_t ip) {
+  const in_addr address{htonl(ip)};
+  char text[INET_ADDRSTRLEN] = {};
+  return inet_ntop(AF_INET, &address, text, sizeof(text)) ? std::string(text) : std::string();
+}
+
+uint32_t ParseAddress(std::string_view text) {
+  in_addr address{};
+  const std::string copy(text);
+  return inet_pton(AF_INET, copy.c_str(), &address) == 1 ? ntohl(address.s_addr) : 0;
+}
+
+bool IsPrivateAddress(uint32_t ip) {
+  return ip == 0 || (ip >> 24) == 10 || (ip >> 20) == 0xAC1 || (ip >> 16) == 0xC0A8 ||
+         (ip >> 22) == 0x286 || (ip >> 24) == 127 || (ip >> 16) == 0xA9FE;
+}
+
+bool Cancelled(uint64_t job) {
+  return link.exiting || link.job.load() != job;
+}
+
+bool Wait(uint64_t job, Clock::time_point deadline, SocketHandle socket = kInvalidSocket,
+          bool write = false) {
+  while (!Cancelled(job)) {
+    const auto now = Clock::now();
+    if (now >= deadline) {
+      return false;
+    }
+    const auto remaining = std::chrono::duration_cast<std::chrono::milliseconds>(deadline - now);
+    const int timeout = int(std::clamp<int64_t>(remaining.count(), 1, 100));
+#if REX_PLATFORM_WIN32
+    fd_set read_set;
+    fd_set write_set;
+    FD_ZERO(&read_set);
+    FD_ZERO(&write_set);
+    FD_SET(socket, write ? &write_set : &read_set);
+    timeval tv{0, timeout * 1000};
+    const int result = select(0, write ? nullptr : &read_set, write ? &write_set : nullptr, nullptr,
+                              &tv);
+    if (result > 0) {
+      return true;
+    }
+#else
+    if (socket == kInvalidSocket) {
+      std::this_thread::sleep_for(std::chrono::milliseconds(timeout));
+    } else {
+      pollfd pfd{socket, short(write ? POLLOUT : POLLIN), 0};
+      const int result = poll(&pfd, 1, timeout);
+      if (result > 0) {
+        return true;
+      }
+      if (result < 0 && errno != EINTR) {
+        return false;
+      }
+    }
+#endif
+  }
+  return false;
+}
+
+void Close(SocketHandle socket) {
+  if (socket == kInvalidSocket) {
+    return;
+  }
+#if REX_PLATFORM_WIN32
+  closesocket(socket);
+#else
+  close(socket);
+#endif
+}
+
+bool NonBlocking(SocketHandle socket) {
+#if REX_PLATFORM_WIN32
+  u_long enabled = 1;
+  return ioctlsocket(socket, FIONBIO, &enabled) == 0;
+#else
+  const int flags = fcntl(socket, F_GETFL, 0);
+  return flags >= 0 && fcntl(socket, F_SETFL, flags | O_NONBLOCK) == 0;
+#endif
+}
+
+std::optional<sockaddr_in> Resolve(const std::string& host, uint16_t port) {
+  addrinfo hints{};
+  hints.ai_family = AF_INET;
+  hints.ai_socktype = SOCK_STREAM;
+  addrinfo* addresses = nullptr;
+  if (getaddrinfo(host.c_str(), nullptr, &hints, &addresses) != 0) {
+    return std::nullopt;
+  }
+  sockaddr_in result = *reinterpret_cast<sockaddr_in*>(addresses->ai_addr);
+  result.sin_port = htons(port);
+  freeaddrinfo(addresses);
+  return result;
+}
+
+std::optional<Url> ParseUrl(const std::string& text) {
+  if (!text.starts_with("http://")) {
+    return std::nullopt;
+  }
+  const size_t authority = 7;
+  const size_t slash = text.find('/', authority);
+  const std::string host_port = text.substr(authority, slash - authority);
+  if (host_port.empty()) {
+    return std::nullopt;
+  }
+  Url url;
+  const size_t colon = host_port.rfind(':');
+  if (colon != std::string::npos && host_port.find(']') == std::string::npos) {
+    url.host = host_port.substr(0, colon);
+    const std::string port = host_port.substr(colon + 1);
+    char* end = nullptr;
+    const unsigned long parsed = std::strtoul(port.c_str(), &end, 10);
+    if (!end || *end || parsed == 0 || parsed > 65535) {
+      return std::nullopt;
+    }
+    url.port = uint16_t(parsed);
+  } else {
+    url.host = host_port;
+  }
+  url.path = slash == std::string::npos ? "/" : text.substr(slash);
+  return url;
+}
+
+SocketHandle Connect(const sockaddr_in& address, uint64_t job, Clock::time_point deadline,
+                     uint32_t* local_ip) {
+  SocketHandle socket = ::socket(AF_INET, SOCK_STREAM, 0);
+  if (socket == kInvalidSocket || !NonBlocking(socket)) {
+    Close(socket);
+    return kInvalidSocket;
+  }
+  const int result = connect(socket, reinterpret_cast<const sockaddr*>(&address), sizeof(address));
+  if (result != 0) {
+#if REX_PLATFORM_WIN32
+    if (WSAGetLastError() != WSAEWOULDBLOCK && WSAGetLastError() != WSAEINPROGRESS) {
+#else
+    if (errno != EINPROGRESS && errno != EWOULDBLOCK) {
+#endif
+      Close(socket);
+      return kInvalidSocket;
+    }
+    if (!Wait(job, deadline, socket, true)) {
+      Close(socket);
+      return kInvalidSocket;
+    }
+    int error = 0;
+    socklen_t size = sizeof(error);
+    if (getsockopt(socket, SOL_SOCKET, SO_ERROR, reinterpret_cast<char*>(&error), &size) != 0 ||
+        error != 0) {
+      Close(socket);
+      return kInvalidSocket;
+    }
+  }
+  if (local_ip) {
+    sockaddr_in local{};
+    socklen_t size = sizeof(local);
+    if (getsockname(socket, reinterpret_cast<sockaddr*>(&local), &size) == 0) {
+      *local_ip = ntohl(local.sin_addr.s_addr);
+    }
+  }
+  return socket;
+}
+
+int Chunked(const std::string& input, std::string* output) {
+  size_t offset = 0;
+  output->clear();
+  while (true) {
+    const size_t line = input.find("\r\n", offset);
+    if (line == std::string::npos) {
+      return 0;
+    }
+    char* end = nullptr;
+    const std::string size_text = input.substr(offset, line - offset);
+    const unsigned long size = std::strtoul(size_text.c_str(), &end, 16);
+    if (end == size_text.c_str()) {
+      return -1;
+    }
+    offset = line + 2;
+    if (size == 0) {
+      return 1;
+    }
+    if (size > 256 * 1024 || offset + size + 2 > input.size()) {
+      return input.size() > 256 * 1024 ? -1 : 0;
+    }
+    output->append(input, offset, size);
+    offset += size;
+    if (input.compare(offset, 2, "\r\n") != 0) {
+      return -1;
+    }
+    offset += 2;
+    if (output->size() > 256 * 1024) {
+      return -1;
+    }
+  }
+}
+
+struct HttpResponse {
+  int status = 0;
+  std::string body;
+  uint32_t peer_ip = 0;
+  uint32_t local_ip = 0;
+};
+
+HttpResponse Http(const std::string& url_text, const std::string& method,
+                  const std::vector<std::pair<std::string, std::string>>& headers,
+                  const std::string& body, uint64_t job, int timeout_ms) {
+  HttpResponse response;
+  const auto url = ParseUrl(url_text);
+  const auto address = url ? Resolve(url->host, url->port) : std::nullopt;
+  if (!address) {
+    return response;
+  }
+  response.peer_ip = ntohl(address->sin_addr.s_addr);
+  const auto deadline = Clock::now() + std::chrono::milliseconds(timeout_ms);
+  SocketHandle socket = Connect(*address, job, deadline, &response.local_ip);
+  if (socket == kInvalidSocket) {
+    return response;
+  }
+  std::string request = method + " " + url->path + " HTTP/1.1\r\nHost: " + url->host + ":" +
+                        std::to_string(url->port) + "\r\nConnection: close\r\n";
+  for (const auto& header : headers) {
+    request += header.first + ": " + header.second + "\r\n";
+  }
+  request += "Content-Length: " + std::to_string(body.size()) + "\r\n\r\n" + body;
+  size_t sent = 0;
+  while (sent < request.size() && Wait(job, deadline, socket, true)) {
+    const int count = send(socket, request.data() + sent, int(request.size() - sent), 0);
+    if (count > 0) {
+      sent += size_t(count);
+    } else if (count < 0) {
+      break;
+    }
+  }
+  std::string input;
+  bool headers_done = false;
+  size_t body_offset = 0;
+  size_t content_length = std::string::npos;
+  bool chunked = false;
+  while (sent == request.size() && Wait(job, deadline, socket)) {
+    char buffer[8192];
+    const int count = recv(socket, buffer, sizeof(buffer), 0);
+    if (count == 0) {
+      break;
+    }
+    if (count < 0) {
+      continue;
+    }
+    input.append(buffer, count);
+    if (input.size() > 300 * 1024) {
+      break;
+    }
+    if (!headers_done) {
+      body_offset = input.find("\r\n\r\n");
+      if (body_offset == std::string::npos) {
+        continue;
+      }
+      body_offset += 4;
+      const std::string head = input.substr(0, body_offset);
+      const size_t status = head.find(' ');
+      if (status != std::string::npos) {
+        response.status = std::atoi(head.c_str() + status + 1);
+      }
+      for (size_t line = head.find("\r\n") + 2; line + 2 < head.size();) {
+        const size_t end = head.find("\r\n", line);
+        if (end == std::string::npos) {
+          break;
+        }
+        const std::string entry = head.substr(line, end - line);
+        const size_t colon = entry.find(':');
+        if (colon != std::string::npos) {
+          const std::string name = Lower(entry.substr(0, colon));
+          const std::string value = Trim(entry.substr(colon + 1));
+          if (name == "content-length") {
+            content_length = std::strtoull(value.c_str(), nullptr, 10);
+          } else if (name == "transfer-encoding" && Lower(value).find("chunked") != std::string::npos) {
+            chunked = true;
+          }
+        }
+        line = end + 2;
+      }
+      headers_done = true;
+    }
+    if (headers_done) {
+      const std::string received = input.substr(body_offset);
+      if (chunked) {
+        std::string decoded;
+        const int result = Chunked(received, &decoded);
+        if (result == 1) {
+          response.body = std::move(decoded);
+          break;
+        }
+      } else if (content_length != std::string::npos &&
+                 received.size() >= content_length) {
+        response.body = received.substr(0, content_length);
+        break;
+      }
+    }
+  }
+  if (response.body.empty() && headers_done && !chunked) {
+    response.body = input.substr(body_offset, content_length == std::string::npos
+                                                   ? std::string::npos
+                                                   : content_length);
+  }
+  Close(socket);
+  return response;
+}
+
+std::string XmlText(std::string_view xml, std::string_view local_name) {
+  for (size_t offset = 0; offset < xml.size();) {
+    const size_t open = xml.find('<', offset);
+    if (open == std::string_view::npos) {
+      break;
+    }
+    const size_t end = xml.find('>', open + 1);
+    if (end == std::string_view::npos) {
+      break;
+    }
+    std::string_view name = xml.substr(open + 1, end - open - 1);
+    const size_t space = name.find_first_of(" \t\r\n/");
+    name = name.substr(0, space);
+    const size_t colon = name.rfind(':');
+    const std::string_view local = colon == std::string_view::npos ? name : name.substr(colon + 1);
+    if (local == local_name) {
+      const std::string close = "</" + std::string(name) + ">";
+      const size_t close_at = xml.find(close, end + 1);
+      if (close_at != std::string_view::npos) {
+        return std::string(xml.substr(end + 1, close_at - end - 1));
+      }
+    }
+    offset = end + 1;
+  }
+  return {};
+}
+
+std::vector<std::string> XmlElements(std::string_view xml, std::string_view local_name) {
+  std::vector<std::string> elements;
+  for (size_t offset = 0; offset < xml.size();) {
+    const size_t open = xml.find('<', offset);
+    if (open == std::string_view::npos) {
+      break;
+    }
+    const size_t end = xml.find('>', open + 1);
+    if (end == std::string_view::npos) {
+      break;
+    }
+    std::string_view name = xml.substr(open + 1, end - open - 1);
+    const size_t space = name.find_first_of(" \t\r\n/");
+    name = name.substr(0, space);
+    const size_t colon = name.rfind(':');
+    if ((colon == std::string_view::npos ? name : name.substr(colon + 1)) == local_name) {
+      const std::string close = "</" + std::string(name) + ">";
+      const size_t close_at = xml.find(close, end + 1);
+      if (close_at != std::string_view::npos) {
+        elements.emplace_back(xml.substr(end + 1, close_at - end - 1));
+        offset = close_at + close.size();
+        continue;
+      }
+    }
+    offset = end + 1;
+  }
+  return elements;
+}
+
+int XmlError(std::string_view body) {
+  const std::string value = XmlText(body, "errorCode");
+  return value.empty() ? 0 : std::atoi(value.c_str());
+}
+
+std::vector<std::string> Discover(uint64_t job, uint32_t lan_ip, uint32_t mask) {
+  static constexpr const char* targets[] = {
+      "urn:schemas-upnp-org:device:InternetGatewayDevice:1",
+      "urn:schemas-upnp-org:service:WANIPConnection:1",
+      "urn:schemas-upnp-org:service:WANIPConnection:2",
+      "urn:schemas-upnp-org:service:WANPPPConnection:1",
+      "urn:schemas-upnp-org:device:InternetGatewayDevice:2",
+  };
+  std::vector<std::string> locations;
+  SocketHandle socket = ::socket(AF_INET, SOCK_DGRAM, 0);
+  if (socket == kInvalidSocket || !NonBlocking(socket)) {
+    Close(socket);
+    return locations;
+  }
+#if REX_PLATFORM_WIN32
+  char ttl = 2;
+#else
+  unsigned char ttl = 2;
+#endif
+  setsockopt(socket, IPPROTO_IP, IP_MULTICAST_TTL, reinterpret_cast<const char*>(&ttl), sizeof(ttl));
+  for (int round = 0; round < 2 && locations.empty() && !Cancelled(job); ++round) {
+    for (const char* target : targets) {
+      const std::string request = std::string("M-SEARCH * HTTP/1.1\r\n") +
+                                  "HOST: 239.255.255.250:1900\r\nMAN: \"ssdp:discover\"\r\n" +
+                                  "MX: 1\r\nST: " + target + "\r\n\r\n";
+      sockaddr_in multicast{};
+      multicast.sin_family = AF_INET;
+      multicast.sin_port = htons(1900);
+      multicast.sin_addr.s_addr = htonl(0xEFFFFFFA);
+      sendto(socket, request.data(), int(request.size()), 0,
+             reinterpret_cast<const sockaddr*>(&multicast), sizeof(multicast));
+      if (round == 1 && mask) {
+        const uint32_t guess = (lan_ip & mask) | 1;
+        if (guess != lan_ip) {
+          multicast.sin_addr.s_addr = htonl(guess);
+          sendto(socket, request.data(), int(request.size()), 0,
+                 reinterpret_cast<const sockaddr*>(&multicast), sizeof(multicast));
+        }
+      }
+    }
+    const auto deadline = Clock::now() + std::chrono::milliseconds(1500);
+    while (Wait(job, deadline, socket)) {
+      char buffer[8192];
+      const int count = recv(socket, buffer, sizeof(buffer), 0);
+      if (count <= 0) {
+        continue;
+      }
+      const std::string_view reply(buffer, count);
+      for (size_t offset = 0; offset < reply.size();) {
+        const size_t end = reply.find("\r\n", offset);
+        const std::string line(reply.substr(offset, end - offset));
+        const size_t colon = line.find(':');
+        if (colon != std::string::npos && Lower(line.substr(0, colon)) == "location") {
+          const std::string location = Trim(line.substr(colon + 1));
+          if (std::find(locations.begin(), locations.end(), location) == locations.end()) {
+            locations.push_back(location);
+          }
+        }
+        if (end == std::string_view::npos) {
+          break;
+        }
+        offset = end + 2;
+      }
+    }
+  }
+  Close(socket);
+  return locations;
+}
+
+std::vector<Service> Services(const std::vector<std::string>& locations, uint64_t job) {
+  std::vector<Service> services;
+  for (const std::string& location : locations) {
+    if (Cancelled(job)) {
+      break;
+    }
+    const auto location_url = ParseUrl(location);
+    if (!location_url) {
+      continue;
+    }
+    const HttpResponse response = Http(location, "GET", {{"User-Agent", "metal360 UPnP/1.1"}}, "",
+                                       job, 4000);
+    if (!response.status) {
+      continue;
+    }
+    std::string base = XmlText(response.body, "URLBase");
+    if (base.empty()) {
+      base = "http://" + location_url->host + ":" + std::to_string(location_url->port);
+    }
+    while (!base.empty() && base.back() == '/') {
+      base.pop_back();
+    }
+    for (const std::string& element : XmlElements(response.body, "service")) {
+      const std::string type = XmlText(element, "serviceType");
+      std::string control = XmlText(element, "controlURL");
+      int rank = -1;
+      if (type == "urn:schemas-upnp-org:service:WANIPConnection:2") {
+        rank = 0;
+      } else if (type == "urn:schemas-upnp-org:service:WANIPConnection:1") {
+        rank = 1;
+      } else if (type == "urn:schemas-upnp-org:service:WANPPPConnection:1") {
+        rank = 2;
+      }
+      if (rank < 0 || control.empty()) {
+        continue;
+      }
+      if (!control.starts_with("http://")) {
+        control = base + "/" + control.substr(control.starts_with('/') ? 1 : 0);
+      }
+      services.push_back({type, control, rank});
+    }
+  }
+  std::stable_sort(services.begin(), services.end(),
+                   [](const Service& a, const Service& b) { return a.rank < b.rank; });
+  return services;
+}
+
+HttpResponse Soap(const Service& service, const std::string& action,
+                  const std::vector<std::pair<std::string, std::string>>& arguments, uint64_t job,
+                  int timeout_ms) {
+  std::string body = "<?xml version=\"1.0\"?>\r\n"
+                     "<s:Envelope xmlns:s=\"http://schemas.xmlsoap.org/soap/envelope/\" "
+                     "s:encodingStyle=\"http://schemas.xmlsoap.org/soap/encoding/\">\r\n"
+                     "<s:Body><u:" +
+                     action + " xmlns:u=\"" + service.type + "\">\r\n";
+  for (const auto& argument : arguments) {
+    body += "<" + argument.first + ">" + argument.second + "</" + argument.first + ">\r\n";
+  }
+  body += "</u:" + action + ">\r\n</s:Body>\r\n</s:Envelope>\r\n";
+  return Http(service.url, "POST",
+              {{"Content-Type", "text/xml; charset=\"utf-8\""},
+               {"SOAPAction", "\"" + service.type + "#" + action + "\""}},
+              body, job, timeout_ms);
+}
+
+bool AddMapping(const Service& service, uint16_t port, const std::string& internal, uint32_t* lease,
+                Report* report, uint64_t job, int timeout_ms) {
+  auto arguments = std::vector<std::pair<std::string, std::string>>{
+      {"NewRemoteHost", ""},
+      {"NewExternalPort", std::to_string(port)},
+      {"NewProtocol", "UDP"},
+      {"NewInternalPort", std::to_string(port)},
+      {"NewInternalClient", internal},
+      {"NewEnabled", "1"},
+      {"NewPortMappingDescription", "metal360 " + std::to_string(port)},
+      {"NewLeaseDuration", std::to_string(*lease)},
+  };
+  HttpResponse response = Soap(service, "AddPortMapping", arguments, job, timeout_ms);
+  int error = response.status == 200 ? 0 : response.status ? XmlError(response.body) : -1;
+  if (error == 725 && *lease != 0) {
+    *lease = 0;
+    arguments.back().second = "0";
+    response = Soap(service, "AddPortMapping", arguments, job, timeout_ms);
+    error = response.status == 200 ? 0 : response.status ? XmlError(response.body) : -1;
+  }
+  if (error == 718) {
+    const HttpResponse specific = Soap(service, "GetSpecificPortMappingEntry",
+                                       {{"NewRemoteHost", ""},
+                                        {"NewExternalPort", std::to_string(port)},
+                                        {"NewProtocol", "UDP"}},
+                                       job, timeout_ms);
+    report->conflict_ip = ParseAddress(XmlText(specific.body, "NewInternalClient"));
+    if (report->conflict_ip == ParseAddress(internal)) {
+      return true;
+    }
+  }
+  if (error) {
+    report->upnp_error = error;
+    return false;
+  }
+  return true;
+}
+
+void RemoveMappings(uint64_t job, int timeout_ms) {
+  for (uint16_t port : link.mappings.ports) {
+    Soap(link.mappings.service, "DeletePortMapping",
+         {{"NewRemoteHost", ""},
+          {"NewExternalPort", std::to_string(port)},
+          {"NewProtocol", "UDP"}},
+         job, timeout_ms);
+  }
+  link.mappings = {};
+}
+
+void PrepareUpnp(Report* report, uint64_t job) {
+  link.mappings.lease = uint32_t(std::clamp(REXCVAR_GET(net_online_lease_s), 120, 86400));
+  if (!REXCVAR_GET(net_online_upnp)) {
+    return;
+  }
+  const auto locations = Discover(job, report->lan_ip, [&] {
+    uint32_t mask = 0;
+    system_link::LanAddress(nullptr, &mask);
+    return mask;
+  }());
+  const auto services = Services(locations, job);
+  for (const Service& service : services) {
+    if (Cancelled(job)) {
+      return;
+    }
+    const HttpResponse external = Soap(service, "GetExternalIPAddress", {}, job, 4000);
+    if (!external.status) {
+      continue;
+    }
+    link.mappings.service = service;
+    link.mappings.internal_ip = external.local_ip ? AddressText(external.local_ip)
+                                                  : AddressText(report->lan_ip);
+    report->router_found = true;
+    report->router_ip = external.peer_ip;
+    report->router_external_ip = ParseAddress(XmlText(external.body, "NewExternalIPAddress"));
+    const uint16_t first = FirstPort();
+    for (int i = 0; i < PortCount(); ++i) {
+      const uint16_t port = uint16_t(first + i);
+      if (AddMapping(service, port, link.mappings.internal_ip, &link.mappings.lease, report, job,
+                     4000)) {
+        if (std::find(link.mappings.ports.begin(), link.mappings.ports.end(), port) ==
+            link.mappings.ports.end()) {
+          link.mappings.ports.push_back(port);
+        }
+      }
+    }
+    report->ports_mapped = int(link.mappings.ports.size());
+    if (report->ports_mapped || report->router_external_ip) {
+      return;
+    }
+  }
+}
+
+std::vector<std::pair<std::string, uint16_t>> Servers(std::string_view configured,
+                                                      uint16_t default_port) {
+  std::vector<std::pair<std::string, uint16_t>> servers;
+  for (size_t offset = 0; offset <= configured.size();) {
+    const size_t comma = configured.find(',', offset);
+    std::string entry = Trim(configured.substr(offset, comma - offset));
+    offset = comma == std::string_view::npos ? configured.size() + 1 : comma + 1;
+    if (entry.empty()) {
+      continue;
+    }
+    uint16_t port = default_port;
+    const size_t colon = entry.rfind(':');
+    if (colon != std::string::npos) {
+      const unsigned long parsed = std::strtoul(entry.c_str() + colon + 1, nullptr, 10);
+      if (parsed && parsed <= 65535) {
+        port = uint16_t(parsed);
+        entry.resize(colon);
+      }
+    }
+    servers.emplace_back(entry, port);
+  }
+  return servers;
+}
+
+void PrepareStun(Report* report, uint64_t job, uint32_t* public_ip) {
+  std::mt19937_64 random(std::random_device{}());
+  for (const auto& [host, port] : Servers(REXCVAR_GET(net_online_stun), 3478)) {
+    if (Cancelled(job)) {
+      return;
+    }
+    const auto address = Resolve(host, port);
+    if (!address) {
+      continue;
+    }
+    SocketHandle socket = ::socket(AF_INET, SOCK_DGRAM, 0);
+    if (socket == kInvalidSocket || !NonBlocking(socket)) {
+      Close(socket);
+      continue;
+    }
+    std::array<uint8_t, 12> transaction{};
+    for (uint8_t& byte : transaction) {
+      byte = uint8_t(random());
+    }
+    const auto request = net::StunRequest(transaction);
+    for (int attempt = 0; attempt < 2 && !Cancelled(job); ++attempt) {
+      sendto(socket, reinterpret_cast<const char*>(request.data()), int(request.size()), 0,
+             reinterpret_cast<const sockaddr*>(&*address), sizeof(*address));
+      sockaddr_in local{};
+      socklen_t local_size = sizeof(local);
+      if (getsockname(socket, reinterpret_cast<sockaddr*>(&local), &local_size) == 0) {
+        report->stun_local_port = ntohs(local.sin_port);
+      }
+      const auto deadline = Clock::now() + Seconds(1);
+      while (Wait(job, deadline, socket)) {
+        uint8_t buffer[2048];
+        const int count = recv(socket, reinterpret_cast<char*>(buffer), sizeof(buffer), 0);
+        if (count <= 0) {
+          continue;
+        }
+        const auto mapped = net::ParseStunResponse(buffer, size_t(count), transaction);
+        if (mapped) {
+          report->stun_ok = true;
+          report->stun_mapped_port = mapped->port;
+          *public_ip = mapped->ip;
+          Close(socket);
+          return;
+        }
+      }
+    }
+    Close(socket);
+  }
+}
+
+Report Prepare(Role role, uint32_t target, uint64_t job) {
+  Report report;
+  report.state = State::kPreparing;
+  report.role = role;
+  report.target_ip = role == Role::kJoin ? target : 0;
+  report.first_port = FirstPort();
+  if (!system_link::LanAddress(&report.lan_ip, nullptr)) {
+    report.state = State::kFailed;
+    report.failure = Failure::kNoNetwork;
+    return report;
+  }
+  {
+    std::lock_guard lock(link.mutex);
+    report.version = ++link.report_version;
+    link.report = report;
+  }
+  PrepareUpnp(&report, job);
+  uint32_t stun_ip = 0;
+  PrepareStun(&report, job, &stun_ip);
+  const uint32_t public_ip = stun_ip ? stun_ip : !IsPrivateAddress(report.router_external_ip)
+                                                       ? report.router_external_ip
+                                                       : 0;
+  report.double_nat = report.router_external_ip &&
+                      (IsPrivateAddress(report.router_external_ip) ||
+                       (report.stun_ok && report.router_external_ip != stun_ip));
+  if (!public_ip) {
+    report.state = State::kFailed;
+    report.failure = Failure::kNoPublicAddress;
+    RemoveMappings(job, 3000);
+    return report;
+  }
+  report.public_ip = public_ip;
+  if (role == Role::kJoin && target == public_ip) {
+    report.state = State::kFailed;
+    report.failure = Failure::kSameNetwork;
+    RemoveMappings(job, 3000);
+    return report;
+  }
+  report.state = Cancelled(job) ? State::kIdle : State::kReady;
+  return report;
+}
+
+void Publish(const Report& report) {
+  std::lock_guard lock(link.mutex);
+  link.report = report;
+  link.report.version = ++link.report_version;
+  link.public_address = report.state == State::kReady ? report.public_ip : 0;
+  link.target_address = report.state == State::kReady && report.role == Role::kJoin
+                            ? report.target_ip
+                            : 0;
+}
+
+void Worker() {
+  while (true) {
+    std::unique_lock lock(link.mutex);
+    link.wake.wait(lock, [] { return link.shutdown || link.job != link.handled; });
+    if (link.shutdown) {
+      const uint64_t job = link.job;
+      lock.unlock();
+      if (!link.exiting) {
+        RemoveMappings(job, 1500);
+      }
+      return;
+    }
+    const uint64_t job = link.job;
+    const Role role = link.requested_role;
+    const uint32_t target = link.requested_target;
+    link.handled = job;
+    lock.unlock();
+    RemoveMappings(job, 3000);
+    if (role == Role::kNone) {
+      relay::Stop();
+      Publish({});
+      continue;
+    }
+    Report report = Prepare(role, target, job);
+    lock.lock();
+    if (link.job != job || link.shutdown) {
+      lock.unlock();
+      RemoveMappings(job, 3000);
+      continue;
+    }
+    lock.unlock();
+    Publish(report);
+    if (report.state != State::kReady) {
+      continue;
+    }
+    relay::Start(role == Role::kHost, role == Role::kHost ? report.public_ip : report.target_ip,
+                 report.public_ip);
+    auto renewal = Clock::now() + Seconds(std::max<uint32_t>(60, link.mappings.lease / 2));
+    while (true) {
+      lock.lock();
+      link.wake.wait_until(lock, renewal, [&] {
+        return link.shutdown || link.job != link.handled || Clock::now() >= renewal;
+      });
+      if (link.shutdown || link.job != link.handled) {
+        break;
+      }
+      lock.unlock();
+      if (!link.mappings.ports.empty() && link.mappings.lease) {
+        Report current = Current();
+        for (uint16_t port : link.mappings.ports) {
+          AddMapping(link.mappings.service, port, link.mappings.internal_ip, &link.mappings.lease,
+                     &current, job, 4000);
+        }
+      }
+      renewal = Clock::now() + Seconds(std::max<uint32_t>(60, link.mappings.lease / 2));
+    }
+  }
+}
+
+void EnsureWorker() {
+  if (!link.worker.joinable() && !link.shutdown) {
+    link.worker = std::thread(Worker);
+  }
+}
+
+}  // namespace
+
+void Start(Role role, uint32_t target_ip) {
+  if (role == Role::kNone) {
+    Stop();
+    return;
+  }
+  std::lock_guard lock(link.mutex);
+  if (link.shutdown) {
+    return;
+  }
+  EnsureWorker();
+  link.public_address = 0;
+  link.target_address = 0;
+  relay::Stop();
+  ++link.job;
+  link.requested_role = role;
+  link.requested_target = target_ip;
+  Report report;
+  report.state = State::kPreparing;
+  report.role = role;
+  report.target_ip = role == Role::kJoin ? target_ip : 0;
+  report.first_port = FirstPort();
+  report.version = ++link.report_version;
+  link.report = report;
+  link.wake.notify_all();
+}
+
+void Stop() {
+  std::lock_guard lock(link.mutex);
+  if (link.shutdown ||
+      (!link.public_address && link.report.state == State::kIdle && link.report.role == Role::kNone)) {
+    return;
+  }
+  EnsureWorker();
+  link.public_address = 0;
+  link.target_address = 0;
+  relay::Stop();
+  ++link.job;
+  link.requested_role = Role::kNone;
+  link.requested_target = 0;
+  Report report;
+  report.first_port = FirstPort();
+  report.version = ++link.report_version;
+  link.report = report;
+  link.wake.notify_all();
+}
+
+void Shutdown() {
+  {
+    std::lock_guard lock(link.mutex);
+    if (link.shutdown) {
+      return;
+    }
+    link.public_address = 0;
+    link.target_address = 0;
+    relay::Stop();
+    link.shutdown = true;
+    ++link.job;
+    link.wake.notify_all();
+  }
+  if (link.worker.joinable()) {
+    link.worker.join();
+  }
+  relay::Shutdown();
+}
+
+Report Current() {
+  std::lock_guard lock(link.mutex);
+  Report report = link.report;
+  if (report.state == State::kReady) {
+    report.relay = relay::Current();
+  }
+  report.version = link.report_version + relay::Version();
+  return report;
+}
+
+uint64_t Version() {
+  return link.report_version + relay::Version();
+}
+
+uint32_t PublicAddress() {
+  return link.public_address.load(std::memory_order_acquire);
+}
+
+uint32_t Target() {
+  return link.target_address.load(std::memory_order_acquire);
+}
+
+uint16_t FirstPort() {
+  return system_link::HostPort(1000);
+}
+
+int PortCount() {
+  return 3;
+}
+
+}  // namespace rex::system::online
