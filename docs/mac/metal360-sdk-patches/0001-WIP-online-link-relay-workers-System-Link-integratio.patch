+bool SampleLanAddress(uint32_t* ip, uint32_t* mask) {
+#if REX_PLATFORM_WIN32
+  return false;
+#else
+  ifaddrs* interfaces = nullptr;
+  if (getifaddrs(&interfaces) != 0) {
+    return false;
+  }
+  bool found = false;
+  for (ifaddrs* it = interfaces; it && !found; it = it->ifa_next) {
+    if (!it->ifa_addr || it->ifa_addr->sa_family != AF_INET || !it->ifa_netmask ||
+        !it->ifa_broadaddr || !(it->ifa_flags & IFF_UP) || (it->ifa_flags & IFF_LOOPBACK) ||
+        !(it->ifa_flags & IFF_BROADCAST)) {
+      continue;
+    }
+    const auto* address = reinterpret_cast<const sockaddr_in*>(it->ifa_addr);
+    const auto* netmask = reinterpret_cast<const sockaddr_in*>(it->ifa_netmask);
+    *ip = ntohl(address->sin_addr.s_addr);
+    *mask = ntohl(netmask->sin_addr.s_addr);
+    found = true;
+  }
+  freeifaddrs(interfaces);
+  return found;
+#endif
