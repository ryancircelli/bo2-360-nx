+struct RelayRuntime {
+  std::mutex mutex;
+  std::condition_variable wake;
+  std::thread worker;
+  std::atomic<bool> shutdown{false};
+  std::atomic<bool> exiting{false};
+  uint64_t generation = 0;
+  uint64_t handled = 0;
+  bool pending = false;
+  bool requested_host = false;
+  uint32_t requested_code = 0;
+  uint32_t requested_public = 0;
+  std::atomic<bool> active{false};
+  bool host = false;
+  uint32_t code_ip = 0;
+  uint32_t public_ip = 0;
+  std::string code;
+  uint64_t session = 0;
+  Clock::time_point started{};
+  int64_t side = -1;
+  std::vector<sockaddr_in> stun_servers;
+  std::vector<Broker> brokers;
+  std::vector<Peer> peers;
+  std::array<EndpointState, 3> endpoints{};
+  std::mutex classify_mutex;
+  std::vector<InFlight> in_flight;
+  std::atomic<size_t> in_flight_count{0};
+  std::atomic<bool> symmetric{false};
