+// SPDX-License-Identifier: 0BSD
+#include <catch2/catch_test_macros.hpp>
+
+#include <rex/system/online_link.h>
+
+namespace online = rex::system::online;
+
+TEST_CASE("Online link start and stop are nonblocking and visible immediately", "[online_link]") {
+  online::Stop();
+  const online::Report idle = online::Current();
+  CHECK(idle.state == online::State::kIdle);
+  CHECK(idle.role == online::Role::kNone);
+  CHECK(online::PublicAddress() == 0);
+  CHECK(online::Target() == 0);
+  const uint64_t initial_version = online::Version();
+  online::Start(online::Role::kJoin, 0xC0000201u);
+  CHECK(online::PublicAddress() == 0);
+  CHECK(online::Target() == 0);
+  CHECK(online::Version() != initial_version);
+  const online::Report preparing = online::Current();
+  CHECK(preparing.role == online::Role::kJoin);
+  CHECK(preparing.target_ip == 0xC0000201u);
+  CHECK(preparing.port_count == 3);
+  CHECK(preparing.first_port == online::FirstPort());
+  online::Start(online::Role::kHost, 0);
+  CHECK(online::PublicAddress() == 0);
+  CHECK(online::Target() == 0);
+  online::Stop();
+  const online::Report stopped = online::Current();
+  CHECK(stopped.state == online::State::kIdle);
+  CHECK(stopped.role == online::Role::kNone);
+  CHECK(online::PublicAddress() == 0);
+  CHECK(online::Target() == 0);
+}
+
+TEST_CASE("Online link report defaults and port contract", "[online_link]") {
+  const online::Report report;
+  CHECK(report.state == online::State::kIdle);
+  CHECK(report.role == online::Role::kNone);
+  CHECK(report.failure == online::Failure::kNone);
+  CHECK(report.port_count == 3);
+  CHECK(report.first_port == 31000);
+  CHECK(online::PortCount() == 3);
+}
