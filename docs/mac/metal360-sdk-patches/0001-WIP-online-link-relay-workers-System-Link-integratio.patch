index 00000000..b25771f1
--- /dev/null
+++ b/tests/unit/kernel/text_input_test.cpp
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: 0BSD
+#include <catch2/catch_test_macros.hpp>
+
+#include <atomic>
+#include <chrono>
+#include <optional>
+#include <string>
+#include <thread>
+
+#include <rex/kernel/xam/text_input.h>
+
+namespace xam = rex::kernel::xam;
+
+TEST_CASE("Unavailable text UI cancels on a worker and quiets input", "[text_input]") {
+  std::atomic<int> callbacks{0};
+  std::atomic<bool> open_during_callback{false};
+  std::atomic<bool> got_cancellation{false};
+  const bool started = xam::ShowTextInput(
+      "Join code (XXXX-XXXX)", "", 12,
+      [&](std::optional<std::string> result) {
+        ++callbacks;
+        got_cancellation = !result.has_value();
+        open_during_callback = xam::TextInputOpen();
+      });
+  CHECK(started);
+  for (int i = 0; i < 100 && callbacks == 0; ++i) {
+    std::this_thread::sleep_for(std::chrono::milliseconds(5));
+  }
+  REQUIRE(callbacks == 1);
+  CHECK(got_cancellation);
+  CHECK(open_during_callback);
+  CHECK(xam::TextInputOpen());
+  std::this_thread::sleep_for(std::chrono::milliseconds(350));
+  CHECK_FALSE(xam::TextInputOpen());
+  CHECK(callbacks == 1);
+}
