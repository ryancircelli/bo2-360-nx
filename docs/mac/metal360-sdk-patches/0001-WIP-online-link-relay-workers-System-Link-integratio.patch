+};
+
+RelayRuntime relay_state;
+
+std::string Trim(std::string_view value) {
+  const size_t first = value.find_first_not_of(" \t\r\n");
+  if (first == std::string_view::npos) {
+    return {};
+  }
+  const size_t last = value.find_last_not_of(" \t\r\n");
+  return std::string(value.substr(first, last - first + 1));
+}
+
+std::vector<std::pair<std::string, uint16_t>> HostList(std::string_view text,
+                                                       uint16_t default_port) {
+  std::vector<std::pair<std::string, uint16_t>> result;
+  for (size_t offset = 0; offset <= text.size();) {
+    const size_t comma = text.find(',', offset);
+    std::string host = Trim(text.substr(offset, comma - offset));
+    offset = comma == std::string_view::npos ? text.size() + 1 : comma + 1;
+    if (host.empty()) {
+      continue;
+    }
+    uint16_t port = default_port;
+    const size_t colon = host.rfind(':');
+    if (colon != std::string::npos) {
+      const unsigned long parsed = std::strtoul(host.c_str() + colon + 1, nullptr, 10);
+      if (parsed && parsed <= 65535) {
+        port = uint16_t(parsed);
+        host.resize(colon);
+      }
+    }
+    result.emplace_back(host, port);
+  }
+  return result;
+}
+
+std::optional<sockaddr_in> Resolve(const std::string& host, uint16_t port, int socket_type) {
+  addrinfo hints{};
+  hints.ai_family = AF_INET;
+  hints.ai_socktype = socket_type;
+  addrinfo* addresses = nullptr;
+  if (getaddrinfo(host.c_str(), nullptr, &hints, &addresses) != 0) {
+    return std::nullopt;
+  }
+  sockaddr_in address = *reinterpret_cast<sockaddr_in*>(addresses->ai_addr);
+  address.sin_port = htons(port);
+  freeaddrinfo(addresses);
+  return address;
+}
+
+void Close(SocketHandle socket) {
+  if (socket == kInvalidSocket) {
+    return;
+  }
+#if REX_PLATFORM_WIN32
+  closesocket(socket);
+#else
+  close(socket);
+#endif
+}
+
+bool NonBlocking(SocketHandle socket) {
+#if REX_PLATFORM_WIN32
+  u_long enabled = 1;
+  return ioctlsocket(socket, FIONBIO, &enabled) == 0;
+#else
+  const int flags = fcntl(socket, F_GETFL, 0);
+  return flags >= 0 && fcntl(socket, F_SETFL, flags | O_NONBLOCK) == 0;
+#endif
+}
+
+uint64_t EndpointSignature(uint32_t public_ip, const Message& message) {
+  std::vector<uint8_t> bytes;
+  relay_wire::Append32(bytes, public_ip);
+  bytes.push_back(message.count);
+  for (size_t i = 0; i < message.count; ++i) {
+    relay_wire::Append16(bytes, message.endpoints[i].local_port);
+    relay_wire::Append32(bytes, message.endpoints[i].ip);
+    relay_wire::Append16(bytes, message.endpoints[i].port);
+    bytes.push_back(message.endpoints[i].flags);
+  }
+  return relay_wire::Hash64(
+      std::string_view(reinterpret_cast<const char*>(bytes.data()), bytes.size()));
+}
+
+int PortIndex(uint16_t host_port) {
+  for (int i = 0; i < 3; ++i) {
+    if (system_link::HostPort(uint16_t(1000 + i)) == host_port) {
+      return i;
+    }
+  }
+  return -1;
+}
+
+void DropBroker(Broker& broker) {
+  Close(broker.socket);
+  broker.socket = kInvalidSocket;
+  broker.connecting = false;
+  broker.connected = false;
+  broker.last_failed = true;
+  ++broker.failures;
+  broker.next_attempt =
+      Clock::now() + std::chrono::seconds(std::min(60, 2 << std::min(broker.failures, 5)));
+  broker.input.clear();
+  broker.output.clear();
+  broker.posted = false;
+}
+
+void Queue(Broker& broker, const std::vector<uint8_t>& packet) {
+  broker.output.insert(broker.output.end(), packet.begin(), packet.end());
+}
+
+void QueueConnect(Broker& broker) {
+  const std::string client = "bzn" + relay_wire::Hex64(relay_state.random());
+  Queue(broker, net::MqttConnect(client, relay_state.host ? relay_wire::HostTopic(relay_state.code)
+                                                          : std::string()));
+}
+
+void BeginBroker(Broker& broker) {
+  broker.socket = ::socket(AF_INET, SOCK_STREAM, 0);
+  if (broker.socket == kInvalidSocket || !NonBlocking(broker.socket)) {
+    DropBroker(broker);
+    return;
+  }
+  broker.last_failed = false;
+  broker.connecting = true;
+  broker.connected = false;
+  broker.connected_at = Clock::now();
+  broker.last_received = broker.connected_at;
+  broker.last_sent = broker.connected_at;
+  QueueConnect(broker);
+  const int result = connect(broker.socket, reinterpret_cast<const sockaddr*>(&broker.address),
+                             sizeof(broker.address));
+  if (result != 0) {
+#if REX_PLATFORM_WIN32
+    const int error = WSAGetLastError();
+    if (error != WSAEWOULDBLOCK && error != WSAEINPROGRESS) {
+#else
+    if (errno != EINPROGRESS && errno != EWOULDBLOCK) {
+#endif
+      DropBroker(broker);
+    }
+  }
+}
+
+void ReceiveMessage(Broker& broker, const Message& message) {
+  if (message.session == relay_state.session || (relay_state.host ? message.role != 2
+                                                                  : message.role != 1)) {
+    return;
+  }
+  const auto now = Clock::now();
+  const uint64_t signature = EndpointSignature(message.public_ip, message);
+  if (!relay_state.host) {
+    relay_state.peers.clear();
+  }
+  Peer* peer = nullptr;
+  for (Peer& candidate : relay_state.peers) {
+    if (candidate.session == message.session) {
+      peer = &candidate;
+      break;
+    }
+  }
+  const bool changed = !peer || peer->signature != signature;
+  if (!peer) {
+    if (relay_state.peers.size() >= 8) {
+      return;
+    }
+    relay_state.peers.push_back({});
+    peer = &relay_state.peers.back();
+    peer->session = message.session;
+  }
+  peer->public_ip = message.public_ip;
+  peer->count = message.count;
+  peer->endpoints = message.endpoints;
+  peer->signature = signature;
+  if (changed) {
+    ++broker.found;
+    peer->punch_until = now + std::chrono::seconds(10);
+    peer->next_punch = now;
+  }
+  for (size_t i = 0; i < message.count; ++i) {
+    const Endpoint& endpoint = message.endpoints[i];
+    if (!endpoint.local_port && !endpoint.port) {
+      system_link::NameConsoleLan(message.public_ip, message.session, endpoint.ip);
+    } else if (endpoint.ip && endpoint.port) {
+      system_link::SeedInternetPeer(message.public_ip,
+                                    system_link::GuestPort(endpoint.local_port), endpoint.port,
+                                    message.session);
+    }
+  }
+  peer->punch_until = now + std::chrono::seconds(10);
+  if (peer->next_punch > now) {
+    peer->next_punch = now;
+  }
+}
+
+void PublishPacket(Broker& broker, const net::MqttPacketView& packet) {
+  if (packet.body_size < 2) {
+    return;
+  }
+  const uint16_t topic_size = relay_wire::Read16(packet.body);
+  size_t offset = 2 + size_t(topic_size);
+  if (packet.body_size < offset || ((packet.flags >> 1) & 3)) {
+    if (packet.body_size < offset) {
+      return;
+    }
+    offset += 2;
+  }
+  if (packet.body_size < offset) {
+    return;
+  }
+  const std::string topic(reinterpret_cast<const char*>(packet.body + 2), topic_size);
+  const std::string expected = relay_state.host ? relay_wire::JoinTopic(relay_state.code)
+                                                : relay_wire::HostTopic(relay_state.code);
+  if (topic != expected) {
+    return;
+  }
+  const size_t payload_size = packet.body_size - offset;
+  if (!payload_size) {
+    return;
+  }
+  const auto message = relay_wire::Decode(packet.body + offset, payload_size, relay_state.code);
+  if (message) {
+    ReceiveMessage(broker, *message);
+  }
+}
+
+void ReadBroker(Broker& broker) {
+  uint8_t buffer[8192];
+  while (true) {
+    const int count = recv(broker.socket, reinterpret_cast<char*>(buffer), sizeof(buffer), 0);
+    if (count <= 0) {
+      if (count == 0) {
+        DropBroker(broker);
+      }
+      break;
+    }
+    broker.last_received = Clock::now();
+    broker.input.insert(broker.input.end(), buffer, buffer + count);
+    if (broker.input.size() > 256 * 1024) {
+      DropBroker(broker);
+      break;
+    }
+    while (!broker.input.empty() && broker.socket != kInvalidSocket) {
+      net::MqttPacketView packet;
+      const int consumed = net::MqttParse(broker.input.data(), broker.input.size(), &packet);
+      if (consumed < 0) {
+        DropBroker(broker);
+        break;
+      }
+      if (!consumed) {
+        break;
+      }
+      if (packet.type == 2 && packet.body_size >= 2) {
+        if (packet.body[1]) {
+          DropBroker(broker);
+          break;
+        }
+        broker.connected = true;
+        broker.connecting = false;
+        broker.failures = 0;
+        relay_state.tag_session = relay_state.session;
+        Queue(broker, net::MqttSubscribe(
+                          ++broker.packet_id, relay_state.host ? relay_wire::JoinTopic(relay_state.code)
+                                                               : relay_wire::HostTopic(relay_state.code)));
+      } else if (packet.type == 3 && broker.connected) {
+        PublishPacket(broker, packet);
+      }
+      broker.input.erase(broker.input.begin(), broker.input.begin() + consumed);
+    }
+    if (count < int(sizeof(buffer))) {
+      break;
+    }
+  }
+}
+
+void FlushBroker(Broker& broker) {
+  while (!broker.output.empty()) {
+    const int count = send(broker.socket, reinterpret_cast<const char*>(broker.output.data()),
+                           int(broker.output.size()), 0);
+    if (count > 0) {
+      broker.last_sent = Clock::now();
+      broker.output.erase(broker.output.begin(), broker.output.begin() + count);
+      continue;
+    }
+    if (count == 0) {
+      break;
+    }
+#if REX_PLATFORM_WIN32
+    if (WSAGetLastError() == WSAEWOULDBLOCK) {
+      break;
+    }
+#else
+    if (errno == EAGAIN || errno == EWOULDBLOCK) {
+      break;
+    }
+#endif
+    DropBroker(broker);
+    break;
+  }
+}
+
+Message OwnEndpoints() {
+  Message message;
+  message.role = relay_state.host ? 1 : 2;
+  message.session = relay_state.session;
+  message.public_ip = relay_state.public_ip;
+  for (int i = 0; i < 3; ++i) {
+    Endpoint& endpoint = message.endpoints[i];
+    endpoint.local_port = system_link::HostPort(uint16_t(1000 + i));
+    endpoint.ip = relay_state.public_ip;
+    endpoint.port = endpoint.local_port;
+    std::lock_guard lock(relay_state.classify_mutex);
+    if (relay_state.endpoints[i].observed[0]) {
+      endpoint.ip = relay_state.endpoints[i].observed[0]->ip;
+      endpoint.port = relay_state.endpoints[i].observed[0]->port;
+      endpoint.flags = 1;
+    } else if (relay_state.endpoints[i].observed[1]) {
+      endpoint.ip = relay_state.endpoints[i].observed[1]->ip;
+      endpoint.port = relay_state.endpoints[i].observed[1]->port;
+      endpoint.flags = 1;
+    }
+  }
+  message.count = 3;
+  uint32_t lan = 0;
+  if (system_link::LanAddress(&lan, nullptr)) {
+    message.endpoints[3] = {0, lan, 0, 0};
+    message.count = 4;
+  }
+  return message;
+}
+
+bool EndpointsReady() {
+  if (relay_state.stun_servers.empty() ||
+      Clock::now() - relay_state.started >= std::chrono::seconds(3)) {
+    return true;
+  }
+  std::lock_guard lock(relay_state.classify_mutex);
+  for (const EndpointState& endpoint : relay_state.endpoints) {
+    if (!endpoint.observed[0] && !endpoint.observed[1]) {
+      return false;
+    }
+  }
+  return true;
+}
+
+void SendStun() {
+  const auto now = Clock::now();
+  if (now < relay_state.next_stun) {
+    return;
+  }
+  for (int port = 0; port < 3; ++port) {
+    for (size_t server = 0; server < relay_state.stun_servers.size(); ++server) {
+      InFlight request;
+      request.port = port;
+      request.server = int(server);
+      request.expires = now + std::chrono::seconds(10);
+      for (uint8_t& byte : request.transaction) {
+        byte = uint8_t(relay_state.random());
+      }
+      const auto packet = net::StunRequest(request.transaction);
+      if (system_link::SendFromPort(system_link::HostPort(uint16_t(1000 + port)),
+                                    ntohl(relay_state.stun_servers[server].sin_addr.s_addr),
+                                    ntohs(relay_state.stun_servers[server].sin_port), packet.data(),
+                                    packet.size()) < 0) {
+        continue;
+      }
+      std::lock_guard lock(relay_state.classify_mutex);
+      relay_state.in_flight.push_back(request);
+      relay_state.in_flight_count = relay_state.in_flight.size();
+    }
+  }
+  ++relay_state.stun_rounds;
+  bool unknown = false;
+  {
+    std::lock_guard lock(relay_state.classify_mutex);
+    for (const EndpointState& endpoint : relay_state.endpoints) {
+      unknown |= !endpoint.observed[0] && !endpoint.observed[1];
+    }
+  }
+  relay_state.next_stun = now + std::chrono::seconds(unknown && relay_state.stun_rounds < 4 ? 1 : 30);
+}
+
+void PunchPeers() {
+  const auto now = Clock::now();
+  for (Peer& peer : relay_state.peers) {
+    if (now > peer.punch_until || now < peer.next_punch) {
+      continue;
+    }
+    peer.next_punch = now + std::chrono::milliseconds(250);
+    for (int i = 0; i < 3; ++i) {
+      const uint16_t local_port = system_link::HostPort(uint16_t(1000 + i));
+      for (size_t j = 0; j < peer.count; ++j) {
+        const Endpoint& endpoint = peer.endpoints[j];
+        if (endpoint.local_port != local_port || !endpoint.ip || !endpoint.port) {
+          continue;
+        }
+        uint8_t punch[18];
+        std::memcpy(punch, "BO2ZMPCH", 8);
+        for (int b = 0; b < 8; ++b) {
+          punch[8 + b] = uint8_t(relay_state.session >> (56 - 8 * b));
+        }
+        punch[16] = uint8_t((1000 + i) >> 8);
+        punch[17] = uint8_t(1000 + i);
+        system_link::SendFromPort(local_port, endpoint.ip, endpoint.port, punch, sizeof(punch));
+        system_link::SeedInternetPeer(peer.public_ip, uint16_t(1000 + i), endpoint.port,
+                                      peer.session);
+      }
+    }
+  }
+}
+
+void UpdatePeers() {
+  for (Peer& peer : relay_state.peers) {
+    if (peer.heard) {
+      continue;
+    }
+    for (size_t i = 0; i < peer.count; ++i) {
+      const Endpoint& endpoint = peer.endpoints[i];
+      if (endpoint.port && system_link::HeardInternetPeer(peer.public_ip, endpoint.port, nullptr)) {
+        peer.heard = true;
+        break;
+      }
+    }
+  }
+}
+
+void PostEndpoints() {
+  if (!EndpointsReady()) {
+    return;
+  }
+  const auto now = Clock::now();
+  const Message message = OwnEndpoints();
+  const uint64_t signature = EndpointSignature(relay_state.public_ip, message);
+  int heard = 0;
+  for (const Peer& peer : relay_state.peers) {
+    heard += peer.heard;
+  }
+  if (!relay_state.host && (heard || now - relay_state.started >= std::chrono::minutes(3))) {
+    return;
+  }
+  if (!relay_state.host && now < relay_state.next_join_post) {
+    return;
+  }
+  for (Broker& broker : relay_state.brokers) {
+    if (!broker.connected || (relay_state.host && broker.posted_signature == signature)) {
+      continue;
+    }
+    const auto packet = relay_wire::Encode(message, relay_state.code, relay_state.random());
+    Queue(broker, net::MqttPublish(relay_state.host ? relay_wire::HostTopic(relay_state.code)
+                                                    : relay_wire::JoinTopic(relay_state.code),
+                                   packet, relay_state.host));
+    broker.posted = true;
+    broker.posted_signature = signature;
+  }
+  if (!relay_state.host) {
+    relay_state.next_join_post = now + std::chrono::seconds(2);
+  }
+}
+
+void UpdateStatus() {
+  std::lock_guard status_lock(relay_state.mutex);
+  relay::Status next;
+  next.active = relay_state.active;
+  next.symmetric = relay_state.symmetric;
+  next.brokers = int(relay_state.brokers.size());
+  for (size_t i = 0; i < relay_state.brokers.size() && i < next.broker_list.size(); ++i) {
+    const Broker& broker = relay_state.brokers[i];
+    next.broker_list[i].name = broker.name;
+    next.broker_list[i].state = broker.connected
+                                    ? relay::BrokerStatus::kWorking
+                                    : broker.last_failed ? relay::BrokerStatus::kDown
+                                                         : relay::BrokerStatus::kChecking;
+    next.broker_list[i].posted = broker.posted;
+    next.broker_list[i].found = broker.found;
+    next.brokers_up += broker.connected;
+    next.brokers_failed += !broker.connected && broker.last_failed;
+  }
+  {
+    std::lock_guard lock(relay_state.classify_mutex);
+    for (const EndpointState& endpoint : relay_state.endpoints) {
+      next.ports += endpoint.observed[0] || endpoint.observed[1];
+    }
+  }
+  for (const Peer& peer : relay_state.peers) {
+    next.peers += peer.session != 0;
+    next.peers_heard += peer.heard;
+  }
+  if (!(next == relay_state.status)) {
+    relay_state.status = std::move(next);
+    ++relay_state.status_version;
+  }
+}
+
+void EndSession() {
+  for (Broker& broker : relay_state.brokers) {
+    if (broker.socket != kInvalidSocket) {
+      if (!relay_state.exiting && relay_state.host && broker.connected) {
+        Queue(broker, net::MqttPublish(relay_wire::HostTopic(relay_state.code), nullptr, 0, true));
+        Queue(broker, net::MqttDisconnect());
+        FlushBroker(broker);
+      }
+      Close(broker.socket);
+      broker.socket = kInvalidSocket;
+    }
+  }
+  if (relay_state.side >= 0) {
+    system_link::CloseSideSocket(relay_state.side);
+    relay_state.side = -1;
+  }
+  {
+    std::lock_guard lock(relay_state.classify_mutex);
+    relay_state.in_flight.clear();
+    relay_state.in_flight_count = 0;
+    relay_state.endpoints = {};
+  }
+  relay_state.peers.clear();
+  relay_state.brokers.clear();
+  relay_state.stun_servers.clear();
+  relay_state.active = false;
+  relay_state.tag_session = 0;
+  UpdateStatus();
+}
+
+void BeginSession(bool host, uint32_t code_ip, uint32_t public_ip) {
+  EndSession();
+  relay_state.active = true;
+  relay_state.host = host;
+  relay_state.code_ip = code_ip;
+  relay_state.public_ip = public_ip;
+  relay_state.code = join_code::Plain(code_ip);
+  do {
+    relay_state.session = relay_state.random();
+  } while (!relay_state.session);
+  relay_state.started = Clock::now();
+  relay_state.next_stun = relay_state.started;
+  relay_state.next_join_post = relay_state.started;
+  relay_state.stun_rounds = 0;
+  relay_state.symmetric = false;
+  relay_state.tag_session = 0;
+  system_link::ForgetInternetPeers();
+  bool bound = false;
+  relay_state.side = system_link::OpenSideSocket(system_link::HostPort(1002), &bound);
+  const auto stun = HostList(REXCVAR_GET(net_online_stun), 3478);
+  for (const auto& [name, port] : stun) {
+    const auto address = Resolve(name, port, SOCK_DGRAM);
+    if (!address) {
+      continue;
+    }
+    bool duplicate = false;
+    for (const sockaddr_in& existing : relay_state.stun_servers) {
+      duplicate |= existing.sin_addr.s_addr == address->sin_addr.s_addr;
+    }
+    if (!duplicate) {
+      relay_state.stun_servers.push_back(*address);
+    }
+    if (relay_state.stun_servers.size() == 2) {
+      break;
+    }
+  }
+  for (const auto& [name, port] : HostList(REXCVAR_GET(net_online_brokers), 1883)) {
+    if (relay_state.brokers.size() == 8) {
+      break;
+    }
+    Broker broker;
+    broker.name = name + ":" + std::to_string(port);
+    broker.host = name;
+    broker.port = port;
+    const auto address = Resolve(name, port, SOCK_STREAM);
+    if (address) {
+      broker.address = *address;
+      relay_state.brokers.push_back(std::move(broker));
+    }
+  }
+  if (!host) {
+    Peer guess;
+    guess.public_ip = code_ip;
+    guess.count = 3;
+    for (int i = 0; i < 3; ++i) {
+      const uint16_t port = system_link::HostPort(uint16_t(1000 + i));
+      guess.endpoints[i] = {port, code_ip, port, 0};
+      system_link::SeedInternetPeer(code_ip, uint16_t(1000 + i), port, 0);
+    }
+    guess.punch_until = relay_state.started + std::chrono::seconds(10);
+    relay_state.peers.push_back(guess);
+  }
+  UpdateStatus();
+}
+
+void Tick() {
+  SendStun();
+  system_link::PumpSideSocket();
+  const auto now = Clock::now();
+  for (Broker& broker : relay_state.brokers) {
+    if (broker.socket == kInvalidSocket) {
+      if (now >= broker.next_attempt) {
+        BeginBroker(broker);
+      }
+      continue;
+    }
+    if (now - broker.connected_at > std::chrono::seconds(6) && !broker.connected) {
+      DropBroker(broker);
+      continue;
+    }
+    ReadBroker(broker);
+    if (broker.socket == kInvalidSocket) {
+      continue;
+    }
+    if (now - broker.last_sent >= std::chrono::seconds(20)) {
+      Queue(broker, net::MqttPing());
+    }
+    if (now - broker.last_received >= std::chrono::seconds(45)) {
+      DropBroker(broker);
+      continue;
+    }
+    FlushBroker(broker);
+  }
+  UpdatePeers();
+  PunchPeers();
+  PostEndpoints();
+  for (Broker& broker : relay_state.brokers) {
+    if (broker.socket != kInvalidSocket) {
+      FlushBroker(broker);
+    }
+  }
+  {
+    std::lock_guard lock(relay_state.classify_mutex);
+    std::erase_if(relay_state.in_flight, [&](const InFlight& request) { return request.expires < now; });
+    relay_state.in_flight_count = relay_state.in_flight.size();
+  }
+  UpdateStatus();
+}
+
+void Worker() {
+  while (true) {
+    std::unique_lock lock(relay_state.mutex);
+    relay_state.wake.wait(lock, [] {
+      return relay_state.shutdown || relay_state.pending || relay_state.active;
+    });
+    if (relay_state.shutdown) {
+      lock.unlock();
+      EndSession();
+      return;
+    }
+    if (relay_state.pending) {
+      relay_state.pending = false;
+      relay_state.handled = relay_state.generation;
+      const bool host = relay_state.requested_host;
+      const uint32_t code = relay_state.requested_code;
+      const uint32_t public_ip = relay_state.requested_public;
+      lock.unlock();
+      BeginSession(host, code, public_ip);
+      continue;
+    }
+    if (!relay_state.active) {
+      continue;
+    }
+    const uint64_t generation = relay_state.generation;
+    lock.unlock();
+    Tick();
+    lock.lock();
+    if (relay_state.generation != generation) {
+      if (!relay_state.pending) {
+        lock.unlock();
+        EndSession();
+      }
+      continue;
+    }
+    relay_state.wake.wait_for(lock, std::chrono::milliseconds(50), [&] {
+      return relay_state.shutdown || relay_state.pending || relay_state.generation != generation;
+    });
+  }
+}
+
+void EnsureWorker() {
+  if (!relay_state.worker.joinable() && !relay_state.shutdown) {
+    relay_state.worker = std::thread(Worker);
+  }
+}
+
+}  // namespace
+
+Datagram Classify(uint16_t local_port, uint32_t ip, uint16_t port, const uint8_t* data, int size) {
+  if (data && size >= 18 && std::memcmp(data, "BO2ZMPCH", 8) == 0) {
+    return Datagram::kPunch;
+  }
+  if (!data || size < 20 || data[0] != 0x01 || (data[1] != 0x01 && data[1] != 0x11) ||
+      data[4] != 0x21 || data[5] != 0x12 || data[6] != 0xA4 || data[7] != 0x42) {
+    return Datagram::kTitle;
+  }
+  if (!relay_state.in_flight_count.load(std::memory_order_acquire)) {
+    return Datagram::kStun;
+  }
+  std::lock_guard lock(relay_state.classify_mutex);
+  const int port_index = PortIndex(local_port);
+  for (auto it = relay_state.in_flight.begin(); it != relay_state.in_flight.end(); ++it) {
+    if (port_index >= 0 && it->port != port_index) {
+      continue;
+    }
+    if (!net::StunTransactionMatches(data, size, it->transaction)) {
+      continue;
+    }
+    if (data[1] == 0x01) {
+      const auto mapped = net::ParseStunResponse(data, size, it->transaction);
+      if (mapped) {
+        auto& observed = relay_state.endpoints[it->port].observed[it->server];
+        observed = *mapped;
+        const auto& other = relay_state.endpoints[it->port].observed[1 - it->server];
+        if (other && (other->ip != mapped->ip || other->port != mapped->port)) {
+          relay_state.symmetric = true;
+        }
+      }
+    }
+    relay_state.in_flight.erase(it);
+    relay_state.in_flight_count = relay_state.in_flight.size();
+    break;
+  }
+  return Datagram::kStun;
+}
+
+namespace relay {
+
+void Start(bool host, uint32_t code_ip, uint32_t public_ip) {
+  if (!REXCVAR_GET(net_online_punch) || HostList(REXCVAR_GET(net_online_brokers), 1883).empty()) {
+    REXSYS_INFO("[online] relay disabled");
+    return;
+  }
+  std::lock_guard lock(relay_state.mutex);
+  if (relay_state.shutdown) {
+    return;
+  }
+  EnsureWorker();
+  relay_state.requested_host = host;
+  relay_state.requested_code = code_ip;
+  relay_state.requested_public = public_ip;
+  relay_state.pending = true;
+  ++relay_state.generation;
+  relay_state.tag_session = 0;
+  relay_state.wake.notify_all();
+}
+
+void Stop() {
+  std::lock_guard lock(relay_state.mutex);
+  if (!relay_state.active && !relay_state.pending) {
+    return;
+  }
+  relay_state.pending = false;
+  ++relay_state.generation;
+  relay_state.tag_session = 0;
+  relay_state.wake.notify_all();
+}
+
+void Shutdown() {
+  {
+    std::lock_guard lock(relay_state.mutex);
+    if (relay_state.shutdown) {
+      return;
+    }
+    relay_state.shutdown = true;
+    relay_state.pending = false;
+    ++relay_state.generation;
+    relay_state.tag_session = 0;
+    relay_state.wake.notify_all();
+  }
+  if (relay_state.worker.joinable()) {
+    relay_state.worker.join();
+  }
+}
+
+Status Current() {
+  std::lock_guard lock(relay_state.mutex);
+  return relay_state.status;
+}
+
+uint64_t Version() {
+  return relay_state.status_version.load(std::memory_order_acquire);
+}
+
+uint64_t TagSession() {
+  return relay_state.tag_session.load(std::memory_order_acquire);
+}
+
+}  // namespace relay
+}  // namespace rex::system::online
