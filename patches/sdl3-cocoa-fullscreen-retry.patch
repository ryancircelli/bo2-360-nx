+// rexglue: AppKit raises an exception if the style mask changes while it is still resizing the window, which
+// happens when the display under a fullscreen window changes (virtual monitor removed, refresh rate change).
+// Uncaught, that ends the game. Retry the change on the next runloop turns instead.
+static bool Cocoa_TrySetStyleMask(NSWindow *nswindow, NSWindowStyleMask style, NSRect rect, int attempt)
+{
+    @try {
+        [nswindow setStyleMask:style];
+        return true;
+    } @catch (NSException *e) {
+        SDL_LogWarn(SDL_LOG_CATEGORY_VIDEO, "setStyleMask refused (%s), retry %d", [[e reason] UTF8String], attempt + 1);
+        if (attempt < 20) {
+            __weak NSWindow *weak = nswindow;
+            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 100 * NSEC_PER_MSEC), dispatch_get_main_queue(), ^{
+                NSWindow *w = weak;
+                if (w && Cocoa_TrySetStyleMask(w, style, rect, attempt + 1)) {
+                    [w setContentSize:rect.size];
+                    [w setFrameOrigin:rect.origin];
+                }
+            });
         }
+        return false;
     }
 }
 
