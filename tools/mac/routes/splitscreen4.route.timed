# 4-player split screen, Town Survival. Pads are scripted by the SDK (REX_HID_VIRTUAL_PAD_SCRIPT, set by boot_test.sh;
# the SDK reads the BO2ZM_TEST_BUTTONS* keys below), so the harness does not export them to the game.
# The Local lobby opens about 15 s after start and stays open 25 s; players 2 to 4 press A at 44, 46 and 48 s of the script clock (it starts with the process; under load the lobby opens at about 40 s, unloaded at about 15 s, so lower these when the machine is quiet) to join (Start does not join), and again 12 s later in case the lobby was not taking input yet (a second A from a joined player does nothing). Player 1 starts the match by itself
# (BO2ZM_TEST_START). Walk timings for player 1 are copied from town_benchmark and still want a real run to tune.
duration_s = 340
players = 4
BO2ZM_TEST_START = zm_transit town zstandard zsurvival
BO2ZM_TEST_START_WAIT_S = 55
BO2ZM_TEST_ALL_GOD = true
BO2ZM_BENCHMARK = true
BO2ZM_BENCHMARK_S = 180
BO2ZM_TEST_BUTTONS = 60-90:look_right,90-120:up,120-150:look_left,150-180:up
BO2ZM_TEST_BUTTONS_P2 = 44:a,56:a
BO2ZM_TEST_BUTTONS_P3 = 46:a,58:a
BO2ZM_TEST_BUTTONS_P4 = 48:a,60:a
compare_quadrants = true
