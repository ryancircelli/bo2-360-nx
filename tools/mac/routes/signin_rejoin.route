# Event-based version (needs a build with the SDK wait_log step; boot_test.sh falls back to signin_rejoin.route.timed otherwise).
# Pad clocks count from the end of each wait_log. Markers: Local lobby open, the game's client is in a match.
players = 2
duration_s = 190
BO2ZM_TEST_START = zm_transit town zstandard zsurvival
BO2ZM_TEST_ALL_GOD = true
BO2ZM_BENCHMARK = false
BO2ZM_TEST_START_WAIT_S = 70
BO2ZM_TEST_BUTTONS_P2 = wait_log Local lobby open 60, 3:a, 10:b, 18:a
