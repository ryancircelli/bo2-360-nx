# PLACEHOLDER (menu sequence): play Town Survival, then quit to the menu and load Farm. Checks the allocator slot at
# guest 0x8249A9C0 on teardown: the run fails on any "unregistered function" line (boot_test.sh CHECK_PATTERNS).
# Pause-menu navigation is not recorded: the button steps below are a first guess (pause with start at 60 s, move
# down to Quit, confirm, then pick Farm from the home menu). Verify once in the game and correct the timings.
PLACEHOLDER = true
duration_s = 240
players = 1
BO2ZM_TEST_START = zm_transit town zstandard zsurvival
BO2ZM_TEST_ALL_GOD = true
BO2ZM_BENCHMARK = false
BO2ZM_TEST_BUTTONS = 60:start,62:down,63:down,64:down,65:a,67:a,90:a,100:down,101:a,102:a
