def perf_tsv_health(run_dir, skip_s=60.0, bin_s=60.0):
    """Return (min_bin_fps, median_bin_fps) over the measured window of run/perf.tsv, or None."""
    p = os.path.join(run_dir, 'perf.tsv')
    try:
        t = []
        with open(p) as f:
            for line in f:
                if line[:1] in ('#', 'f'):
                    continue
                a = line.split('\t')
                try:
                    if int(a[7]) > 0:
                        t.append(float(a[1]))
                except (IndexError, ValueError):
                    pass
    except OSError:
        return None
    if len(t) < 200:
        return None
    t0 = t[0] + skip_s * 1e3
    t = [x for x in t if x >= t0]
    bins, i, j = [], 0, 0
    while t and t[0] + (i + 1) * bin_s * 1e3 <= t[-1]:
        lo, hi = t[0] + i * bin_s * 1e3, t[0] + (i + 1) * bin_s * 1e3
        n = 0
        while j < len(t) and t[j] < hi:
            n += t[j] >= lo
            j += 1
        bins.append(n / bin_s)
        i += 1
    if len(bins) < 2:
        return None
    return min(bins), sorted(bins)[len(bins) // 2]


