    return ['uv', 'run', '-q', '--no-project', '--with', 'numpy', '--with', 'pillow', 'python', '-I', sd, 'diff',
            scene, caps, golden, '--json', os.path.join(out, 'diff.json')]


TL_MARKS = [('log_start', None), ('renderer_ready', 'Metal startup: preparation completed'),
            ('menus', 'menus.lua installed'), ('lobby', 'test start: local lobby opened'),
            ('map_picked', ' picked'), ('match_start', ' started'),
            ('in_match', ("the game's client is in a match", 'player in a match', 'controller 0 is in a match')),
            ('spot', '[spot] standing at'), ('first_capture', '[capture] /'), ('last_capture', None)]


def timeline(text, launch=None):
    """Seconds from launch (boot_test's launch_time.txt; else the log's first line) to the boot milestones."""
    import datetime

    def ts(line):
        m = re.match(r'^\[(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d(?:\.\d+)?)\]', line)
        if not m:
            return None
        return datetime.datetime.strptime(m.group(1), '%Y-%m-%d %H:%M:%S.%f' if '.' in m.group(1)
                                          else '%Y-%m-%d %H:%M:%S').timestamp()
    lines = [(ts(l), l) for l in text.splitlines()]
    lines = [(t, l) for t, l in lines if t is not None and 'Script pad' not in l]
    out = {}
    if not lines:
        return out
    t0 = launch or lines[0][0]
    out['log_start'] = round(lines[0][0] - t0, 1)
    for key, needle in TL_MARKS:
        if needle is None:
            continue
        needles = needle if isinstance(needle, tuple) else (needle,)
        for t, l in lines:
            if any(n in l for n in needles) and (key not in ('map_picked', 'match_start') or 'test start:' in l):
                out[key] = round(t - t0, 1)
                break
    caps = [t for t, l in lines if '[capture] /' in l]
    if caps:
        out['last_capture'] = round(caps[-1] - t0, 1)
    out['log_end'] = round(lines[-1][0] - t0, 1)
    return out


# ------------------------------------------------------------------ buildq
def older_multi_waiter(me, registered, tokens):
    """True when another live buildq client still waiting for tokens (-t N, N > 1) registered before me, and I am
    either a smaller request or younger. The oldest multi-token waiter then drains the pool unopposed."""
    for f in os.listdir(D['builds']):
        if not f.endswith('.json') or f == f'{me}.json':
            continue
        b = rjson(os.path.join(D['builds'], f)) or {}
        if (b.get('waiting') and b.get('tokens', 1) > 1 and b.get('pid') and alive(b['pid'])
                and (tokens <= 1 or b.get('registered', 0) < registered)):
            return True
    return False


def buildq(argv):
    tokens, ship, prio, i = 1, False, False, 0
    while i < len(argv):
        if argv[i] in ('-p', '--priority'):
            prio, i = True, i + 1
        elif argv[i] == '-t':
            tokens, i = int(argv[i + 1]), i + 2
        elif argv[i] == '--ship':
            ship, i = True, i + 1
        elif argv[i] == '--':
            i += 1
            break
        elif argv[i] in ('-h', '--help'):
            print(__doc__)
            return 0
        else:
            break
    cmd = argv[i:]
    if not cmd:
        sys.exit('usage: buildq [-t N] [--ship] [-p] [--] CMD ARGS...')
    ensure_daemon()
    base = os.path.basename(cmd[0])
    cmd = ccache_configure(cmd) if base == 'cmake' else cmd
    jobserver = base == 'ninja' or (base == 'cmake' and '--build' in cmd)
    if jobserver:
        cmd = strip_jobs(cmd)
        tokens = 1   # the build's own first job; ninja reads the rest from the pool job by job
    c = cfg()
    tokens = max(1, min(tokens, c['game_cap']))
    # Priority lane: one tiny command (a patch dylib, ~1 s) takes no token, so it is not queued behind big builds that
    # hold every token (one waited 1,511 s). It still waits out solo/quiet-machine runs below and is frozen like any build.
    # Automatic for build_patch_lib.sh; never for a jobserver build (ninja, cmake --build).
    if (prio or base == 'build_patch_lib.sh') and not jobserver:
        tokens = 0
    rec = os.path.join(D['builds'], f'{os.getpid()}.json')
    registered = now_s()
    wjson(rec, {'pid': os.getpid(), 'cmd': cmd, 'cwd': os.getcwd(), 'tokens': tokens, 'jobserver': jobserver,
                'registered': registered, 'started': registered, 'waiting': True})
    fifo = os.open(FIFO, os.O_RDWR | os.O_NONBLOCK)
    lk = os.open(POOL_LOCK, os.O_RDWR | os.O_CREAT, 0o666)
    exec_lk = os.open(BUILD_EXEC_LOCK, os.O_RDWR | os.O_CREAT, 0o666)
    exec_locked = False
    got = 0
    waited = time.time()
    try:
        while True:
            while got < tokens:   # (priority lane: tokens 0, loop skipped)
                if older_multi_waiter(os.getpid(), registered, tokens):
                    time.sleep(0.5)   # FIFO: the oldest -t N waiter reserves the pool (1-token builds starved one for 6 h)
                    continue
                fcntl.flock(lk, fcntl.LOCK_SH)   # token reads serialize with pool repair
                try:
                    b = os.read(fifo, tokens - got)
                    got += len(b)
                except BlockingIOError:
                    pass
                if got < tokens:
                    if got:
                        os.write(fifo, b'+' * got)
                        got = 0
                    fcntl.flock(lk, fcntl.LOCK_UN)
                    time.sleep(0.5)
            # The execution lock closes the token-grant/quiet-start race. Keep it shared until
            # the command and child PID are recorded; runq takes exclusive ownership for solo.
            fcntl.flock(exec_lk, fcntl.LOCK_SH)
            exec_locked = True
            if not buildq_command_allowed(runq_solo_active()):
                os.write(fifo, b'+' * got)
                got = 0
                fcntl.flock(exec_lk, fcntl.LOCK_UN)
                exec_locked = False
                fcntl.flock(lk, fcntl.LOCK_UN)
                time.sleep(0.5)
                continue
            break
        w = time.time() - waited
        if w > 2:
            print(f'buildq: waited {w:.0f} s for build tokens (a game is running or the pool is busy)',
                  file=sys.stderr)
        env = dict(os.environ)
        env.pop('CMAKE_BUILD_PARALLEL_LEVEL', None)
        slog = os.path.join(D['builds'], f'{os.getpid()}.ccache-stats')
        env['CCACHE_STATSLOG'] = slog   # per-build hit/miss lines for build-history.tsv (one line per ccache call)
        t_run, ru0 = time.time(), resource.getrusage(resource.RUSAGE_CHILDREN)
        repointed = ccache_repoint(cmd, rec, env) if jobserver else None
        if jobserver:
            env['MAKEFLAGS'] = f'-j --jobserver-auth=fifo:{FIFO}'
        pre = None if ship else (lambda: os.nice(15))
        p = subprocess.Popen(cmd, env=env, preexec_fn=pre, start_new_session=True)
        history_ctx = (t_run, ru0, slog, tokens, repointed)
        wjson(rec, {'pid': os.getpid(), 'child_pid': p.pid, 'cmd': cmd, 'cwd': os.getcwd(), 'tokens': tokens,
                    'jobserver': jobserver, 'registered': registered, 'started': now_s()})
        fcntl.flock(exec_lk, fcntl.LOCK_UN)
        exec_locked = False
        while True:
            try:
                rc = p.wait()
                build_history(cmd, history_ctx, rc)
                return rc
            except KeyboardInterrupt:
                p.send_signal(signal.SIGINT)
    finally:
        build = rjson(rec) or {'pid': os.getpid(), 'cwd': os.getcwd()}
        kill_leftover_build_compilers(build)
        if exec_locked:
            fcntl.flock(exec_lk, fcntl.LOCK_UN)
        os.close(exec_lk)
        if got:
            os.write(fifo, b'+' * got)
        fcntl.flock(lk, fcntl.LOCK_UN)
        os.close(lk)
        os.close(fifo)
        for f in (rec, os.path.join(D['builds'], f'{os.getpid()}.ccache-stats')):
            try:
                os.unlink(f)
            except OSError:
                pass


CCACHE_LAUNCHER = os.path.expanduser('~/Games/Xbox360/bo2-build/ccache/launcher')


def ccache_configure(cmd):
    """Fresh `cmake -S/-B` configure: share one compile cache across worktrees (build-cache stream, 2026-11-24).
    1. /tmp/ paths become /private/tmp/: ninja runs in the physical dir and ccache's base_dir rewrite only gives the same relative
       paths in every worktree when no /tmp spelling appears anywhere. 2. the ccache launcher goes in as the compiler launcher.
    Skipped for --build, -E, -P, build dirs that already have a CMakeCache.txt (adding a launcher would rebuild them from scratch),
    explicit launchers, and BUILDQ_NO_CCACHE=1. BUILDQ_CCACHE_REPOINT=1 lifts the existing-dir skip. Stats: ~/Games/Xbox360/bo2-build/ccache/stats"""
    if '--build' in cmd or '-E' in cmd or '-P' in cmd or '--install' in cmd or os.environ.get('BUILDQ_NO_CCACHE'):
        return cmd
    if not (os.path.exists(CCACHE_LAUNCHER) and any(a in ('-S', '-B') or a.startswith(('-S', '-B')) for a in cmd[1:])):
        return cmd
    if any('COMPILER_LAUNCHER' in a for a in cmd):
        return cmd
    out = [re.sub(r'(^|=|(?<=^-[SB]))/tmp/', r'\1/private/tmp/', a) for a in cmd]
    bdir = None
    for i, a in enumerate(out):
        if a == '-B' and i + 1 < len(out):
            bdir = out[i + 1]
        elif a.startswith('-B') and len(a) > 2:
            bdir = a[2:]
    if bdir is None or (os.path.exists(os.path.join(os.path.abspath(bdir), 'CMakeCache.txt')) and not os.environ.get('BUILDQ_CCACHE_REPOINT')):
        return cmd  # BUILDQ_CCACHE_REPOINT=1 (owner request only): re-point an existing dir at the cache; it rebuilds once
    return out + [f'-DCMAKE_{l}_COMPILER_LAUNCHER={CCACHE_LAUNCHER}' for l in ('C', 'CXX', 'OBJC', 'OBJCXX')]


CCACHE_HISTORY = os.path.expanduser('~/Games/Xbox360/bo2-build/ccache/build-history.tsv')
CCACHE_REPOINT_LOG = os.path.expanduser('~/Games/Xbox360/bo2-build/ccache/repoint.log')
REPOINT_MAX = 2   # repoints (= one-time cold rebuilds) in flight at once; a slot is held until that build ends


def build_dir_of(cmd):
    """Build dir of `cmake --build DIR` / `ninja -C DIR` / plain ninja (cwd), absolute and physical, else None."""
    base = os.path.basename(cmd[0])
    d = None
    if base == 'cmake' and '--build' in cmd and cmd.index('--build') + 1 < len(cmd):
        d = cmd[cmd.index('--build') + 1]
    elif base == 'ninja':
        d = cmd[cmd.index('-C') + 1] if '-C' in cmd and cmd.index('-C') + 1 < len(cmd) else os.getcwd()
    return os.path.realpath(d) if d else None


def ccache_repoint(cmd, rec, env):
    """Adopt the shared compile cache for ANY build dir at its next build (build-cache-adopt, 2026-11-24): if the dir's CMakeCache has no
    ccache launcher and no compiler of any kind runs in it, reconfigure with the launcher. The first build afterwards is cold, so at most
    REPOINT_MAX dirs repoint at once (a slot lasts until that buildq exits; other dirs repoint at a later build). Never touches dirs with a
    foreign launcher, BUILDQ_NO_CCACHE=1, or a failing configure (the build then runs as before). Every action is logged to repoint.log."""
    if os.environ.get('BUILDQ_NO_CCACHE') or not os.path.exists(CCACHE_LAUNCHER):
        return None
    bdir = build_dir_of(cmd)
    cc = os.path.join(bdir or '', 'CMakeCache.txt')
    if not bdir or not os.path.exists(cc):
        return None
    vals = {}
    for line in open(cc, errors='replace'):
        m = re.match(r'(CMAKE_(?:C|CXX|OBJC|OBJCXX)_COMPILER_LAUNCHER|CMAKE_HOME_DIRECTORY):[A-Z]+=(.*)', line)
        if m:
            vals[m.group(1)] = m.group(2).strip()
    cur = {v for k, v in vals.items() if k.endswith('LAUNCHER') and v}
    src = vals.get('CMAKE_HOME_DIRECTORY')
    if cur == {CCACHE_LAUNCHER} or (cur and CCACHE_LAUNCHER not in cur) or not src:
        return None
    def log(msg):
        with open(CCACHE_REPOINT_LOG, 'a') as f:
            f.write(f'{time.strftime("%F %T")} {bdir} {msg}\n')
    ps = subprocess.run(['ps', '-axo', 'pid=,command='], capture_output=True, text=True).stdout.splitlines()
    busy = [l for l in ps if bdir in l and re.search(r'(^|/)(clang(\+\+)?|ninja|cc1|ld|metal\w*)$', l.split(None, 2)[1] if len(l.split(None, 2)) > 1 else '')
            and l.split()[0] != str(os.getpid())]
    if busy:
        log('skip: compiler/ninja running in dir')
        return None
    lock = os.path.join(D['builds'], f'repoint-{os.getpid()}.slot')
    live = 0
    for f in os.listdir(D['builds']):
        if f.startswith('repoint-') and f.endswith('.slot'):
            pid = int(f.split('-')[1].split('.')[0])
            if alive(pid) and pid != os.getpid():
                live += 1
            elif not alive(pid):
                try:
                    os.unlink(os.path.join(D['builds'], f))
                except OSError:
                    pass
    if live >= REPOINT_MAX:
        log(f'defer: {live} repoints in flight')
        return None
    open(lock, 'w').close()
    args = ['cmake', '-S', src, '-B', bdir] + [f'-DCMAKE_{l}_COMPILER_LAUNCHER={CCACHE_LAUNCHER}' for l in ('C', 'CXX', 'OBJC', 'OBJCXX')]
    r = subprocess.run(args, env=env, capture_output=True, text=True, preexec_fn=lambda: os.nice(15))
    log(f'repointed rc={r.returncode}' + ('' if r.returncode == 0 else ' ' + (r.stderr or r.stdout)[-300:].replace('\n', ' | ')))
    if r.returncode != 0:
        os.unlink(lock)
        return None
    return 'repointed'


def build_history(cmd, ctx, rc):
    """One tsv line per finished buildq build: time, dir, tokens, wall, CPU (children user+sys), cache hits/misses from this build's own ccache stats log."""
    t_run, ru0, slog, tokens, repointed = ctx
    ru = resource.getrusage(resource.RUSAGE_CHILDREN)
    hits = misses = other = 0
    try:
        for line in open(slog, errors='replace'):
            r = line.split('\t')[-1].strip() if '\t' in line else line.strip()
            if 'hit' in r:
                hits += 1
            elif 'cache_miss' in r or r.endswith('miss'):
                misses += 1
            else:
                other += 1
    except OSError:
        pass
    row = [time.strftime('%F %T'), build_dir_of(cmd) or os.getcwd(), ' '.join(cmd[:3])[:60], tokens, round(time.time() - t_run),
           round(ru.ru_utime + ru.ru_stime - ru0.ru_utime - ru0.ru_stime), hits, misses, other, repointed or '', rc]
    new = not os.path.exists(CCACHE_HISTORY)
    with open(CCACHE_HISTORY, 'a') as f:
        if new:
            f.write('time\tdir\tcmd\ttokens\twall_s\tcpu_s\thits\tmisses\tother\trepointed\trc\n')
        f.write('\t'.join(map(str, row)) + '\n')


def strip_jobs(cmd):
    out, i = [], 0
    while i < len(cmd):
        a = cmd[i]
        if a in ('-j', '--parallel'):
            i += 2 if i + 1 < len(cmd) and cmd[i + 1].isdigit() else 1
            continue
        if re.fullmatch(r'-j\d+|--parallel=\d+', a):
            i += 1
            continue
        out.append(a)
        i += 1
    return out



def test_laptop():
    """Self-test of the laptop path: eligibility, atomic claim, beats, requeue, fallback, finish, cancel."""
    import tempfile
    global D, LAPTOP_HB
    old = (dict(D), LAPTOP_HB)
    with tempfile.TemporaryDirectory() as tmp:
        D = {k: os.path.join(tmp, k) for k in D}
        LAPTOP_HB = os.path.join(tmp, 'laptop.json')
        mkdirs()
        def submit(jid, where, name='t'):
            out = os.path.join(tmp, 'o-' + jid)
            os.makedirs(out)
            j = {'id': jid, 'name': name, 'where': where, 'out': out, 'cmd': ['true'], 'class': 3,
                 'submitted_t': time.time()}
            wjson(os.path.join(D['queue'], f'1-{time.time():.6f}-{jid}.json'), j)
            return j
        mac = {'where': 'mac'}
        assert mac_may_run(mac) and not mac_may_run({'where': 'laptop'}) and mac_may_run({'where': 'any'}, {'state': 'unreachable'})
        assert mac_may_run({'where': 'any'}, {'state': 'busy'}) and not mac_may_run({'where': 'any'}, {'state': 'idle'})
        assert laptop_state()['state'] == 'unreachable'
        submit('a', 'any'); submit('m', 'mac'); submit('l', 'laptop')
        c1 = remote_claim('w1', '0.1')
        assert c1['id'] in ('a', 'l') and laptop_state()['state'] == 'idle'
        c2 = remote_claim('w2')
        assert c2 and c2['id'] != c1['id']
        assert remote_claim('w3') is None                       # 'm' (mac) is never handed out; each job claimed once
        assert [j['id'] for _, j in load_queue()] == ['m']
        assert remote_beat('w1', c1['id']) == 'ok' and laptop_state()['state'] == 'busy'
        assert remote_beat('wX', c1['id']) == 'lost'
        # a killed job goes back to the queue, attempts counted
        assert remote_finish('w1', c1['id'], 137, 5, 'killed') == 'requeued'
        assert c1['id'] in [j['id'] for _, j in load_queue()]
        # a vanished worker: lease expiry requeues
        c = remote_claim('w1')
        assert c['id'] == c1['id']
        j = rjson(os.path.join(D['remote'], c['id'] + '.json'))
        reap_remote(now=j['claim']['beat'] + 10)
        assert os.path.exists(os.path.join(D['remote'], c['id'] + '.json'))
        reap_remote(now=j['claim']['beat'] + LAPTOP_LEASE_S + 1)
        assert not os.path.exists(os.path.join(D['remote'], c['id'] + '.json'))
        assert rjson(os.path.join(D['queue'], [f for f in os.listdir(D['queue']) if f.endswith(c['id'] + '.json')][0]))['attempts'] == 2
        # third failure: `any` falls back to the Mac, `laptop` is recorded lost
        for want in ('any', 'laptop'):
            jid = c1['id'] if want == c1['where'] else c2['id']
            for _ in range(LAPTOP_MAX_ATTEMPTS):
                cj = remote_claim('w1')
                while cj and cj['id'] != jid:
                    remote_requeue(cj, 'skip'); cj = remote_claim('w1')
                if cj:
                    remote_finish('w1', jid, 124, 1, 'timeout')
            if want == 'any':
                q = [j for _, j in load_queue() if j['id'] == jid]
                assert q and q[0]['where'] == 'mac' and mac_may_run(q[0]), q
        # normal result, nonzero exit is a result not a requeue
        submit('r', 'laptop')
        for _ in range(5):
            cj = remote_claim('w1')
            if cj and cj['id'] == 'r':
                break
            if cj:
                remote_requeue(cj, 'skip')
        assert remote_finish('w1', 'r', 3, 1.5, 'exit') == 'done'
        r = rjson(os.path.join(D['done'], 'r.json'))
        assert r['exit'] == 3 and r['host'] == 'laptop' and 'on laptop' in open(os.path.join(r['out'], 'result.txt')).read()
        # cancel
        submit('x', 'laptop')
        for _ in range(8):
            cj = remote_claim('w1')
            if cj and cj['id'] == 'x':
                break
            if cj:
                remote_requeue(cj, 'skip')
        open(os.path.join(D['remote'], 'x.cancel'), 'w').close()
        assert remote_beat('w1', 'x') == 'cancel'
        remote_finish('w1', 'x', 143, 1, 'cancelled')
        assert rjson(os.path.join(D['done'], 'x.json'))['status'] == 'cancelled'
    D, LAPTOP_HB = old
    print('runq laptop path self-test passed: eligibility, atomic claim, beats, requeue on kill/timeout/lost worker, '
          'Mac fallback after 3 tries, lost for laptop-only, result, cancel')


def test_phases(bump_waiting):
    """Alternating windows: phase_step / phase_admits / plan on synthetic queues."""
    c = {'solo_batch_n': 3, 'ord_window_s': 1200}   # (tests pin 1200; the default is ORD_WINDOW_S)
    S = lambda i, o='o1', **k: {'id': f's{i}', 'class': CLASSES['perf'], 'solo': True, 'owner': o, 'submitted_t': 0 + i, **k}
    O = lambda i, o='o2', **k: {'id': f'g{i}', 'class': CLASSES['proof'], 'owner': o, 'submitted_t': 0 + i, **k}
    ord0 = new_phase('ord', 0)
    # ordinary window with solo + ordinary waiting stays open until the window time, then closes and flips on empty
    assert phase_step(ord0, 100, [S(1)], [O(1)], False, False, c) is ord0
    closing = phase_step(ord0, 1300, [S(1)], [O(1)], False, False, c)
    assert closing['phase'] == 'ord' and closing['closing']
    assert phase_step(closing, 1301, [S(1)], [O(1)], False, False, c) is closing
    assert phase_step(closing, 1500, [S(1)], [O(1)], True, False, c)['phase'] == 'solo'
    # nothing ordinary waiting: flip as soon as the machine is empty; no solo waiting: stay ordinary
    assert phase_step(ord0, 5, [S(1)], [], True, False, c)['phase'] == 'solo'
    assert phase_step(ord0, 5, [], [O(1)], True, False, c) is ord0
    assert phase_step(ord0, 5, [S(1, bump=True)], [O(1)], True, False, c)['phase'] == 'ord'    # bump waits for ord_min_s
    assert phase_step(ord0, 700, [S(1, bump=True)], [O(1)], True, False, c)['phase'] == 'solo'   # then closes it
    assert phase_step(dict(ord0, prev_solo_s=600), 700, [S(1, bump=True)], [O(1)], True, False, c)['phase'] == 'ord'   # solo share cap
    # solo window: runs N back to back, then hands over; never flips while a solo runs
    sol = new_phase('solo', 0)
    assert phase_step(sol, 10, [S(1)], [O(1)], True, True, c) is sol
    assert phase_step(sol, 10, [S(1)], [O(1)], True, False, c) is sol
    done3 = dict(sol, solo_started=3)
    assert phase_step(done3, 10, [S(1)], [O(1)], True, True, c) is done3
    assert phase_step(done3, 10, [S(1)], [O(1)], True, False, c)['phase'] == 'ord'
    assert phase_step(sol, 10, [], [O(1)], True, False, c)['phase'] == 'ord'
    assert phase_step(sol, 2000, [S(1)], [O(1)], True, False, c)['phase'] == 'ord'      # solo window time bound
    # admission
    assert phase_admits(sol, True, 5, True, 360, 5, True, False, c)
    assert not phase_admits(sol, True, 5, False, 360, 5, True, False, c)               # needs an empty machine
    assert not phase_admits(dict(sol, solo_started=3), True, 5, True, 360, 5, True, False, c)
    assert not phase_admits(sol, False, 5, True, 60, 5, True, False, c)                # ordinary waits in solo window...
    assert not phase_admits(sol, False, 5, True, 60, 5, True, True, c)                 # ...even in a build window
    assert not phase_admits(ord0, True, 5, True, 360, 5, True, False, c)
    assert phase_admits(ord0, False, 5, False, 60, 5, True, False, c)
    assert not phase_admits(closing, False, 1400, False, 60, 5, True, False, c)
    assert phase_admits(ord0, False, 5, False, 600, 5, True, False, c)                 # a 10 min game fits a fresh window
    assert not phase_admits(ord0, False, 5, False, 1100, 5, True, False, c)          # a 20 min one (30 min budget) waits for age
    assert not phase_admits(ord0, False, 1100, False, 600, 5, True, False, c)          # ...and nothing long near the end
    assert phase_admits(ord0, False, 1100, False, 2400, 1900, True, False, c)          # unless it already waited 30 min
    assert phase_admits(ord0, False, 1100, False, 2400, 5, False, False, c)            # no solo waiting: anything
    assert phase_admits(ord0, False, 1100, False, 2400, 5, True, False, c, True)       # long lane: a 40 min job starts anyway
    assert not phase_admits(ord0, False, 1100, False, 2400, 5, True, False, c, False)  # ...unless the lane is full
    assert not phase_admits(closing, False, 1400, False, 2400, 5, True, False, c, True) # ...never in a closing window
    # plan(): 9 solo (3 owners x 3) + 6 ordinary, 3 slots: solo batch of 3 then ordinary window, owners rotate
    hist = ({}, {})
    q = [(f'qs{i}', S(i, 'ab' if i < 5 else ('cd' if i < 7 else 'ef'), timeout_s=360)) for i in range(1, 10)]
    q += [(f'qg{i}', O(i, 'x', timeout_s=300)) for i in range(1, 7)]
    out = plan(q, [], 3, {}, now=1000, hist=hist, phase=new_phase('ord', 1000), c=c)
    first = [qf for qf, *_ in out]
    assert first[:6] == ['qg1', 'qg2', 'qg3', 'qg4', 'qg5', 'qg6'] or first[0].startswith('qg'), first
    solo_order = [j['owner'] for _, j, *_ in out if is_solo(j)]
    assert solo_order[:3] != ['ab', 'ab', 'ab'], solo_order       # one owner's halves do not take a whole batch
    starts = {qf: t for qf, _, t, _ in out}
    assert max(t for qf, t in starts.items() if qf.startswith('qg')) - 1000 < 2400   # ordinary starts bounded
    mixed = [(f'm{i}', j) for i, j in enumerate([S(1, 'sp', **{'class': CLASSES['proof']}), S(2, 'sp', **{'class': CLASSES['proof']}),
                                                  S(3, 'ct'), S(4, 'ge')])]
    o = plan(mixed, [], 3, {'sp': 500}, now=1000, hist=({}, {}), phase=new_phase('solo', 1000), c=c)
    assert [j['owner'] for _, j, *_ in o][:3] == ['ct', 'ge', 'sp'], [j['owner'] for _, j, *_ in o]   # proof-class chain does not jump perf solos
    print('runq window self-test passed')



