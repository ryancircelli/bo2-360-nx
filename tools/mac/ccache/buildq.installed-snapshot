                                      'since_s': round(time.time() - v['start']),
                                      'paused_s': round(v.get('paused_s', 0.0) + (time.time() - v['lane_t'] if v.get('lane_pids') else 0.0))} for k, v in self.jobs.items()},
                      'quiet_starting': self.quiet_starting,
