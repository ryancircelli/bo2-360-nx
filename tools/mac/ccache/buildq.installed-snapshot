def oldest_build_wait_s(now=None):
    now = time.time() if now is None else now
    waits = []
    for f in os.listdir(D['builds']):
        if not f.endswith('.json'):
            continue
        b = rjson(os.path.join(D['builds'], f)) or {}
        registered = b.get('registered') or b.get('started')
        if b.get('pid') and alive(b['pid']) and registered:
            try:
                started = time.mktime(time.strptime(registered, '%Y-%m-%d %H:%M:%S'))
                waits.append(max(0, now - started))
            except ValueError:
                continue
    return max(waits, default=0)


# ------------------------------------------------------------------ daemon
def daemon_running():
    mkdirs()
    fd = os.open(DAEMON_LOCK, os.O_RDWR | os.O_CREAT, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        return True
    fcntl.flock(fd, fcntl.LOCK_UN)
    os.close(fd)
    return False


def spawn_detached_daemon(executable):
    """Double-fork so the daemon is orphaned before the submitting command returns."""
    first = os.fork()
    if first:
        os.waitpid(first, 0)
        return
    try:
        os.setsid()
        second = os.fork()
        if second:
            os._exit(0)
        null_fd = os.open(os.devnull, os.O_RDONLY)
        os.dup2(null_fd, 0)
        log_fd = os.open(DLOG, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
        os.dup2(log_fd, 1)
        os.dup2(log_fd, 2)
        os.execv(sys.executable, [sys.executable, '-I', executable, '_daemon'])
    except BaseException as e:
        try:
            os.write(2, f'runq: detached daemon start failed: {e}\\n'.encode())
        except OSError:
            pass
    os._exit(1)


def ensure_daemon(fatal=True):
    if daemon_running():
        return True
    if os.getpriority(os.PRIO_PROCESS, 0) > 0:
        print('runq: starting the daemon from a niced shell; games would inherit the nice value. Run any runq '
              'command once without nice first.', file=sys.stderr)
    me = os.path.realpath(__file__)
    spawn_detached_daemon(me)
    for _ in range(100):
        st = rjson(STATE) or {}
        if st.get('pid') and alive(st['pid']) and daemon_running():
            return True
        time.sleep(0.1)
    if daemon_running():   # the lock is held: a daemon is up but has not written its state yet
        return True
    if fatal:
        sys.exit('runq: the daemon did not start; see ' + DLOG)
    print('runq: the daemon did not start (see ' + DLOG + '); still waiting', file=sys.stderr, flush=True)
    return False


class Adopted:
    """A job started by an earlier daemon: not our child, so poll by pid and read the wrapper's exit file."""
    def __init__(self, pid, out):
        self.pid, self.out = pid, out

    def poll(self):
        if alive(self.pid):
            return None
        try:
            return int(open(os.path.join(self.out, EXIT_FILE)).read().strip())
        except (OSError, ValueError):
            return UNKNOWN_EXIT


EXIT_FILE = '.runq_exit'
UNKNOWN_EXIT = 125   # an adopted job that left no exit file (started before the job wrapper existed, or killed)
# every job runs under this wrapper so a restarted daemon can still learn the exit code
WRAP = ['/bin/sh', '-c', '"$@"; c=$?; echo $c > "$RUNQ_OUT/' + EXIT_FILE + '"; exit $c', 'runq-job']


class Daemon:
    def __init__(self):
        self.c = cfg()
        OWNER_PRIORITY[:] = list(self.c.get('owner_priority') or [])
        self.held = 0           # build tokens the daemon holds back while games run
        self.power_checked_at = 0.0
        self.power_status = None
        self.power_hold = None
        self.perf_hold = None
        self.last_external_build_activity = None
        self.protected_pids = process_ancestors(os.getpid())
        self.jobs = {}          # id -> {proc, job, slot, start, samples, cancel}
        self.quiet_starting = False
        self.last_repair = 0.0
        self.outside = []
        self.outside_builds = []   # CPU-active build processes no buildq build owns: [{pid, exe, cwd}] (runq status)
        self.outside_builds_t = 0.0
        st = rjson(STATE) or {}
        self.last_start = st.get('last_start_by_owner') or {}
        self.phase = st.get('phase') or new_phase('ord', time.time())
        self.last_external_build_activity = restorable_external_activity(
            st.get('last_external_build_activity'), st.get('last_external_build_activity_source'))
        self.last_external_build_activity_source = ('outside' if self.last_external_build_activity is not None else None)
        self.build_interleave_until = float(self.c.get('build_interleave_until') or st.get('build_interleave_until') or 0)
        if self.build_interleave_until > time.time() + BUILD_INTERLEAVE_WINDOW_S:
            self.build_interleave_until = time.time() + BUILD_INTERLEAVE_WINDOW_S
        self.perf_batch = set(st.get('perf_batch') or [])
        self.stop_requested = False
        self.handoff = False
        self.freeze_outside = False

    def log(self, msg):
        print(f'[{now_s()}] {msg}', flush=True)

    # --- token pool
    def pool_open(self):
        if not os.path.exists(FIFO):
            os.mkfifo(FIFO, 0o666)
        self.fifo = os.open(FIFO, os.O_RDWR | os.O_NONBLOCK)  # keeps the fifo's contents alive while the daemon runs
        # Never block here: with builds running (pool.lock shared) their open fifo kept the tokens of the last daemon,
        # which returned the ones it held back; the 30 s repair evens the pool out once the builds are done.
        self.refill()

    def drain(self):
        n = 0
        while True:
            try:
                b = os.read(self.fifo, 64)
            except BlockingIOError:
                return n
            if not b:
                return n
            n += len(b)

    def refill(self, force=False):
        """With no build running (pool.lock free), the pool must hold exactly idle_cap - held tokens: lost tokens (a
        build killed with SIGKILL) come back and extras go."""
        lk = os.open(POOL_LOCK, os.O_RDWR | os.O_CREAT, 0o666)
        try:
            fcntl.flock(lk, fcntl.LOCK_EX | (0 if force else fcntl.LOCK_NB))
        except OSError:
            os.close(lk)
            return
        try:
            had = self.drain()
            want = max(0, self.c['idle_cap'] - self.held)
            os.write(self.fifo, b'+' * want)
            if had != want and not force:
                self.log(f'pool repaired: {had} tokens -> {want}')
        finally:
            fcntl.flock(lk, fcntl.LOCK_UN)
            os.close(lk)

    def cap_now(self):
        """(cap, why): game_cap while a measured job runs, run_cap while only unmeasured games run (games started
        outside runq count as unmeasured), idle_cap with no game."""
        # Queue held by config paused_until (owner playing): no solo can start, so do not hold builds at 0 for one
        # (11-23 19:13-19:30: cap 0 'preparing' with 10 builds waiting while the queue was paused).
        if paused(self.c) and not self.jobs and not self.quiet_starting:
            return self.c['idle_cap'], 'queue paused (paused_until): idle build cap'
        build_window = self.build_interleave_active()
        quiet = [j['job'].get('name', j['job']['id']) for j in self.jobs.values()
                 if j['job'].get('quiet_machine') or is_solo(j['job']) or
                 job_class(j['job']) == CLASSES['perf']]
        if build_window and not quiet and not self.quiet_starting:
            measured = [j['job'].get('name', j['job']['id']) for j in self.jobs.values()
                        if is_measured(j['job'])]
            if measured:
                return self.c['game_cap'], 'build window with measured game(s): ' + ', '.join(measured)
            if self.jobs or self.outside:
                return min(self.c.get('run_cap', 12), self.c['idle_cap']), \
                    f'build window with {len(self.jobs) + len(self.outside)} unmeasured game(s)'
            return self.c['idle_cap'], 'build window: no solo jobs; idle build cap'
        # Builds stay up while ordinary games still drain ahead of a speed batch (a 29 min Forza drive froze every build
        # for the whole drain, 11-23); the cap drops to 0 only when no such game remains or a quiet job is starting.
        draining = [j for j in self.jobs.values() if not (is_solo(j['job']) or j['job'].get('quiet_machine') or
                                                           job_class(j['job']) == CLASSES['perf'])]
        if quiet or self.quiet_starting or (self.perf_batch and not draining):
            return 0, 'quiet machine: ' + (', '.join(quiet) if quiet else 'preparing')
        measured = [j['job'].get('name', j['job']['id']) for j in self.jobs.values() if is_measured(j['job'])]
        if measured:
            return self.c['game_cap'], 'measured: ' + ', '.join(measured)
        if self.jobs or self.outside:
            return min(self.c.get('run_cap', 12), self.c['idle_cap']), \
                f'{len(self.jobs) + len(self.outside)} unmeasured game(s)'
        return self.c['idle_cap'], 'no game'

    def throttle(self):
        cap, why = self.cap_now()
        if cap != getattr(self, 'cap', None):
            self.log(f'build cap {getattr(self, "cap", "-")} -> {cap} ({why})')
            self.cap, self.cap_why = cap, why
        target = max(0, self.c['idle_cap'] - cap)
        while self.held < target:
            try:
                b = os.read(self.fifo, target - self.held)
            except BlockingIOError:
                break
            self.held += len(b)
        if self.held > target:
            os.write(self.fifo, b'+' * (self.held - target))
            self.held = target
        if time.time() - self.last_repair > 30:
            self.last_repair = time.time()
            self.refill()

    # --- jobs
    def queued(self):
        return sorted(f for f in os.listdir(D['queue']) if f.endswith('.json'))

    def pick(self, q):
        """The next job: lowest class, then bumped jobs, then the owner with the fewest running jobs who was served
        longest ago, then FIFO."""
        rbo = {}
        for j in self.jobs.values():
            o = job_owner(j['job'])
            rbo[o] = rbo.get(o, 0) + 1
        jobs = [(f, rjson(os.path.join(D['queue'], f)) or {}) for f in q]
        key = fair_key if jobs and all(is_solo(j) for _, j in jobs) else sched_key
        jobs.sort(key=lambda fj: key(fj[1], rbo, self.last_start))
        return jobs[0][0]

    def launch(self, qfile):
        src = os.path.join(D['queue'], qfile)
        job = rjson(src)
        if not job:
            if os.path.exists(src):
                os.unlink(src)
            return   # (or the laptop worker claimed it between pick and launch)
        used = {j['slot'] for j in self.jobs.values()}
        slot = min(set(range(self.c['slots'])) - used)
        out = job['out']
        os.makedirs(out, exist_ok=True)
        app = job.get('app') or ''
        if app and job.get('clone_app', True):
            dst = os.path.join(out, 'app', os.path.basename(app.rstrip('/')))
            if os.path.exists(dst):
                shutil.rmtree(os.path.dirname(dst))
            os.makedirs(os.path.dirname(dst))
            r = subprocess.run(['cp', '-cR', app, dst], capture_output=True, text=True)  # APFS clone: no copy
            if r.returncode:
                self.finish_record(job, slot, 2, 'error', time.time(), [], f'app clone failed: {r.stderr.strip()}')
                os.unlink(src)
                return
            app = dst
        port = str(self.c['port_base'] + 2000 * slot)
        subst = {'{APP}': app, '{OUT}': out, '{PORT}': port, '{SLOT}': str(slot), '{IN}': os.path.join(out, 'in')}
        if job.get('inputs'):   # same layout the laptop worker builds: {IN}/<basename> (symlinks here, nothing to copy)
            os.makedirs(subst['{IN}'], exist_ok=True)
            for ip in job['inputs']:
                link = os.path.join(subst['{IN}'], os.path.basename(ip.rstrip('/')))
                if not os.path.lexists(link):
                    os.symlink(ip, link)
        cmd = [subst.get(a, a) if a in subst else (a.replace('{OUT}', out).replace('{IN}', subst['{IN}']) if job.get('where') else a)
               for a in job['cmd']]
        cmd = [re.sub(r'\{(APP|OUT|PORT|SLOT|IN)\}', lambda m: subst['{' + m.group(1) + '}'], a) for a in cmd]
        quiet_pids = []
        agent_pids, agent_deadline = [], 0.0
        exec_lock_fd = None
        if job.get('quiet_machine') or is_solo(job) or job_class(job) == CLASSES['perf']:
            # Class-perf always means a measured quiet-machine run, even if an older
            # queued manifest omitted --quiet-machine.
            if job.get('quiet_machine') or job_class(job) == CLASSES['perf']:
                job['quiet_machine'] = True
            self.quiet_starting = True
            exec_lock_fd = os.open(BUILD_EXEC_LOCK, os.O_RDWR | os.O_CREAT, 0o666)
            fcntl.flock(exec_lock_fd, fcntl.LOCK_EX)
            self.throttle()
            def stop_build_pid(pid):
                if pid in quiet_pids or pid in self.protected_pids or not alive(pid):
                    return
                # Persist intent first: recovery may SIGCONT a process that was not stopped yet, harmlessly.
                quiet_pids.append(pid)
                job['quiet_build_pids'] = quiet_pids
                wjson(src, job)
                try:
                    os.kill(pid, signal.SIGSTOP)
                except (ProcessLookupError, PermissionError):
                    pass

            if getattr(self, 'freeze_outside', False) and (job.get('quiet_machine') or job_class(job) == CLASSES['perf']):
                compiler_processes()   # refreshes PROCESS_SNAPSHOT
                held = [p['pid'] for p in PROCESS_SNAPSHOT if is_build_activity_process(p)
                        and p['pid'] not in self.protected_pids]
                for pid in held:
                    stop_build_pid(pid)
                self.log(f'froze {len(held)} outside build process(es) for {job["id"]}')
            if job.get('quiet_machine') or job_class(job) == CLASSES['perf']:
                compiler_processes()
                heavy = [p['pid'] for p in PROCESS_SNAPSHOT if is_freezable_heavy(p) and not process_is_stopped(p)
                         and p['pid'] not in self.protected_pids and p['pid'] != os.getpid()]
                for pid in heavy:
                    stop_build_pid(pid)
                if heavy:
                    self.log(f'froze {len(heavy)} heavy outside process(es) for {job["id"]}')
            builds = registered_buildq_builds()
            # a client with no child yet holds tokens but runs nothing: stopping it only strands the grant (buildq pids stuck in T 3-6 h)
            roots = {int(pid) for build in builds if build.get('child_pid')
                     for pid in (build.get('pid'), build.get('child_pid')) if pid}
            # Stop every token owner before inspecting children so none can spawn another compiler.
            for pid in roots:
                stop_build_pid(pid)
            if compiler_processes() is not None:
                kids = {p['ppid'] for p in PROCESS_SNAPSHOT}
                by_p = {p['pid']: p for p in PROCESS_SNAPSHOT}
                for pid in buildq_owned_processes(PROCESS_SNAPSHOT):
                    if 'bin/buildq' in by_p.get(pid, {}).get('command', '') and pid not in kids:
                        continue  # idle client: stopping it only strands its token grant
                    stop_build_pid(pid)
            else:
                for pid in roots:
                    for child in process_tree(pid):
                        stop_build_pid(child)
            if job.get('quiet_machine'):
                if self.c.get('agent_freeze', True):
                    compiler_processes()
                    for pid in solo_freeze_targets(PROCESS_SNAPSHOT, self.protected_pids | {os.getpid()}, set(),
                                                   job.get('out', ''), _FREEZE_CPU_PREV):
                        if pid not in quiet_pids:
                            quiet_pids.append(pid)
                            agent_pids.append(pid)
                            freeze_log(f'{job["id"]} freeze {pid} {by_pid_cmd(pid)}')
                            _FREEZE_T0[pid] = time.monotonic()
                            try:
                                os.kill(pid, signal.SIGSTOP)
                            except (ProcessLookupError, PermissionError):
                                pass
                    self.log(f'froze {len(agent_pids)} agent/tool process(es) for {job["id"]} '
                             f'(max {SOLO_FREEZE_MAX_S} s)')
                agent_deadline = time.time() + SOLO_FREEZE_MAX_S
                # the watchdog covers every pid this run froze (builds too) and outlives the daemon
                write_agent_freeze(job['id'], quiet_pids, 0, agent_deadline + SOLO_WATCHDOG_GRACE_S)
                subprocess.Popen([sys.executable, '-I', os.path.join(HERE, 'runq'), '_freeze-watchdog',
                                  agent_freeze_file(job['id']), str(os.getpid())], start_new_session=True,
                                 stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            job['quiet_build_pids'] = quiet_pids
            wjson(src, job)  # recover the suspension even if the daemon exits before Popen/run.json
            if job.get('quiet_machine'):
                cmd = [sys.executable, '-I', os.path.join(HERE, 'runq'), '_quiet-wait', '--'] + cmd
        env = dict(os.environ)
        env['REX_AUDIO_MUTE'] = 'true'  # owner rule: test games never make sound
        # owner 11-22: test games grabbed his real keyboards/receivers; tests never open real USB input devices
        env['SDL_HIDAPI_LIBUSB'] = '0'
        env['SDL_JOYSTICK_HIDAPI'] = '0'
        env.update(RUNQ_QUIET_CORES=str(self.c.get('quiet_outside_max_cores', QUIET_OUTSIDE_MAX_CORES)),
                   RUNQ_QUIET_CALM_S=str(self.c.get('quiet_calm_s', QUIET_CALM_S)),
                   RUNQ_QUIET_WAIT_CAP_S=str(self.c.get('quiet_wait_cap_s', QUIET_GATE_CAP_S)))
        env.update(job.get('env') or {})
        env.update(RUNQ_HOST='mac', RUNQ_JOB=job['id'], RUNQ_SLOT=str(slot), RUNQ_OUT=out, BO2_NET_PORT_OFFSET=port)
        if job_class(job) == CLASSES['perf']:
            env['RUNQ_PERF_GUARD'] = 'true'
            if not job.get('quiet_machine'):
                cmd = [sys.executable, '-I', os.path.join(HERE, 'runq'), '_perf-wait', '--'] + cmd
        start = time.time()
        la = loadavg()
        rec = {'id': job['id'], 'pid': None, 'slot': slot, 'started': now_s(), 'load_start': la,
               'cmd': cmd, 'games_start': len(self.fg_jobs()) + 1 + len(self.outside)}
        qlog = os.path.join(out, 'runq.log')
        log = open(qlog, 'ab')
        job['runq_log_offset'] = os.fstat(log.fileno()).st_size
        wjson(src, job)
        try:
            try:
                os.unlink(os.path.join(out, EXIT_FILE))
            except OSError:
                pass
            proc = subprocess.Popen(WRAP + cmd, cwd=job.get('cwd') or out, env=env, stdin=subprocess.DEVNULL, stdout=log,
                                    stderr=subprocess.STDOUT, start_new_session=True)
        except BaseException as e:
            log.close()
            try:
                self.finish_record(job, slot, 2, 'error', start, [], f'cannot start: {e}')
                os.unlink(src)
            finally:
                self.resume_builds(quiet_pids)
                self.quiet_starting = False
                if exec_lock_fd is not None:
                    fcntl.flock(exec_lock_fd, fcntl.LOCK_UN)
                    os.close(exec_lock_fd)
            if isinstance(e, OSError):
                return
            raise
        log.close()
        registered = False
        try:
            rec['pid'] = proc.pid
            rec['quiet_pids'] = quiet_pids
            os.replace(src, os.path.join(D['running'], job['id'] + '.json'))
            wjson(os.path.join(D['running'], job['id'] + '.run.json'), rec)
            with open(os.path.join(out, 'conditions.tsv'), 'w') as f:
                f.write('t_s\tload1\tload5\tactive_builds\tcompile_procs\tbuild_cap\tgames\tcompile_details_json\n')
            self.last_start[job_owner(job)] = time.time()
            compiler_baseline = compiler_processes() or []
            self.jobs[job['id']] = {'proc': proc, 'job': job, 'slot': slot, 'start': start, 'samples': [],
                                    'next_sample': 0.0, 'load_start': la, 'killing': 0.0,
                                    'games_start': len(self.fg_jobs()) + 1 + len(self.outside), 'quiet_pids': quiet_pids,
                                    'lane': bool(not is_solo(job) and is_lane_est(estimate_s(job, getattr(self, 'hist', ({}, {}))), self.c)),
                                    'agent_frozen': agent_pids, 'agent_deadline': agent_deadline,
                                    'compiler_cpu_prev': {p['pid']: p['cpu_s'] for p in compiler_baseline},
                                    'compiler_activity': {},
                                    'process_cpu_prev': {p['pid']: p['cpu_s'] for p in PROCESS_SNAPSHOT},
                                    'process_cpu_totals': {}}
            registered = True
            if agent_deadline:
                write_agent_freeze(job['id'], quiet_pids, proc.pid, agent_deadline + SOLO_WATCHDOG_GRACE_S)
            self.quiet_starting = False
            self.log(f'start {job["id"]} slot {slot} pid {proc.pid} load {la[0]}: {shlex.join(cmd)[:300]}')
            self.write_state()
        finally:
            if not registered:
                try:
                    os.killpg(proc.pid, signal.SIGTERM)
                except (ProcessLookupError, PermissionError):
                    pass
                self.resume_builds(quiet_pids)
                self.quiet_starting = False
            if exec_lock_fd is not None:
                fcntl.flock(exec_lock_fd, fcntl.LOCK_UN)
                os.close(exec_lock_fd)

    def sample(self, j, t):
        la = loadavg()
        compilers = compiler_processes()
        stopped_pids = confirmed_stopped_pids(j.get('quiet_pids', []), PROCESS_SNAPSHOT) \
            if compilers is not None else set()
        ab = active_builds(stopped_pids)
        activity = j.setdefault('compiler_activity', {})
        new_pids = [] if compilers is None else [p['pid'] for p in compilers if p['pid'] not in activity]
        cwds = process_cwds(new_pids)
        hot = [] if compilers is None else observe_compiler_activity(
            compilers, j.setdefault('compiler_cpu_prev', {}), activity, time.monotonic(), cwds)
        if compilers is not None and (j['job'].get('quiet_machine') or job_class(j['job']) == CLASSES['perf']):
            try:
                freeze_late_buildq_compilers(j, buildq_owned_processes(PROCESS_SNAPSHOT), time.time(), j['start'])
            except Exception as e:
                self.log(f'late freeze failed: {e!r}')
        cp = -1 if compilers is None else len(hot)
        totals = j.setdefault('process_cpu_totals', {})
        previous = j.setdefault('process_cpu_prev', {})
        for proc in PROCESS_SNAPSHOT:
            pid = proc['pid']
            old = previous.get(pid, proc['cpu_s'])
            delta = max(0.0, proc['cpu_s'] - old)
            previous[pid] = proc['cpu_s']
            if delta > 0:
                item = totals.setdefault(pid, {'pid': pid, 'ppid': proc['ppid'], 'exe': proc['exe'],
                                               'command': proc['command'], 'cpu_s': 0.0})
                item.update(ppid=proc['ppid'], exe=proc['exe'], command=proc['command'])
                item['cpu_s'] += delta
        if compilers is not None and (perf_guard_required(j['job']) or j['job'].get('quiet_machine')):
            n_frozen = len(j.get('quiet_pids', []))
            try:
                self.meter_tick(j)
                self.agent_freeze_tick(j)
            except Exception as e:     # measuring must never take the daemon down
                self.log(f'meter tick failed: {e!r}')
            finally:   # a SIGSTOP followed by an exception must still reach the spool
                if len(j.get('quiet_pids', [])) != n_frozen:
                    self.persist_quiet_pids(j)
        if job_uses_boot_test(j['job']) and not j.get('adopted'):
            try:
                self.work_tick(j)
            except Exception as e:
                self.log(f'work tick failed: {e!r}')
        cap = self.cap_now()[0]
        games = len(self.fg_jobs()) + bool(j.get('lane')) + len(self.outside)   # a stopped lane job runs no game
        j['samples'].append((la[0], ab, cp, games, cap, hot))
        # A job may rename or delete its own output folder; that must not take the daemon down.
        os.makedirs(j['job']['out'], exist_ok=True)
        with open(os.path.join(j['job']['out'], 'conditions.tsv'), 'a') as f:
            details = json.dumps(hot, separators=(',', ':')).replace('\t', ' ').replace('\n', ' ')
            f.write(f'{t - j["start"]:.0f}\t{la[0]}\t{la[1]}\t{ab}\t{cp}\t{cap}\t{games}\t{details}\n')

    def work_tick(self, j):
        """Per-second OS counters of the game process (CPU time, instructions, cycles, P/E split, per thread) for
        work-per-frame results. Works for every route job, solo or not."""
        w = j.setdefault('work', {'pid': None, 'samples': []})
        game = process_descendants(PROCESS_SNAPSHOT, j['proc'].pid)
        cands = [p for p in PROCESS_SNAPSHOT if p['pid'] in game and p['pid'] != j['proc'].pid and
                 not p['exe'].startswith(('MTLCompiler', 'sh', 'bash', 'zsh', 'python', 'Python', 'caffeinate', 'sleep'))]
        if not cands:
            return
        pid = max(cands, key=lambda p: p['cpu_s'])['pid']     # the game: the heaviest process of the job's tree
        if pid != w['pid']:
            w['pid'] = pid
            w['samples'] = []                                  # a different process: its counters are not comparable
        proc = proc_work_counters(pid)
        if proc is None:
            return
        w['samples'].append({'age_s': proc['age_s'], 'proc': proc, 'threads': thread_work_counters(pid)})

    def persist_quiet_pids(self, j):
        """Write the frozen-pid list to the job's spool files so a restarted daemon (or crash recovery) resumes them."""
        jid = j['job']['id']
        for suf, key in (('.json', 'quiet_build_pids'), ('.run.json', 'quiet_pids')):
            path = os.path.join(D['running'], jid + suf)
            d = rjson(path)
            if d is not None:
                d[key] = list(j.get('quiet_pids', []))
                wjson(path, d)

    def meter_tick(self, j):
        """One ~1 s sample of what everything outside the game used (host CPU ticks minus the game's process tree),
        plus slow gauges every 10 s; freezes heavy non-interactive outside work that starts during the run."""
        now = time.monotonic()
        m = j.get('meter')
        if m is None:
            m = j['meter'] = {'obj': ContentionMeter(float(self.c.get('quiet_outside_max_cores', QUIET_OUTSIDE_MAX_CORES))),
                              'ticks': host_cpu_ticks(), 't': now, 'prev': {}, 'gauges': [], 'gauge_t': 0.0,
                              'frozen': [], 'adopted': bool(j.get('adopted'))}
            exe_cpu_deltas(m['prev'], PROCESS_SNAPSHOT)
        cur = host_cpu_ticks()
        dt = now - m['t']
        busy = busy_cores(m['ticks'], cur, dt)
        m['ticks'], m['t'] = cur, now
        if now - m['gauge_t'] >= 10:
            m['gauge_t'] = now
            m['gauges'].append((now, read_gauges()))
        if busy is None or dt <= 0.2:
            return
        game = process_descendants(PROCESS_SNAPSHOT, j['proc'].pid)
        game_cpu = own = demoted = 0.0
        bgset = set(j.get('bg_pids') or [])
        names, deltas, live = {}, {}, set()
        for p in PROCESS_SNAPSHOT:
            pid = p['pid']
            live.add(pid)
            old = m['prev'].get(pid)
            m['prev'][pid] = p['cpu_s']
            if old is None or p['cpu_s'] <= old:
                continue
            d = p['cpu_s'] - old
            deltas[pid] = d
            if pid in game or p['exe'].startswith('MTLCompilerServ'):   # the game's own shader compiles
                game_cpu += d
            elif pid == os.getpid():
                own += d
            elif pid in bgset:   # background-QoS clamped: runs on efficiency cores; P-core share is judged by P_SHARE_MIN
                demoted += d
            else:
                names[p['exe']] = names.get(p['exe'], 0.0) + d
        for pid in set(m['prev']) - live:
            m['prev'].pop(pid, None)
        m['obj'].add(dt, max(0.0, busy - (game_cpu + own + demoted) / dt), game_cpu / dt, names)
        # heavy non-interactive outside work started during the run (codesign, pack, zip, rg ...): freeze until the end
        qp = j.setdefault('quiet_pids', [])
        for p in PROCESS_SNAPSHOT:
            pid = p['pid']
            if (pid in game or pid in qp or pid in self.protected_pids or pid == os.getpid() or process_is_stopped(p)
                    or deltas.get(pid, 0.0) < FREEZE_MIN_CPU_S or not is_freezable_heavy(p)):
                continue
            qp.append(pid)
            m['frozen'].append({'pid': pid, 'exe': p['exe'], 'command': p['command'][:120]})
            try:
                os.kill(pid, signal.SIGSTOP)
                self.log(f'froze {p["exe"]}[{pid}] during {j["job"]["id"]}: {p["command"][:100]}')
            except (ProcessLookupError, PermissionError):
                pass

    def agent_freeze_tick(self, j):
        """Keep the agent freeze current for a measured run: freeze new tool shells / scripts / builds every
        SOLO_FREEZE_RESCAN_S, and resume everything at the deadline (not refrozen)."""
        dl = j.get('agent_deadline')
        if not dl:
            return
        jid = j['job']['id']
        if time.time() > dl:
            if j.get('agent_frozen'):
                freeze_stall_log(jid, j['agent_frozen'])
                cont_pids(j['agent_frozen'])
                self.log(f'agent freeze for {jid} ended at its {SOLO_FREEZE_MAX_S} s limit: resumed {len(j["agent_frozen"])}')
                j['agent_frozen'] = []
                j['comp_only'] = True  # compilers stay frozen to the end of the run: they ruined a 12 min measured run
            if not j.get('comp_only'):
                return
        if time.monotonic() - j.get('agent_scan', 0.0) < SOLO_FREEZE_RESCAN_S:
            return
        j['agent_scan'] = time.monotonic()
        qp = j.setdefault('quiet_pids', [])
        game = process_descendants(PROCESS_SNAPSHOT, j['proc'].pid)
        new = [pid for pid in solo_freeze_targets(PROCESS_SNAPSHOT, self.protected_pids | {os.getpid()}, game,
                                                  j['job'].get('out', ''), _FREEZE_CPU_PREV)]
        if j.get('comp_only'):
            bp = {p['pid']: p for p in PROCESS_SNAPSHOT}
            new = [x for x in new if is_compiler_process(bp[x])]
        bg = j.setdefault('bg_pids', [])
        nbg = [p['pid'] for p in PROCESS_SNAPSHOT if DEMOTE_EXE.match(p['exe']) and p['pid'] not in bg
               and p['pid'] not in game and p['pid'] not in self.protected_pids]
        if nbg:
            set_background(nbg, True)
            bg.extend(nbg)
            self.log(f'background QoS for {len(nbg)} outside process(es) during {jid}')
        for pid in new:
            freeze_log(f'{jid} freeze {pid} {by_pid_cmd(pid)}')
            _FREEZE_T0[pid] = time.monotonic()
            qp.append(pid)
            j['agent_frozen'].append(pid)
            try:
                os.kill(pid, signal.SIGSTOP)
            except (ProcessLookupError, PermissionError):
                pass
        if new or nbg or len(qp) != j.get('agent_file_n') or j.get('comp_only'):
            # comp_only: rolling deadline so the watchdog outlives dl+grace while compilers stay frozen
            wd = time.time() + SOLO_WATCHDOG_GRACE_S if j.get('comp_only') else dl + SOLO_WATCHDOG_GRACE_S
            write_agent_freeze(jid, qp, j['proc'].pid, wd, bg)
            j['agent_file_n'] = len(qp)
            j['agent_new_total'] = j.get('agent_new_total', 0) + len(new)

    def kill_job(self, j, why):
        pid = j['proc'].pid
        if not j['killing']:
            j['killing'] = time.time()
            j['why'] = why
            self.log(f'stop {j["job"]["id"]} pgid {pid}: {why}')
            try:
                os.killpg(pid, signal.SIGTERM)   # the job's own process group (start_new_session), nothing else
            except ProcessLookupError:
                pass
        elif time.time() - j['killing'] > self.c['kill_grace_s']:
            try:
                os.killpg(pid, signal.SIGKILL)
            except ProcessLookupError:
                pass

    def finish_record(self, job, slot, code, status, start, samples, note='', load_start=None, games_start=None,
                      process_cpu_totals=None, compiler_activity=None, meter=None, work=None):
        out = job['out']
        res = {'id': job['id'], 'name': job.get('name'), 'status': status, 'exit': code, 'measured': is_measured(job),
               'submitted': job.get('submitted'), 'started': time.strftime('%Y-%m-%d %H:%M:%S',
                                                                           time.localtime(start)),
               'ended': now_s(), 'wall_s': round(time.time() - start, 1),
               'queued_s': max(0.0, round(start - job.get('submitted_t', start), 1)), 'slot': slot,
               'priority': job.get('priority', False), 'out': out, 'note': note,
               'conditions': {'load_start': load_start or loadavg()}}
        if samples:
            ls = [s[0] for s in samples]
            res['conditions'].update(load_mean=round(sum(ls) / len(ls), 1), load_max=max(ls),
                                     builds_mean=round(sum(s[1] for s in samples) / len(samples), 1),
                                     builds_max=max(s[1] for s in samples),
                                     compile_procs_mean=round(sum(s[2] for s in samples) / len(samples), 1),
                                     compile_procs_max=max(s[2] for s in samples),
                                     build_cap=max(s[4] if len(s) > 4 else self.c['game_cap'] for s in samples),
                                     build_cap_min=min(s[4] if len(s) > 4 else self.c['game_cap'] for s in samples))
            res['conditions']['compiler_processes_seen'] = sorted(
                (compiler_activity or {}).values(), key=lambda p: p.get('cpu_delta_s', 0), reverse=True)
            res['conditions']['meaningful_compiler_processes'] = meaningful_compiler_activity(
                compiler_activity or {})
            gs = [s[3] for s in samples if len(s) > 3]
            if gs:
                res['conditions'].update(games_mean=round(sum(gs) / len(gs), 2), games_max=max(gs))
        res['slots'] = self.c['slots']
        res['solo'] = is_solo(job)
        if job.get('quiet_machine'):
            res['quiet_machine'] = {'stopped_build_pids': job.get('quiet_build_pids', []),
                                    'load_limit': QUIET_LOAD_LIMIT, 'wait_cap_s': QUIET_WAIT_CAP_S,
                                    'fps_valid_threshold': None,   # 11-23: average FPS below 30 is a note, not a validity rule
                                    'fps_required': quiet_fps_required(job),
                                    'minimum_adapter_watts': int((job.get('env') or {}).get(
                                        'RUNQ_MIN_ADAPTER_W', QUIET_MIN_ADAPTER_W))}
            qlog = os.path.join(out, 'runq.log')
            res['quiet_machine']['runq_log_offset'] = job.get('runq_log_offset')
            gate, power_failure = parse_quiet_machine_log(
                read_job_log(qlog, job.get('runq_log_offset')))
            res['quiet_machine'].update(gate)
            if power_failure:
                status, code, note = 'invalid', 2, 'power preflight: ' + power_failure
                res.update(status=status, exit=code, note=note)
        if games_start is not None:
            res['conditions']['games_start'] = games_start
        g = max([x for x in (res['conditions'].get('games_max'), games_start) if x is not None], default=None)
        if g is not None:
            res['conditions']['full_speed'] = g <= 1
        run = job.get('run_dir') or out
        sj = rjson(os.path.join(run, 'summary.json'))
        if sj and sj.get('summary'):
            s = sj['summary']
            res['fps'] = {k: (round(s[k], 2) if isinstance(s.get(k), float) else s.get(k))
                          for k in ('fps_avg', 'fps_1pct_low', 'fps_01pct_low', 'ft_median', 'ft_p99', 'ft_worst',
                                    'frames') if k in s}
            if job.get('no_fps'):
                res['fps'].update(valid=None, required=False)
            if s.get('ft_worst'):
                res['fps']['fps_min'] = round(1000.0 / s['ft_worst'], 2)
            if quiet_fps_required(job):
                res['fps']['valid'] = res['fps'].get('fps_avg') is not None
                if res['fps']['valid'] and res['fps']['fps_avg'] < 30:
                    res['fps']['below_30'] = True    # note only: a slow build is a result, not an invalid run
                    note = (note + '; ' if note else '') + 'average fps below 30 (note only, not a validity rule)'
                    res.update(note=note)
                if res['fps']['valid'] and status == 'done':
                    h = perf_tsv_health(run)
                    if h:
                        res['fps']['bin_min'], res['fps']['bin_median'] = round(h[0], 2), round(h[1], 2)
                    if h and h[0] < COLLAPSE_RATIO * h[1]:
                        res['fps']['valid'] = False
                        status, code, note = 'invalid', 2, \
                            f'collapsed run: a 60 s bin fell to {h[0]:.1f} fps vs median {h[1]:.1f}; rerun'
                        res.update(status=status, exit=code, note=note)
                    elif (res['fps'].get('fps_avg') or 0) >= VSYNC_CAP_FPS:
                        res['fps']['capped'] = True    # flag, not invalid: some jobs want to show 60 is held
                        note = (note + '; ' if note else '') + 'fps at vsync cap: no speed signal'
                        res.update(note=note)
        elif job.get('quiet_machine'):
            res['fps'] = {'fps_avg': None, 'fps_min': None,
                          'valid': False if quiet_fps_required(job) else None}
            if not quiet_fps_required(job):
                res['fps']['required'] = False
        if not sj and quiet_missing_summary_invalid(job, status):
            status, code, note = 'invalid', 2, 'quiet-machine FPS summary missing'
            res.update(status=status, exit=code, note=note)
        if status == 'done' and perf_guard_required(job):
            meaningful = res['conditions'].get('meaningful_compiler_processes', [])
            if meaningful:
                names = ', '.join(f"{p['exe']}[{p['pid']}] {p.get('cpu_delta_s', 0)} CPU-s "
                                  f"cwd={p.get('cwd') or '?'} ppid={p.get('ppid')}" for p in meaningful[:8])
                status, code, note = 'invalid', 2, f'perf run overlapped {len(meaningful)} meaningful compiler process(es)' + \
                    (f': {names}' if names else '')
                res.update(status=status, exit=code, note=note)
        if work and work.get('samples'):
            try:
                with open(os.path.join(out, 'work.tsv'), 'w') as wf:     # raw per-second counters, for re-analysis
                    wf.write('age_s\tuser_ms\tsys_ms\tpuser_ms\tpsys_ms\tinstr\tcycles\tpinstr\tpcycles\n')
                    for sm in work['samples']:
                        pr = sm['proc']
                        wf.write('\t'.join(str(round(x, 3)) for x in (sm['age_s'], pr['user_ms'], pr['sys_ms'], pr['puser_ms'],
                                 pr['psys_ms'], pr['instr'], pr['cycles'], pr['pinstr'], pr['pcycles'])) + '\n')
                wpf = work_per_frame(work['samples'], read_perf_frames(run))
                if wpf:
                    res['work'] = wpf
            except Exception as e:
                res['work_error'] = repr(e) + ' ' + traceback.format_exc().strip().splitlines()[-2].strip()
        bench = read_bench(run)
        if bench:
            res['bench'] = bench
        gauges = None
        if meter:
            res['outside'] = meter['obj'].summary()
            res['outside']['frozen'] = meter.get('frozen', [])
            if meter.get('adopted'):
                res['outside']['partial'] = 'daemon restarted during the run: only the time after the restart is measured'
            gauges = summarize_gauges(meter['gauges'])
            res['machine'] = gauges
            hot_s = float(self.c.get('outside_hot_invalid_s', OUTSIDE_HOT_INVALID_S))
            if res['outside'].get('seconds') and res['outside']['mean_cores'] is not None:
                res['outside']['valid_for_speed'] = contention_invalid_reason(res['outside'], hot_s) is None
        if status == 'done' and perf_guard_required(job) and meter:
            pshare = (res.get('work') or {}).get('p_time_share')
            hot = contention_invalid_reason(res.get('outside'), float(self.c.get('outside_hot_invalid_s', OUTSIDE_HOT_INVALID_S)))
            pmin = float(self.c.get('p_share_min', P_SHARE_MIN))
            if pshare is not None:
                # What counts is what happened to the game, not who used the CPU: outside CPU alone (Paseo, node, bun,
                # mds_stores) is only a note while the game stayed on the performance cores.
                if pshare >= pmin:
                    if hot:
                        res['outside']['note'] = 'outside load high but game P-core share ' + str(pshare) + ' held: ' + hot
                    hot = None
                elif hot:
                    hot = f'game CPU time only {pshare:.2f} on performance cores (min {pmin}) - displaced by outside load: {hot}'
                else:
                    # quiet machine + low P share = the build itself runs on efficiency cores (a real regression): valid, loud note
                    res['outside']['note'] = f'game ran on efficiency cores on a quiet machine (P-core share {pshare:.2f}, min {pmin})'
                    res['p_share_low_quiet'] = pshare
            why = [r for r in (hot,
                               machine_state_invalid_reason(gauges),
                               frames_stopped_reason(run, res['wall_s'],
                                                     float(res.get('quiet_machine', {}).get('waited_s') or 0))) if r]
            faults = game_fault_count(run)
            if faults:
                res['game_faults'] = faults
            if why:
                status, code = 'invalid', 2
                note = '; '.join(why) + (f'; {faults} guest access violations in the game log' if faults else '')
                res.update(status=status, exit=code, note=note)
                if res.get('fps'):
                    res['fps']['valid'] = False
        caps = os.path.join(run, 'captures')
        if os.path.isdir(caps):
            res['captures'] = sorted(f for f in os.listdir(caps) if f.endswith('.png'))
        extra = rjson(os.path.join(out, 'scene_result.json'))
        if extra:
            res['scene'] = extra
        log = os.path.join(run, 'game.log')
        res['log'] = log if os.path.exists(log) else os.path.join(out, 'runq.log')
        load_high = res['conditions'].get('load_max', 0) >= QUIET_LOAD_LIMIT
        if perf_guard_required(job) and (status == 'invalid' or load_high):
            top = top_cpu_processes(process_cpu_totals or {})
            path = os.path.join(out, 'top-processes.json')
            wjson(path, {'sampled_cpu_seconds': True, 'threshold_note': 'top cumulative CPU deltas sampled during run',
                         'processes': top})
            res['conditions']['top_processes_file'] = path
        wjson(os.path.join(out, 'result.json'), res)
        line = (f'{job["id"]} {job.get("name") or ""} {status} exit {code} wall {res["wall_s"]} s '
                f'queued {res["queued_s"]} s load {res["conditions"]["load_start"][0]}'
                f'->{res["conditions"].get("load_mean", "?")} builds {res["conditions"].get("builds_mean", "?")}'
                f' games max {max(res["conditions"].get("games_max") or 0, games_start or 0)}/{res["slots"]}'
                + (' solo' if res['solo'] else '')
                + (f' build cap {res["conditions"]["build_cap"]}' if 'build_cap' in res['conditions'] else '')
                + (f' fps {res["fps"].get("fps_avg")}/{res["fps"].get("fps_1pct_low")}' if res.get('fps') else '')
                + (f' outside {res["outside"]["mean_cores"]} cores (peak {res["outside"]["max_window_cores"]}, '
                   f'hot {int(res["outside"]["hot_s"])} s)' if res.get('outside') and res['outside'].get('mean_cores') is not None else '')
                + (f' work {res["work"]["instr_m_per_frame"]} Minstr/frame {res["work"]["cpu_ms_per_frame"]} cpu-ms/frame '
                   f'P {res["work"]["p_time_share"]} gpu {res["work"].get("gpu_ms_per_frame")} ms/frame' if res.get('work') else '')
                + (f' bench {res["bench"]["work_m_per_frame"]} Mwork/frame (spin {res["bench"]["spin_m_per_frame"]}) '
                   f'gpu {res["bench"]["gpu_ms_per_frame"]} ms/frame stalls {res["bench"]["stall_frames"]}' if res.get('bench') else '')
                + (f' scene {extra.get("verdict")}' if extra else '') + (f' ({note})' if note else ''))
        with open(os.path.join(out, 'result.txt'), 'w') as f:
            f.write(line + '\n')
        wjson(os.path.join(D['done'], job['id'] + '.json'), res)
        self.log('done ' + line)
        return res

    def reap(self):
        t = time.time()
        for jid, j in list(self.jobs.items()):
            if t >= j['next_sample']:
                j['next_sample'] = t + 1
                self.sample(j, t)
            code = j['proc'].poll()
            to = j['job'].get('timeout_s') or 1800
            if code is None:
                if os.path.exists(os.path.join(D['running'], jid + '.cancel')):
                    self.kill_job(j, 'cancelled')
                elif t - j['start'] - j.get('paused_s', 0.0) - (t - j['lane_t'] if j.get('lane_pids') else 0.0) > to:
                    self.kill_job(j, f'timeout {to} s')
                continue
            status = {'cancelled': 'cancelled'}.get(j.get('why', ''), 'timeout' if j.get('why') else 'done')
            if code < 0:
                code = 128 - code
            if code == UNKNOWN_EXIT and j.get('adopted'):
                j['why'] = j.get('why') or 'adopted after a daemon restart; exit code unknown (see runq.log)'
            # stragglers in the job's own group (a game the job left running)
            try:
                os.killpg(j['proc'].pid, signal.SIGKILL)
            except (ProcessLookupError, PermissionError):
                pass
            try:
                self.finish_record(j['job'], j['slot'], code, status, j['start'], j['samples'], j.get('why', ''),
                                   j['load_start'], j.get('games_start'), j.get('process_cpu_totals'),
                                   j.get('compiler_activity'), j.get('meter'), j.get('work'))
            finally:
                freeze_stall_log(jid, j.get('agent_frozen', []))
                self.resume_builds(j.get('quiet_pids', []))
                try:
                    os.unlink(agent_freeze_file(jid))
                except OSError:
                    pass
            if j['job'].get('clone_app', True) and j['job'].get('app'):
                shutil.rmtree(os.path.join(j['job']['out'], 'app'), ignore_errors=True)  # our own clone
            for suf in ('.json', '.run.json', '.cancel', '.lanestop'):
                try:
                    os.unlink(os.path.join(D['running'], jid + suf))
                except OSError:
                    pass
            del self.jobs[jid]
            self.perf_batch.discard(jid)
            if is_solo(j['job']) or j['job'].get('quiet_machine'):
                builds_waiting = active_builds()
                wait_s = oldest_build_wait_s()
                if should_open_build_window(builds_waiting, wait_s) and self.phase['phase'] != 'solo':
                    self.build_interleave_until = max(self.build_interleave_until,
                                                      time.time() + BUILD_INTERLEAVE_WINDOW_S)
                    self.log(f'build window opened after {jid}: {builds_waiting} buildq job(s), '
                             'oldest waited ' + f'{int(wait_s)}s; up to {BUILD_INTERLEAVE_WINDOW_S}s')

    def build_interleave_active(self):
        if not self.build_interleave_until:
            return False
        builds_waiting = active_builds()
        if not builds_waiting:
            self.log('build interleave ended: no waiting buildq jobs')
            self.build_interleave_until = 0.0
            return False
        remaining = self.build_interleave_until - time.time()
        if remaining <= 0:
            self.log(f'build interleave ended: {builds_waiting} buildq job(s) remain after '
                     f'{BUILD_INTERLEAVE_WINDOW_S}s')
            self.build_interleave_until = 0.0
            return False
        return True

