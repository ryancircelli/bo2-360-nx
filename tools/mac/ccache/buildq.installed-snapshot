# tree, another game, or busy: CPU delta >= FREEZE_BUSY_CPU_S over the last scan (first sight: lifetime average).
FREEZE_BUSY_CPU_S = 0.3            # CPU-seconds per SOLO_FREEZE_RESCAN_S scan (~15% of one core)
FREEZE_GAME = re.compile(r'\.app/Contents/MacOS/')
# replay/ref emulator tools are short CPU bursts (invalidated gate-speed-B1 08:12): freeze on sight, no CPU wait, wherever they live
FREEZE_REPLAY = re.compile(r'(^|/)(rexgpu-replay|refxenos)( |$)')
