def perf_build_gate():
    """Wait for external compiler/ninja work before perf; active work during a run is caught by samples."""
    start = time.monotonic()
    initial = compiler_processes()  # baseline so token-waiting ninja does not block perf
    if initial is not None:
        _COMPILER_CPU_LAST.update({p['pid']: p['cpu_s'] for p in initial})
    time.sleep(0.12)
    active = compile_procs()
    while active != 0:
        remaining = QUIET_WAIT_CAP_S - (time.monotonic() - start)
        if remaining <= 0:
            print(f'perf-build gate failed: compiler_ninja={active} wait_cap_s={QUIET_WAIT_CAP_S} '
                  f'processes={json.dumps(compiler_processes() or [])}', flush=True)
            return False
        time.sleep(min(2, remaining))
        active = compile_procs()
    waited = round(time.monotonic() - start, 1)
    print(f'perf-build gate: waited_s={waited} compiler_ninja={active}', flush=True)
    return True


def process_tree(pid):
    """Return a live PID and its descendants (buildq records can predate child_pid support)."""
    try:
        out = subprocess.run(['ps', '-axo', 'pid=,ppid='], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return [pid] if alive(pid) else []
    children = {}
    for line in out.splitlines():
        try:
            child, parent = map(int, line.split())
            children.setdefault(parent, []).append(child)
        except ValueError:
            continue
    result, todo = [], [pid]
    while todo:
        parent = todo.pop()
        if parent not in result and alive(parent):
            result.append(parent)
            todo.extend(children.get(parent, []))
    return result


def process_ancestors(pid=None):
    """Return a PID and its live ancestors; quiet-mode build suspension must never stop them."""
    pid = os.getpid() if pid is None else int(pid)
    try:
        rows = subprocess.run(['ps', '-axo', 'pid=,ppid='], capture_output=True, text=True,
                              timeout=10, check=True).stdout.splitlines()
    except (OSError, subprocess.SubprocessError):
        return {pid}
    parents = {}
    for row in rows:
        try:
            child, parent = map(int, row.split())
            parents[child] = parent
        except ValueError:
            continue
    protected, current = set(), pid
    while current > 1 and current not in protected:
        protected.add(current)
        current = parents.get(current, 1)
    if current == 1:
        protected.add(1)
    return protected


def games_outside(own_pgids):
