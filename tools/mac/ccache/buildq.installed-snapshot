def freeze_watchdog(path, daemon_pid):
    """Resume every pid in the state file when the deadline passes, the job ends, the file disappears, or the daemon
    is gone (state.json stale 20 s: a `runq restart` hands over within that). Always resumes before it exits."""
    while True:
        st = rjson(path)
        if not st:
            return
        try:
            stale = time.time() - os.stat(os.path.join(SPOOL, 'state.json')).st_mtime > 20
        except OSError:
            stale = True
        if (time.time() > st.get('deadline', 0) or (st.get('job_pid') and not alive(st['job_pid'])) or
                (not alive(daemon_pid) and stale)):
            cont_pids(st.get('pids', []))
            set_background(st.get('bg', []), False)
            try:
                os.unlink(path)
            except OSError:
                pass
            return
        time.sleep(2)


def host_cpu_ticks():
    """Cumulative (user, system, idle, nice) CPU ticks of the whole machine, 100 per second per core; None if unreadable."""
    try:
        import ctypes, ctypes.util

        class _Info(ctypes.Structure):
            _fields_ = [('t', ctypes.c_uint32 * 4)]
        libc = ctypes.CDLL(ctypes.util.find_library('c'))
        libc.mach_host_self.restype = ctypes.c_uint32
        n, info = ctypes.c_uint32(4), _Info()
        if libc.host_statistics(libc.mach_host_self(), 3, ctypes.byref(info), ctypes.byref(n)) != 0:
            return None
        return list(info.t)
    except Exception:
        return None


def busy_cores(prev, cur, dt):
    """Average busy cores (user+system+nice) between two host_cpu_ticks() readings dt seconds apart."""
    if not prev or not cur or dt <= 0:
        return None
    d = [b - a for a, b in zip(prev, cur)]
    return max(0.0, (d[0] + d[1] + d[3]) / 100.0 / dt)


def process_descendants(processes, root):
    """root plus every descendant in a process snapshot (list of dicts with pid/ppid)."""
    kids = {}
    for p in processes:
        kids.setdefault(p['ppid'], []).append(p['pid'])
    seen, todo = {root}, [root]
    while todo:
        for c in kids.get(todo.pop(), []):
            if c not in seen:
                seen.add(c)
                todo.append(c)
    return seen


def exe_cpu_deltas(prev, processes, exclude=()):
    """{exe: CPU-seconds used since the previous snapshot} for processes outside `exclude` (pid set); `prev` ({pid: cpu_s})
    is updated in place. Processes that started and ended between snapshots are not seen (the host tick total is)."""
    out, live = {}, set()
    for p in processes:
        pid = p['pid']
        live.add(pid)
        old = prev.get(pid)
        prev[pid] = p['cpu_s']
        if old is not None and pid not in exclude and p['cpu_s'] > old:
            out[p['exe']] = out.get(p['exe'], 0.0) + (p['cpu_s'] - old)
    for pid in set(prev) - live:
        prev.pop(pid, None)
    return out


def quiet_gate(max_cores, calm_s, cap_s, sleep=time.sleep, ticks=host_cpu_ticks, mono=time.monotonic,
               procs=None):
    """Block until outside CPU (all cores busy, nothing of ours running yet) stayed <= max_cores for calm_s seconds in
    a row, or cap_s passed. Instant host CPU ticks, 1 s resolution, not the lagging 1-minute load average.
    Returns {waited_s, outside_cores (last), calm_s, capped, top}."""
    start = last = mono()
    prev_t = ticks()
    calm = 0.0
    cores, capped, prev_p, top = None, False, {}, {}
    procs = procs or (lambda: (compiler_processes(), PROCESS_SNAPSHOT)[1])
    exe_cpu_deltas(prev_p, procs() or [], exclude={os.getpid()})
    n = 0
    while True:
        sleep(1.0)
        now = mono()
        cur = ticks()
        cores = busy_cores(prev_t, cur, now - last) if prev_t else None
        if cores is None:
            cores = loadavg()[0]            # no host statistics: the old load-average rule, same unit
        prev_t, last = cur, now
        n += 1
        if n % 3 == 0:
            top = exe_cpu_deltas(prev_p, procs() or [], exclude={os.getpid()})
        calm = calm + 1.0 if cores <= max_cores else 0.0
        if calm >= calm_s:
            break
        if now - start >= cap_s:
            capped = True
            break
    return {'waited_s': round(mono() - start, 1), 'outside_cores': round(cores, 2), 'calm_s': round(calm, 1),
            'capped': capped, 'top': sorted(top.items(), key=lambda kv: -kv[1])[:3]}


# ---------------------------------------------------------------- work per frame (runq-quiet-measure, owner idea 11-23)
# A starved run draws fewer frames but each frame costs the same instructions and GPU time; judging speed by work per
# presented frame lets speed checks run several at once. External: counters come from the OS for the game's pid.
MACH_NUM, MACH_DEN = 125, 3          # mach ticks -> ns on Apple silicon (checked with mach_timebase_info at start)
WORK_SKIP_S = 60.0                   # same warm-up skip as abverdict


def _rusage_struct():
    import ctypes
    names = ['ri_user_time', 'ri_system_time', 'ri_pkg_idle_wkups', 'ri_interrupt_wkups', 'ri_pageins', 'ri_wired_size',
             'ri_resident_size', 'ri_phys_footprint', 'ri_proc_start_abstime', 'ri_proc_exit_abstime',
             'ri_child_user_time', 'ri_child_system_time', 'ri_child_pkg_idle_wkups', 'ri_child_interrupt_wkups',
             'ri_child_pageins', 'ri_child_elapsed_abstime', 'ri_diskio_bytesread', 'ri_diskio_byteswritten',
             'q0', 'q1', 'q2', 'q3', 'q4', 'q5', 'q6', 'ri_billed_system_time', 'ri_serviced_system_time',
             'ri_logical_writes', 'ri_lifetime_max_phys_footprint', 'ri_instructions', 'ri_cycles', 'ri_billed_energy',
             'ri_serviced_energy', 'ri_interval_max_phys_footprint', 'ri_runnable_time', 'ri_flags', 'ri_user_ptime',
             'ri_system_ptime', 'ri_pinstructions', 'ri_pcycles', 'ri_energy_nj', 'ri_penergy_nj',
             'ri_secure_time_in_system', 'ri_secure_ptime_in_system', 'ri_neural_footprint',
             'ri_lifetime_max_neural_footprint', 'ri_interval_max_neural_footprint'] + ['r%d' % i for i in range(9)]

    class R(ctypes.Structure):
        _fields_ = [('uuid', ctypes.c_uint8 * 16)] + [(n, ctypes.c_uint64) for n in names]
    return R


_LIBC = None


def _libc():
    global _LIBC
    if _LIBC is None:
        import ctypes, ctypes.util
        _LIBC = ctypes.CDLL(ctypes.util.find_library('c'), use_errno=True)
        _LIBC.mach_absolute_time.restype = ctypes.c_uint64
    return _LIBC


def mach_now_s():
    return _libc().mach_absolute_time() * MACH_NUM / MACH_DEN / 1e9


def proc_work_counters(pid):
    """Whole-process CPU counters (RUSAGE_INFO_V6): times in mach ticks, instructions/cycles, P-core shares. None if
    the process is gone or unreadable. `age_s` = seconds since the process started (game clock origin)."""
    try:
        import ctypes
        R = _rusage_struct()
        r = R()
        if _libc().proc_pid_rusage(int(pid), 6, ctypes.byref(r)) != 0:
            return None
        ns = MACH_NUM / MACH_DEN
        return {'age_s': mach_now_s() - r.ri_proc_start_abstime * ns / 1e9,
                'user_ms': r.ri_user_time * ns / 1e6, 'sys_ms': r.ri_system_time * ns / 1e6,
                'puser_ms': r.ri_user_ptime * ns / 1e6, 'psys_ms': r.ri_system_ptime * ns / 1e6,
                'instr': r.ri_instructions, 'cycles': r.ri_cycles,
                'pinstr': r.ri_pinstructions, 'pcycles': r.ri_pcycles, 'runnable_ms': r.ri_runnable_time * ns / 1e6}
    except Exception:
        return None


def thread_work_counters(pid):
    """{tid: {'name', 'v': (instr_P, cycles_P, cpu_ms_P, instr_E, cycles_E, cpu_ms_E)}} for every live thread
    (PROC_PIDTHREADCOUNTS: one block per core type, level 0 = performance cores)."""
    out = {}
    try:
        import ctypes
        libc = _libc()
        ids = (ctypes.c_uint64 * 512)()
        n = libc.proc_pidinfo(int(pid), 28, 0, ids, ctypes.sizeof(ids))     # PROC_PIDLISTTHREADIDS
        ns = MACH_NUM / MACH_DEN

        class TI(ctypes.Structure):
            _fields_ = [('user', ctypes.c_uint64), ('sys', ctypes.c_uint64), ('cpu', ctypes.c_int32),
                        ('policy', ctypes.c_int32), ('run', ctypes.c_int32), ('flags', ctypes.c_int32),
                        ('sleep', ctypes.c_int32), ('curpri', ctypes.c_int32), ('pri', ctypes.c_int32),
                        ('maxpri', ctypes.c_int32), ('name', ctypes.c_char * 64)]
        for i in range(max(0, n) // 8):
            tid = ids[i]
            buf = (ctypes.c_uint64 * 32)()
            if libc.proc_pidinfo(int(pid), 34, tid, buf, ctypes.sizeof(buf)) < 56:       # PROC_PIDTHREADCOUNTS
                continue
            levels = buf[0] & 0xffff
            v = []
            for lv in range(min(levels, 2)):
                b = 1 + lv * 5
                v += [buf[b], buf[b + 1], (buf[b + 2] + buf[b + 3]) * ns / 1e6]
            v += [0] * (6 - len(v))
            ti = TI()
            name = ''
            if libc.proc_pidinfo(int(pid), 15, tid, ctypes.byref(ti), ctypes.sizeof(ti)) > 0:   # PROC_PIDTHREADID64INFO
                name = ti.name.decode(errors='replace')
            out[tid] = {'name': name, 'v': tuple(v)}
    except Exception:
        return out
    return out


def read_bench(run_dir):
    """The deterministic bench's result (SDK bench_frames): the last '[bench] json' line of the game log, per frame.
    work = instructions minus spin (yields, sleeps, waits, critical-section spin), the figure that compares builds."""
    try:
        line = None
        with open(os.path.join(run_dir, 'game.log'), errors='replace') as f:
            for l in f:
                if '[bench] json ' in l:
                    line = l
        if not line:
            return None
        j = json.loads(line.split('[bench] json ', 1)[1])
        n = j['frames']
        spin = j.get('spin_instr', 0)
        th = sorted(j.get('threads', []), key=lambda t: -(t['instr'] - t.get('spin_instr', 0)))
        return {'frames': n, 'fps': j['fps'], 'stall_frames': j.get('stall_frames'), 'frame_lock_hz': j.get('frame_lock_hz'),
                'instr_m_per_frame': round(j['instr'] / n / 1e6, 3), 'spin_m_per_frame': round(spin / n / 1e6, 3),
                'work_m_per_frame': round((j['instr'] - spin) / n / 1e6, 3),
                'cpu_ms_per_frame': round(j['cpu_ms'] / n, 3), 'gpu_ms_per_frame': round(j['gpu_ms'] / n, 4),
                'threads': [{'name': t['name'], 'work_m': round((t['instr'] - t.get('spin_instr', 0)) / n / 1e6, 3),
                             'spin_m': round(t.get('spin_instr', 0) / n / 1e6, 3)} for t in th[:16]]}
    except (OSError, ValueError, KeyError, ZeroDivisionError):
        return None


def read_perf_frames(run_dir):
    """perf.tsv -> list of dicts {t, frame_ms, cpu_ms, gpu_ms, wait_ms, enc_ms, draws} for presented frames."""
    rows = []
    try:
        with open(os.path.join(run_dir, 'perf.tsv')) as f:
            for line in f:
                if line[:1] in ('#', 'f'):
                    continue
                a = line.rstrip('\n').split('\t')
                try:
                    if int(a[7]) <= 0:
                        continue
                    num = lambda x: None if x == '-' else float(x)
                    rows.append({'t': float(a[1]) / 1e3, 'frame_ms': num(a[2]), 'cpu_ms': num(a[3]), 'gpu_ms': num(a[4]),
                                 'wait_ms': num(a[5]), 'enc_ms': num(a[8]) if len(a) > 8 else None, 'draws': int(a[7])})
                except (IndexError, ValueError):
                    pass
    except OSError:
        return []
    return rows


def _pct(vals, q):
    vals = sorted(v for v in vals if v is not None)
    return vals[min(len(vals) - 1, int(q * len(vals)))] if vals else None


def work_per_frame(samples, frames, skip_s=WORK_SKIP_S, bin_s=60.0):
    """samples = [{'age_s', 'proc': proc_work_counters, 'threads': thread_work_counters}] (1 s apart, game clock);
    frames = read_perf_frames(). Per presented frame between the first sample after warm-up and the last sample:
    CPU time, instructions, cycles, P-core share, per key thread, GPU time, plus 60 s-bin spread. None if too little."""
    if len(samples) < 5 or len(frames) < 200:
        return None
    t0 = frames[0]['t'] + skip_s
    win = [s for s in samples if s['age_s'] >= t0]
    if len(win) < 2:
        return None
    a, b = win[0], win[-1]
    fr = [f for f in frames if a['age_s'] <= f['t'] <= b['age_s']]
    n = len(fr)
    if n < 100:
        return None

    def delta(x, y):
        return {k: y['proc'][k] - x['proc'][k] for k in ('user_ms', 'sys_ms', 'puser_ms', 'psys_ms', 'instr', 'cycles',
                                                          'pinstr', 'pcycles', 'runnable_ms')}
    d = delta(a, b)
    cpu = d['user_ms'] + d['sys_ms']
    res = {'frames': n, 'window_s': round(b['age_s'] - a['age_s'], 1), 'fps': round(n / (b['age_s'] - a['age_s']), 2),
           'cpu_ms_per_frame': round(cpu / n, 3), 'instr_m_per_frame': round(d['instr'] / n / 1e6, 3),
           'cycles_m_per_frame': round(d['cycles'] / n / 1e6, 3),
           'p_time_share': round((d['puser_ms'] + d['psys_ms']) / cpu, 3) if cpu else None,
           'p_instr_share': round(d['pinstr'] / d['instr'], 3) if d['instr'] else None,
           'p_cycles_share': round(d['pcycles'] / d['cycles'], 3) if d['cycles'] else None,
           'ipc': round(d['instr'] / d['cycles'], 2) if d['cycles'] else None,
           'runnable_ms_per_frame': round(d['runnable_ms'] / n, 3)}
    g = [f['gpu_ms'] for f in fr if f['gpu_ms'] is not None]
    if g:
        res.update(gpu_ms_per_frame=round(sum(g) / len(g), 3), gpu_ms_median=round(_pct(g, 0.5), 3),
                   gpu_ms_p99=round(_pct(g, 0.99), 3))
    for key, name in (('cpu_ms', 'render_cpu_ms'), ('wait_ms', 'present_wait_ms'), ('enc_ms', 'enc_wait_ms'),
                      ('frame_ms', 'frame_ms_mean')):
        v = [f[key] for f in fr if f[key] is not None]
        if v:
            res[name] = round(sum(v) / len(v), 3)
    # per thread (name, else tid): the same window, summed over core types
    ta, tb = a['threads'], b['threads']
    last = {}
    for s in win:
        last.update(s['threads'])
    th = []
    for tid, last_v in last.items():
        v1 = (tb.get(tid) or last_v)['v']
        v0 = (ta.get(tid) or {'v': (0,) * 6})['v']
        instr = (v1[0] + v1[3]) - (v0[0] + v0[3])
        ms = (v1[2] + v1[5]) - (v0[2] + v0[5])
        pms = v1[2] - v0[2]
        if ms > 0:
            th.append({'thread': last_v['name'] or str(tid), 'tid': tid, 'cpu_ms_per_frame': round(ms / n, 3),
                       'instr_m_per_frame': round(instr / n / 1e6, 3), 'p_share': round(pms / ms, 2)})
    th.sort(key=lambda x: -x['cpu_ms_per_frame'])
    res['threads'] = th[:8]
    # 60 s bins inside the window: instructions/frame spread within one run
    bins, k = [], 0
    while a['age_s'] + (k + 1) * bin_s <= b['age_s']:
        lo, hi = a['age_s'] + k * bin_s, a['age_s'] + (k + 1) * bin_s
        sa = min(win, key=lambda s: abs(s['age_s'] - lo))
        sb = min(win, key=lambda s: abs(s['age_s'] - hi))
        nf = sum(1 for f in fr if sa['age_s'] <= f['t'] <= sb['age_s'])
        if nf > 50:
            bins.append((sb['proc']['instr'] - sa['proc']['instr']) / nf / 1e6)
        k += 1
    if len(bins) >= 2:
        mean = sum(bins) / len(bins)
        res['instr_bin_cv'] = round((sum((x - mean) ** 2 for x in bins) / (len(bins) - 1)) ** 0.5 / mean, 4)
    return res


def is_freezable_heavy(proc):
    """Heavy non-interactive outside work we may SIGSTOP during a speed run (never apps, WindowServer, agents, runq)."""
    return bool(FREEZE_HEAVY.match(proc.get('exe', '')) or
                (re.match(r'^(python|Python|python3|bash|sh|zsh)', proc.get('exe', '')) and
                 FREEZE_HEAVY_COMMAND.search(proc.get('command', ''))))


class ContentionMeter:
    """Integrates the outside CPU of one speed run: cores per OUTSIDE_WINDOW_S window, who used it, CPU-seconds."""

    def __init__(self, max_cores=QUIET_OUTSIDE_MAX_CORES, window_s=OUTSIDE_WINDOW_S):
        self.max_cores, self.window_s = max_cores, window_s
        self.t = self.cpu_s = self.game_cpu_s = 0.0
        self.names = {}
        self.windows = []                 # (t_start, mean_cores, top_names)
        self._wt = self._wcpu = 0.0
        self._wnames = {}

    def add(self, dt, outside_cores, game_cores, names):
        """One sample: dt seconds, outside/game cores over that span, names = {exe: cpu_s used in the span}."""
        if dt <= 0 or outside_cores is None:
            return
        cpu = outside_cores * dt
        self.t += dt
        self.cpu_s += cpu
        self.game_cpu_s += (game_cores or 0.0) * dt
        for k, v in names.items():
            self.names[k] = self.names.get(k, 0.0) + v
            self._wnames[k] = self._wnames.get(k, 0.0) + v
        self._wt += dt
        self._wcpu += cpu
        if self._wt >= self.window_s:
            top = sorted(self._wnames.items(), key=lambda kv: -kv[1])[:3]
            self.windows.append((round(self.t - self._wt, 1), self._wcpu / self._wt, top))
            self._wt = self._wcpu = 0.0
            self._wnames = {}

    def summary(self):
        wins = self.windows
        hot = [w for w in wins if w[1] > self.max_cores]
        hot_names = {}
        for w in hot:
            for k, v in w[2]:
                hot_names[k] = hot_names.get(k, 0.0) + v
        return {'seconds': round(self.t, 1), 'outside_cpu_s': round(self.cpu_s, 1), 'game_cpu_s': round(self.game_cpu_s, 1),
                'mean_cores': round(self.cpu_s / self.t, 2) if self.t else None,
                'window_s': self.window_s, 'windows': len(wins),
                'max_window_cores': round(max((w[1] for w in wins), default=0.0), 2),
                'threshold_cores': self.max_cores, 'hot_windows': len(hot), 'hot_s': len(hot) * self.window_s,
                'hot_offenders': [{'name': k, 'cpu_s': round(v, 1)} for k, v in
                                  sorted(hot_names.items(), key=lambda kv: -kv[1])[:5]],
                'top_processes': [{'name': k, 'cpu_s': round(v, 1)} for k, v in
                                  sorted(self.names.items(), key=lambda kv: -kv[1])[:8]]}


def contention_invalid_reason(outside, hot_invalid_s=OUTSIDE_HOT_INVALID_S):
    """Why a run is not trustworthy because of what else used the machine, or None."""
    if not outside or not outside.get('seconds'):
        return None
    if outside.get('hot_s', 0) >= hot_invalid_s:
        who = ', '.join(f"{p['name']} {p['cpu_s']} CPU-s" for p in outside.get('hot_offenders', [])[:3]) or 'unattributed'
        return (f"outside CPU over {outside['threshold_cores']} cores for {int(outside['hot_s'])} s of the run "
                f"(peak 10 s window {outside['max_window_cores']} cores, run mean {outside['mean_cores']}): {who}")
    return None


def parse_therm(text, ncpu=None):
    """pmset -g therm -> {'limited': bool, 'detail': str}. Limited = a CPU speed/scheduler limit below 100 or fewer
    CPUs available than the machine has; the 'No ... recorded' notes mean nothing was throttled."""
    detail = []
    for key in ('CPU_Speed_Limit', 'CPU_Scheduler_Limit'):
        m = re.search(key + r'\s*=\s*(\d+)', text)
        if m and int(m.group(1)) < 100:
            detail.append(f'{key}={m.group(1)}')
    m = re.search(r'CPU_Available_CPUs\s*=\s*(\d+)', text)
    if m and ncpu and int(m.group(1)) < ncpu:
        detail.append(f'CPU_Available_CPUs={m.group(1)}/{ncpu}')
    for m in re.finditer(r'(Thermal|Performance) warning level\s*=\s*(\d+)', text):
        if int(m.group(2)) > 0:
            detail.append(f'{m.group(1).lower()}_warning={m.group(2)}')
    return {'limited': bool(detail), 'detail': ', '.join(detail)}


def read_gauges():
    """One snapshot of slow-moving machine state: thermal, memory pressure, swap, paging, GPU utilisation."""
    def sh(cmd, timeout=5):
        try:
            return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout
        except (OSError, subprocess.SubprocessError):
            return ''
    g = {}
    try:
        ncpu = int(sh(['/usr/sbin/sysctl', '-n', 'hw.ncpu']).strip() or 0)
    except ValueError:
        ncpu = 0
    g.update({'thermal_' + k: v for k, v in parse_therm(sh(['/usr/bin/pmset', '-g', 'therm']), ncpu).items()})
    try:
        g['pressure'] = int(sh(['/usr/sbin/sysctl', '-n', 'kern.memorystatus_vm_pressure_level']).strip())
    except ValueError:
        g['pressure'] = None
    m = re.search(r'used = ([\d.]+)M', sh(['/usr/sbin/sysctl', 'vm.swapusage']))
    g['swap_used_mb'] = float(m.group(1)) if m else None
    vm = sh(['/usr/bin/vm_stat'])
    for key, name in (('Swapins', 'swapins'), ('Swapouts', 'swapouts'), ('Pageouts', 'pageouts'),
                      ('Pageins', 'pageins')):
        m = re.search(key + r':\s+(\d+)', vm)
        g[name] = int(m.group(1)) if m else None
    m = re.search(r'"Device Utilization %"=(\d+)', sh(['/usr/sbin/ioreg', '-r', '-d', '1', '-w0', '-c', 'AGXAccelerator']))
    g['gpu'] = int(m.group(1)) if m else None
    return g


def summarize_gauges(series):
    """series = [(t, gauges)] over one run -> worst thermal, max pressure, swap and paging deltas, GPU mean/max."""
    if not series:
        return None
    gs = [g for _, g in series]

    def vals(k):
        return [g[k] for g in gs if g.get(k) is not None]
    out = {'samples': len(gs), 'thermal_limited': any(g.get('thermal_limited') for g in gs),
           'thermal_detail': next((g['thermal_detail'] for g in gs if g.get('thermal_limited')), ''),
           'pressure_max': max(vals('pressure'), default=None),
           'swap_used_mb_start': (vals('swap_used_mb') or [None])[0], 'swap_used_mb_end': (vals('swap_used_mb') or [None])[-1]}
    for k in ('swapins', 'swapouts', 'pageouts', 'pageins'):
        v = vals(k)
        out[k + '_delta'] = (v[-1] - v[0]) if len(v) > 1 else None
    gpu = vals('gpu')
    if gpu:
        out['gpu_util_mean'], out['gpu_util_max'] = round(sum(gpu) / len(gpu), 1), max(gpu)
    return out


def machine_state_invalid_reason(gauges):
    """Thermal throttling or memory pressure above normal during the run, or None."""
    if not gauges:
        return None
    if gauges.get('thermal_limited'):
        return 'thermal throttling during the run: ' + (gauges.get('thermal_detail') or 'limited')
    if (gauges.get('pressure_max') or 1) >= 2:
        return f"memory pressure level {gauges['pressure_max']} during the run (swap {gauges.get('swap_used_mb_end')} MB)"
    return None


def frames_stopped_reason(run_dir, wall_s, gate_waited_s=0.0, slack_s=30.0):
    """perf.tsv frame clock (ms since the game started) ends long before the run did: the game hung or died while
    runq still waited for the route (ct2-A5: 114 s of frames in a 392 s run). Returns a reason or None."""
    last = None
    try:
        with open(os.path.join(run_dir, 'perf.tsv')) as f:
            for line in f:
                if line[:1] in ('#', 'f'):
                    continue
                a = line.split('\t')
                try:
                    if int(a[7]) > 0:
                        last = float(a[1])
                except (IndexError, ValueError):
                    pass
    except OSError:
        return None
    if last is None:
        return None
    gap = (wall_s - gate_waited_s) - last / 1000.0
    if gap > slack_s:
        return (f'game stopped drawing: frames end {last / 1000.0:.0f} s after launch but the run lasted '
                f'{wall_s - gate_waited_s:.0f} s ({gap:.0f} s without frames)')
    return None


def game_fault_count(run_dir):
    n = 0
    try:
        logs = os.path.join(run_dir, 'logs')
        for name in os.listdir(logs):
            if name.endswith('.log'):
                with open(os.path.join(logs, name), errors='replace') as f:
                    n += sum(1 for line in f if 'Unhandled guest access violation' in line)
    except OSError:
        pass
    return n


def power_source():
    """Return the current AC adapter and battery state for measured quiet-machine runs."""
    try:
        p = subprocess.run(['/usr/sbin/system_profiler', '-json', 'SPPowerDataType'],
                           capture_output=True, text=True, timeout=12, check=True)
        sections = json.loads(p.stdout).get('SPPowerDataType', [])
        byname = {s.get('_name'): s for s in sections if isinstance(s, dict)}
        charger = byname.get('sppower_ac_charger_information', {})
        battery = byname.get('spbattery_information', {}).get('sppower_battery_charge_info', {})
        power = byname.get('sppower_information', {}).get('AC Power', {})
        watts = int(charger.get('sppower_ac_charger_watts', 0))
        if watts <= 0:
            # system_profiler sometimes omits the wattage on a connected adapter (seen 2026-11-12 22:21: a valid
            # 94 W run was marked invalid as 0 W). pmset reads the same adapter directly.
            try:
                q = subprocess.run(['/usr/bin/pmset', '-g', 'ac'], capture_output=True, text=True, timeout=5)
                m = re.search(r'Wattage\s*=\s*(\d+)\s*W', q.stdout)
                if m:
                    watts = int(m.group(1))
            except (OSError, subprocess.SubprocessError):
                pass
        return {
            'connected': charger.get('sppower_battery_charger_connected') == 'TRUE',
            'ac': power.get('Current Power Source') == 'TRUE',
            'watts': watts,
            'charge': int(battery.get('sppower_battery_state_of_charge', 0)),
            'charging': charger.get('sppower_battery_is_charging') == 'TRUE',
        }
    except (OSError, subprocess.SubprocessError, ValueError, TypeError, KeyError) as e:
        raise RuntimeError(f'cannot read power source: {e}') from e


def adapter_hold_reason(job, power):
    """Return why a quiet/perf job must wait for power, or None when its gate is met."""
    if not (job.get('quiet_machine') or job_class(job) == 4):
        return None
    minimum = int((job.get('env') or {}).get('RUNQ_MIN_ADAPTER_W', QUIET_MIN_ADAPTER_W))
    if not power or power.get('error'):
        return 'held: power telemetry unavailable'
    if not power.get('connected') or not power.get('ac'):
        return 'held: no charger'
    watts = int(power.get('watts', 0))
    if watts < minimum:
        return f'held: adapter {watts} W below {minimum} W'
    return None


