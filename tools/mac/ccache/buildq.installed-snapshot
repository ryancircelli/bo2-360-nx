_FREEZE_T0 = {}                    # pid -> monotonic time we froze it (stall accounting)


def freeze_busy(p, by, prev):
    """True when freezing p protects the measurement: compiler/linker, build tree, another game, or CPU above threshold."""
    old = prev.get(p['pid'])
    if old is not None:
        busy = p['cpu_s'] - old >= FREEZE_BUSY_CPU_S
    else:
        busy = p['cpu_s'] >= 1.0 and p['cpu_s'] / max(p.get('elapsed_s') or 1.0, 1.0) >= 0.15
    if busy or is_compiler_process(p) or FREEZE_GAME.search(p['command']) or FREEZE_REPLAY.search(p['command']):
        return True
    q = p['ppid']  # start at the parent: a buildq client itself (waiting for or between tokens) is never frozen,
    for _ in range(64):  # only the compilers under it, else a stopped client holds granted tokens for hours
        c = by.get(q)
        if not c or q <= 1:
            return False
        if 'bin/buildq' in c['command']:
            return True
        q = c['ppid']
    return False


def freeze_stall_log(jid, pids):
    """freeze.log: how long the frozen processes were stopped (process-seconds) = the cost to agents of this run."""
    now, secs = time.monotonic(), []
    for pid in pids:
        t0 = _FREEZE_T0.pop(pid, None)
        if t0 is not None:
            secs.append(now - t0)
    if secs:
        freeze_log(f'{jid} stall frozen={len(secs)} pid_s={sum(secs):.0f} max_s={max(secs):.0f}')


def solo_freeze_targets(procs, protected, game, own_out='', prev=None):
    """pids a measured run may freeze. procs = process snapshot (pid/ppid/exe/command/state/cpu_s/elapsed_s).
    prev = {pid: cpu_s} from the previous scan (updated here); None = no CPU filter (everything matching)."""
    by = {p['pid']: p for p in procs}
    out = []
    mgr = manager_token()
    for p in procs:
        pid = p['pid']
        if pid in protected or pid in game or process_is_stopped(p) or pid <= 1 or p['state'].startswith('Z'):
            continue  # zombies cannot be stopped: they were re-logged every scan
        if AGENT_NEVER.search(p['command']) or p['exe'] in AGENT_CLIS or (own_out and own_out in p['command']):
            continue
        chain, q = [], pid
        while q in by and q > 1 and len(chain) < 64:
            chain.append(by[q])
            q = by[q]['ppid']
        if any(c['pid'] in game or 'runq _daemon' in c['command'] or 'runq-job' in c['command']
               for c in chain[1:]):
            continue
        if (any(AGENT_KEEP.search(c['command']) or (mgr and mgr in c['command']) for c in chain)):
            continue
        shell_root = any(AGENT_SHELL_ROOT.search(c['command']) or
                         (c['exe'] in AGENT_SHELLS and by.get(c['ppid'], {}).get('exe') in AGENT_CLIS)
                         for c in chain)
        # any compiler/linker, even an orphaned build.sh/ninja tree outside buildq, whose argv has no agent path
        if (shell_root or AGENT_PATHS.search(p['command']) or FREEZE_REPLAY.search(p['command'])
                or is_compiler_process(p) or any('bin/buildq' in c['command'] for c in chain)):
            if prev is None or freeze_busy(p, by, prev):
                out.append(pid)
    if prev is not None:
        prev.clear()
        prev.update({p['pid']: p['cpu_s'] for p in procs})
    return out


