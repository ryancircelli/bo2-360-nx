def wjson(path, obj):
    tmp = f'{path}.{os.getpid()}.tmp'
    with open(tmp, 'w') as f:
        json.dump(obj, f, indent=1)
    os.replace(tmp, path)


def rjson(path, default=None):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def is_compiler_process(proc):
    if COMPILERS.match(proc.get('exe', '')):
        return True
    if proc.get('exe') != 'xcrun':
        return False
    try:
        argv = shlex.split(proc.get('command', ''))
    except ValueError:
        argv = proc.get('command', '').split()
    return any(COMPILERS.match(os.path.basename(arg)) for arg in argv[1:])


def compiler_processes():
    """Return compiler/build process identities from full argv, not truncated ps comm names."""
    global PROCESS_SNAPSHOT
    try:
        out = subprocess.run(['ps', '-axo', 'pid=,ppid=,stat=,etime=,time=,args='], capture_output=True, text=True,
                             timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    found, all_processes = [], []
    for line in out.splitlines():
        m = re.match(r'^\s*(\d+)\s+(\d+)\s+(\S+)\s+(\S+)\s+(\S+)\s+(.+)$', line)
        if not m:
            continue
        pid, ppid = int(m.group(1)), int(m.group(2))
        state = m.group(3)
        elapsed_s, cpu_s = parse_ps_cpu_time(m.group(4)), parse_ps_cpu_time(m.group(5))
        command = m.group(6).strip()
        try:
            argv = shlex.split(command)
        except ValueError:
            argv = command.split()
        if not argv:
            continue
        exe = os.path.basename(argv[0])
        proc = {'pid': pid, 'ppid': ppid, 'state': state, 'exe': exe, 'cpu_s': cpu_s, 'elapsed_s': elapsed_s,
                'command': command[:1000]}
        all_processes.append(proc)
        if is_compiler_process(proc):
            found.append(proc)
    PROCESS_SNAPSHOT = all_processes
    return found


def parse_ps_cpu_time(value):
    value = value.split('-', 1)[-1]
    fields = value.split(':')
    try:
        seconds = float(fields[-1])
        if len(fields) >= 2:
            seconds += 60 * int(fields[-2])
        if len(fields) >= 3:
            seconds += 3600 * int(fields[-3])
        return seconds
    except (ValueError, IndexError):
        return 0.0


def compile_procs():
    found = compiler_processes()
    if found is None:
        return -1
    active, _ = cpu_active_processes(found, _COMPILER_CPU_LAST)
    return len(active)


_OUTSIDE_COMPILER_CPU_LAST = {}


def outside_compile_procs():
    """CPU-active compilers that no registered buildq build owns. During a speed batch only these delay the next
    measured run: buildq-owned compilers are frozen (SIGSTOP) when the run starts, and waiting for them to go idle
    never ends, because every running build keeps one job going at build cap 0."""
    found = compiler_processes()
    if found is None:
        return -1
    active, _ = cpu_active_processes(found, _OUTSIDE_COMPILER_CPU_LAST)
    return len(outside_build_activity(active, buildq_owned_processes(PROCESS_SNAPSHOT)))


def external_build_activity():
    """Return build/compiler processes using CPU this sample, or None if process inspection failed."""
    found = compiler_processes()
    if found is None:
        return None
    buildq_pids = buildq_owned_processes(PROCESS_SNAPSHOT)
    activity_candidates = [proc for proc in PROCESS_SNAPSHOT if is_build_activity_process(proc)]
    candidates = outside_build_activity(activity_candidates, buildq_pids)
    active, _ = cpu_active_processes(candidates, _PERF_ACTIVITY_CPU_LAST)
    return active


def registered_buildq_builds():
    builds = []
    for name in os.listdir(D['builds']):
        if not name.endswith('.json'):
            continue
        build = rjson(os.path.join(D['builds'], name)) or {}
        if any(pid and alive(pid) for pid in (build.get('pid'), build.get('child_pid'))):
            builds.append(build)
    return builds


def path_inside(path, root):
    if not path or not root:
        return False
    try:
        return os.path.commonpath([os.path.realpath(path), os.path.realpath(root)]) == os.path.realpath(root)
    except (OSError, ValueError):
        return False


def compiler_path_args(command):
    try:
        argv = shlex.split(command)
    except ValueError:
        argv = command.split()
    paths, i = [], 1
    source = re.compile(r'\.(?:c|cc|cpp|cxx|m|mm|s|swift|rs|metal)$', re.I)
    while i < len(argv):
        arg = argv[i]
        if arg in ('-o', '--output') and i + 1 < len(argv):
            i += 1
            paths.append(argv[i])
        elif arg.startswith('--output='):
            paths.append(arg.split('=', 1)[1])
        elif arg.startswith('-o') and len(arg) > 2:
            paths.append(arg[2:])
        elif not arg.startswith('-') and source.search(arg):
            paths.append(arg)
        i += 1
    return paths


def compiler_belongs_to_build(proc, build_cwd, cwd_by_pid):
    cwd = cwd_by_pid.get(proc['pid'])
    if path_inside(cwd, build_cwd):
        return True
    for arg in compiler_path_args(proc.get('command', '')):
        path = arg if os.path.isabs(arg) else os.path.join(cwd or build_cwd or '', arg)
        if path_inside(path, build_cwd):
            return True
    return False


def buildq_owned_processes(processes):
    """Return registered build trees plus compilers reattributed by cwd/source/output paths."""
    builds = registered_buildq_builds()
    roots = {int(pid) for build in builds for pid in (build.get('pid'), build.get('child_pid')) if pid}
    found = descendant_pids(processes, roots)
    candidates = [proc for proc in processes if proc['pid'] not in found and is_compiler_process(proc)]
    cwds = process_cwds([proc['pid'] for proc in candidates])
    for proc in candidates:
        if any(compiler_belongs_to_build(proc, build.get('cwd'), cwds) for build in builds):
            found.add(proc['pid'])
    return found


def leftover_build_compilers(build, processes, cwd_by_pid=None, other_builds=()):
    roots = {int(pid) for pid in (build.get('pid'), build.get('child_pid')) if pid}
    tree = descendant_pids(processes, roots)
    candidates = [proc for proc in processes if is_compiler_process(proc)]
    cwds = cwd_by_pid if cwd_by_pid is not None else process_cwds([proc['pid'] for proc in candidates])
    return [proc for proc in candidates if proc['pid'] in tree or (
        compiler_belongs_to_build(proc, build.get('cwd'), cwds) and
        not any(compiler_belongs_to_build(proc, other.get('cwd'), cwds) for other in other_builds))]


def kill_leftover_build_compilers(build, kill=os.kill):
    found = compiler_processes()
    if found is None:
        return []
    others = [other for other in registered_buildq_builds() if other.get('pid') != build.get('pid')]
    leftovers = leftover_build_compilers(build, PROCESS_SNAPSHOT, other_builds=others)
    killed = []
    for proc in leftovers:
        try:
            kill(proc['pid'], signal.SIGKILL)
            killed.append(proc['pid'])
        except (ProcessLookupError, PermissionError):
            pass
    return killed


def descendant_pids(processes, roots):
    children = {}
    for proc in processes:
        children.setdefault(proc['ppid'], []).append(proc['pid'])
    found, pending = set(), list(roots)
    while pending:
        pid = pending.pop()
        if pid in found:
            continue
        found.add(pid)
        pending.extend(children.get(pid, []))
    return found


def outside_build_activity(activity, tracked_buildq_pids):
    return [proc for proc in activity if proc['pid'] not in tracked_buildq_pids]


def is_build_activity_process(proc):
    xcrun_compiler = proc['exe'] == 'xcrun' and re.search(r'\b(clang|swift|metal)\b', proc['command'])
    return bool(COMPILERS.match(proc['exe']) or xcrun_compiler or BUILD_TOOL.match(proc['exe']) or
                BUILD_COMMAND_HINT.search(proc['command']))


