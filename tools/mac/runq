#!/usr/bin/env -S python3 -I
"""runq: the run queue for game boots on the shared Mac, and buildq: the build-job throttle that goes with it.

  runq submit [options] --app APP --scene SCENE.json [--renderer metal|native]   a scene (scenes/*.json) run
  runq submit [options] --app APP --route ROUTE.route                            a boot_test.sh route run
  runq submit [options] [--app APP] -- CMD ARGS...                                any command ({APP} {OUT} {PORT})
      options: --name N  --out DIR  --class C  --owner O  --timeout S  --env K=V (repeatable)
               --priority (= --class ship)  --wait (block until done, exit with the job's exit code)
               --solo (wait until no other game runs, then hold the machine alone; the default for class perf,
               --no-solo turns it off). Use --solo for FPS numbers and for proofs of timing-dependent bugs.
               --quiet-machine stops builds, waits for load < 16 for at most 300 s, and records the load and avg/min FPS.
      classes, first to run first: ship (0, ship-gate smokes), harness (1, harness/golden captures),
               proof (2, bug proof runs), sweep (3, scene sweeps; the default), perf (4, perf A/B), or a number.
      Within a class, jobs take turns by owner (--owner, else $RUNQ_OWNER, else the --name up to its first '-'):
      the owner with the fewest running jobs, then the one served longest ago; FIFO within an owner.
      prints:  "job <id> out <dir>"   (the result dir; <dir>/result.json and result.txt once done)
  runq wait ID [ID...]      block until the jobs are done (no polling needed on the caller's side); exit = worst exit
  runq status               the queue in run order with estimated start times, running jobs, build throttle
  runq cancel ID            dequeue, or stop a running job (its own process group only)
  runq priority ID CLASS    move a queued job to another class (name or number)
  runq bump ID              run a queued job next within its class (ahead of the owner turns)
  runq solo ID on|off       make a queued job solo or not
  runq result ID            print result.txt
  runq install              copy runq, buildq and the boot_test tools to the spool's bin/ (a path that outlives worktrees)

  buildq [-t N] [--ship] [--] CMD ARGS...
      Runs a build under the shared token pool. ninja and `cmake --build` (Ninja generator) take tokens job by job
      through the GNU make jobserver protocol (a fifo); their -j/--parallel is removed so the pool decides. Any other
      command takes N tokens (-t, default 1) for its whole run. The command runs at nice 15 (--ship: normal priority,
      for the integrator's ship build only). Pool size (adaptive, every change logged in daemon.log): game_cap (4)
      while a measured job runs (solo, a timed benchmark, or --measured), run_cap (12) while only unmeasured games run
      (map sweeps, captures), idle_cap (16) when no game runs. Each build also holds one token for its own first job, so the floor is one job per running build.

Spool: ~/Games/Xbox360/bo2-build/runq/{queue,running,done,jobs,builds,bin}; config.json there overrides slots (3),
idle_cap (16), run_cap (12), game_cap (4). A single detached daemon (lock file daemon.lock) runs at most `slots` jobs at normal
priority, in class order with owner turns (see submit), enforces timeouts, kills only its own children (each job's own process group),
and holds back build tokens while a game runs. Any runq/buildq command starts it when it is not running.
result.json records the slot count, solo, and the games running during the job (conditions.games_start / games_mean /
games_max, full_speed = no other game at any sample), so a 3-game run is never read as a full-speed one.
"""
import errno, fcntl, json, os, re, select, shlex, shutil, signal, subprocess, sys, time

SPOOL = os.path.expanduser(os.environ.get('RUNQ_SPOOL', '~/Games/Xbox360/bo2-build/runq'))
D = {k: os.path.join(SPOOL, k) for k in ('queue', 'running', 'done', 'jobs', 'builds', 'bin')}
FIFO = os.path.join(SPOOL, 'pool.fifo')
POOL_LOCK = os.path.join(SPOOL, 'pool.lock')
DAEMON_LOCK = os.path.join(SPOOL, 'daemon.lock')
STATE = os.path.join(SPOOL, 'state.json')
DLOG = os.path.join(SPOOL, 'daemon.log')
HERE = os.path.dirname(os.path.realpath(__file__))
DEFAULTS = {'slots': 3, 'idle_cap': 16, 'game_cap': 4, 'run_cap': 12, 'port_base': 60000, 'kill_grace_s': 15}
COMPILERS = re.compile(r'^(clang|clang\+\+|clang-\d+|cc1|cc1plus|ld|ld64|ld-prime|swift-frontend|metal|metallib|'
                       r'dxc|rustc|cc|c\+\+)$')
QUIET_LOAD_LIMIT = 16
QUIET_WAIT_CAP_S = 300


def cfg():
    c = dict(DEFAULTS)
    try:
        with open(os.path.join(SPOOL, 'config.json')) as f:
            c.update(json.load(f))
    except (OSError, ValueError):
        pass
    return c


def mkdirs():
    for p in D.values():
        os.makedirs(p, exist_ok=True)


def now_s():
    return time.strftime('%Y-%m-%d %H:%M:%S')


def loadavg():
    return [round(x, 2) for x in os.getloadavg()]


def wjson(path, obj):
    tmp = f'{path}.{os.getpid()}.tmp'
    with open(tmp, 'w') as f:
        json.dump(obj, f, indent=1)
    os.replace(tmp, path)


def rjson(path, default=None):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def compile_procs():
    try:
        out = subprocess.run(['ps', '-axo', 'comm='], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return -1
    return sum(1 for line in out.splitlines() if COMPILERS.match(os.path.basename(line.strip())))


def process_tree(pid):
    """Return a live PID and its descendants (buildq records can predate child_pid support)."""
    try:
        out = subprocess.run(['ps', '-axo', 'pid=,ppid='], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return [pid] if alive(pid) else []
    children = {}
    for line in out.splitlines():
        try:
            child, parent = map(int, line.split())
            children.setdefault(parent, []).append(child)
        except ValueError:
            continue
    result, todo = [], [pid]
    while todo:
        parent = todo.pop()
        if parent not in result and alive(parent):
            result.append(parent)
            todo.extend(children.get(parent, []))
    return result


def games_outside(own_pgids):
    """bo2zm processes that are not in one of runq's job process groups (someone booted the game by hand)."""
    try:
        out = subprocess.run(['ps', '-axo', 'pid=,pgid=,comm='], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    found = []
    for line in out.splitlines():
        parts = line.split(None, 2)
        if len(parts) == 3 and os.path.basename(parts[2]) == 'bo2zm' and int(parts[1]) not in own_pgids:
            found.append(int(parts[0]))
    return found


def paused(c):
    """config.json "paused_until": "HH:MM" (today) holds the queue, e.g. for a quiet window already promised."""
    pu = c.get('paused_until')
    if not pu:
        return False
    try:
        h, m = map(int, pu.split(':'))
    except ValueError:
        return False
    t = time.localtime()
    return (t.tm_hour, t.tm_min) < (h, m)


def active_builds():
    n = 0
    for f in os.listdir(D['builds']):
        if not f.endswith('.json'):
            continue
        b = rjson(os.path.join(D['builds'], f)) or {}
        if b.get('pid') and alive(b['pid']):
            n += 1
        else:
            try:
                os.unlink(os.path.join(D['builds'], f))
            except OSError:
                pass
    return n


# ------------------------------------------------------------------ daemon
def daemon_running():
    mkdirs()
    fd = os.open(DAEMON_LOCK, os.O_RDWR | os.O_CREAT, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        return True
    fcntl.flock(fd, fcntl.LOCK_UN)
    os.close(fd)
    return False


def ensure_daemon(fatal=True):
    if daemon_running():
        return True
    if os.getpriority(os.PRIO_PROCESS, 0) > 0:
        print('runq: starting the daemon from a niced shell; games would inherit the nice value. Run any runq '
              'command once without nice first.', file=sys.stderr)
    me = os.path.realpath(__file__)
    with open(DLOG, 'a') as log:
        subprocess.Popen([sys.executable, '-I', me, '_daemon'], stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                         start_new_session=True, close_fds=True)
    for _ in range(100):
        st = rjson(STATE) or {}
        if st.get('pid') and alive(st['pid']) and daemon_running():
            return True
        time.sleep(0.1)
    if daemon_running():   # the lock is held: a daemon is up but has not written its state yet
        return True
    if fatal:
        sys.exit('runq: the daemon did not start; see ' + DLOG)
    print('runq: the daemon did not start (see ' + DLOG + '); still waiting', file=sys.stderr, flush=True)
    return False


class Adopted:
    """A job started by an earlier daemon: not our child, so poll by pid and read the wrapper's exit file."""
    def __init__(self, pid, out):
        self.pid, self.out = pid, out

    def poll(self):
        if alive(self.pid):
            return None
        try:
            return int(open(os.path.join(self.out, EXIT_FILE)).read().strip())
        except (OSError, ValueError):
            return UNKNOWN_EXIT


EXIT_FILE = '.runq_exit'
UNKNOWN_EXIT = 125   # an adopted job that left no exit file (started before the job wrapper existed, or killed)
# every job runs under this wrapper so a restarted daemon can still learn the exit code
WRAP = ['/bin/sh', '-c', '"$@"; c=$?; echo $c > "$RUNQ_OUT/' + EXIT_FILE + '"; exit $c', 'runq-job']


class Daemon:
    def __init__(self):
        self.c = cfg()
        self.held = 0           # build tokens the daemon holds back while games run
        self.jobs = {}          # id -> {proc, job, slot, start, samples, cancel}
        self.quiet_starting = False
        self.last_repair = 0.0
        self.outside = []
        self.last_start = (rjson(STATE) or {}).get('last_start_by_owner') or {}

    def log(self, msg):
        print(f'[{now_s()}] {msg}', flush=True)

    # --- token pool
    def pool_open(self):
        if not os.path.exists(FIFO):
            os.mkfifo(FIFO, 0o666)
        self.fifo = os.open(FIFO, os.O_RDWR | os.O_NONBLOCK)  # keeps the fifo's contents alive while the daemon runs
        # Never block here: with builds running (pool.lock shared) their open fifo kept the tokens of the last daemon,
        # which returned the ones it held back; the 30 s repair evens the pool out once the builds are done.
        self.refill()

    def drain(self):
        n = 0
        while True:
            try:
                b = os.read(self.fifo, 64)
            except BlockingIOError:
                return n
            if not b:
                return n
            n += len(b)

    def refill(self, force=False):
        """With no build running (pool.lock free), the pool must hold exactly idle_cap - held tokens: lost tokens (a
        build killed with SIGKILL) come back and extras go."""
        lk = os.open(POOL_LOCK, os.O_RDWR | os.O_CREAT, 0o666)
        try:
            fcntl.flock(lk, fcntl.LOCK_EX | (0 if force else fcntl.LOCK_NB))
        except OSError:
            os.close(lk)
            return
        try:
            had = self.drain()
            want = max(0, self.c['idle_cap'] - self.held)
            os.write(self.fifo, b'+' * want)
            if had != want and not force:
                self.log(f'pool repaired: {had} tokens -> {want}')
        finally:
            fcntl.flock(lk, fcntl.LOCK_UN)
            os.close(lk)

    def cap_now(self):
        """(cap, why): game_cap while a measured job runs, run_cap while only unmeasured games run (games started
        outside runq count as unmeasured), idle_cap with no game."""
        quiet = [j['job'].get('name', j['job']['id']) for j in self.jobs.values() if j['job'].get('quiet_machine')]
        if quiet or self.quiet_starting:
            return 0, 'quiet machine: ' + (', '.join(quiet) if quiet else 'preparing')
        measured = [j['job'].get('name', j['job']['id']) for j in self.jobs.values() if is_measured(j['job'])]
        if measured:
            return self.c['game_cap'], 'measured: ' + ', '.join(measured)
        if self.jobs or self.outside:
            return min(self.c.get('run_cap', 12), self.c['idle_cap']), \
                f'{len(self.jobs) + len(self.outside)} unmeasured game(s)'
        return self.c['idle_cap'], 'no game'

    def throttle(self):
        cap, why = self.cap_now()
        if cap != getattr(self, 'cap', None):
            self.log(f'build cap {getattr(self, "cap", "-")} -> {cap} ({why})')
            self.cap, self.cap_why = cap, why
        target = max(0, self.c['idle_cap'] - cap)
        while self.held < target:
            try:
                b = os.read(self.fifo, target - self.held)
            except BlockingIOError:
                break
            self.held += len(b)
        if self.held > target:
            os.write(self.fifo, b'+' * (self.held - target))
            self.held = target
        if time.time() - self.last_repair > 30:
            self.last_repair = time.time()
            self.refill()

    # --- jobs
    def queued(self):
        return sorted(f for f in os.listdir(D['queue']) if f.endswith('.json'))

    def pick(self, q):
        """The next job: lowest class, then bumped jobs, then the owner with the fewest running jobs who was served
        longest ago, then FIFO."""
        rbo = {}
        for j in self.jobs.values():
            o = job_owner(j['job'])
            rbo[o] = rbo.get(o, 0) + 1
        jobs = [(f, rjson(os.path.join(D['queue'], f)) or {}) for f in q]
        jobs.sort(key=lambda fj: sched_key(fj[1], rbo, self.last_start))
        return jobs[0][0]

    def launch(self, qfile):
        src = os.path.join(D['queue'], qfile)
        job = rjson(src)
        if not job:
            os.unlink(src)
            return
        used = {j['slot'] for j in self.jobs.values()}
        slot = min(set(range(self.c['slots'])) - used)
        out = job['out']
        os.makedirs(out, exist_ok=True)
        app = job.get('app') or ''
        if app and job.get('clone_app', True):
            dst = os.path.join(out, 'app', os.path.basename(app.rstrip('/')))
            if os.path.exists(dst):
                shutil.rmtree(os.path.dirname(dst))
            os.makedirs(os.path.dirname(dst))
            r = subprocess.run(['cp', '-cR', app, dst], capture_output=True, text=True)  # APFS clone: no copy
            if r.returncode:
                self.finish_record(job, slot, 2, 'error', time.time(), [], f'app clone failed: {r.stderr.strip()}')
                os.unlink(src)
                return
            app = dst
        port = str(self.c['port_base'] + 2000 * slot)
        subst = {'{APP}': app, '{OUT}': out, '{PORT}': port, '{SLOT}': str(slot)}
        cmd = [subst.get(a, a) for a in job['cmd']]
        cmd = [re.sub(r'\{(APP|OUT|PORT|SLOT)\}', lambda m: subst['{' + m.group(1) + '}'], a) for a in cmd]
        quiet_pids = []
        if job.get('quiet_machine'):
            self.quiet_starting = True
            self.throttle()
            def stop_build_pid(pid):
                if pid in quiet_pids or not alive(pid):
                    return
                # Persist intent first: recovery may SIGCONT a process that was not stopped yet, harmlessly.
                quiet_pids.append(pid)
                job['quiet_build_pids'] = quiet_pids
                wjson(src, job)
                try:
                    os.kill(pid, signal.SIGSTOP)
                except (ProcessLookupError, PermissionError):
                    pass

            for f in os.listdir(D['builds']):
                b = rjson(os.path.join(D['builds'], f)) or {}
                pid = b.get('pid')
                if pid and alive(pid):
                    # Freeze the token owner first so it cannot start another compiler while its tree is inspected.
                    stop_build_pid(pid)
                    for child in process_tree(pid):
                        if child == pid:
                            continue
                        stop_build_pid(child)
            job['quiet_build_pids'] = quiet_pids
            wjson(src, job)  # recover the suspension even if the daemon exits before Popen/run.json
            cmd = [sys.executable, '-I', os.path.join(HERE, 'runq'), '_quiet-wait', '--'] + cmd
        env = dict(os.environ)
        env.update(job.get('env') or {})
        env.update(RUNQ_JOB=job['id'], RUNQ_SLOT=str(slot), RUNQ_OUT=out, BO2_NET_PORT_OFFSET=port)
        start = time.time()
        la = loadavg()
        rec = {'id': job['id'], 'pid': None, 'slot': slot, 'started': now_s(), 'load_start': la,
               'cmd': cmd, 'games_start': len(self.jobs) + 1 + len(self.outside)}
        log = open(os.path.join(out, 'runq.log'), 'ab')
        try:
            try:
                os.unlink(os.path.join(out, EXIT_FILE))
            except OSError:
                pass
            proc = subprocess.Popen(WRAP + cmd, cwd=job.get('cwd') or out, env=env, stdin=subprocess.DEVNULL, stdout=log,
                                    stderr=subprocess.STDOUT, start_new_session=True)
        except OSError as e:
            log.close()
            self.resume_builds(quiet_pids)
            self.quiet_starting = False
            self.finish_record(job, slot, 2, 'error', start, [], f'cannot start: {e}')
            os.unlink(src)
            return
        log.close()
        rec['pid'] = proc.pid
        rec['quiet_pids'] = quiet_pids
        os.replace(src, os.path.join(D['running'], job['id'] + '.json'))
        wjson(os.path.join(D['running'], job['id'] + '.run.json'), rec)
        with open(os.path.join(out, 'conditions.tsv'), 'w') as f:
            f.write('t_s\tload1\tload5\tactive_builds\tcompile_procs\tbuild_cap\tgames\n')
        self.last_start[job_owner(job)] = time.time()
        self.jobs[job['id']] = {'proc': proc, 'job': job, 'slot': slot, 'start': start, 'samples': [],
                                'next_sample': 0.0, 'load_start': la, 'killing': 0.0,
                                'games_start': len(self.jobs) + 1 + len(self.outside), 'quiet_pids': quiet_pids}
        self.quiet_starting = False
        self.log(f'start {job["id"]} slot {slot} pid {proc.pid} load {la[0]}: {shlex.join(cmd)[:300]}')

    def sample(self, j, t):
        la = loadavg()
        ab = active_builds()
        cp = compile_procs()
        cap = self.cap_now()[0]
        games = len(self.jobs) + len(self.outside)
        j['samples'].append((la[0], ab, cp, games, cap))
        with open(os.path.join(j['job']['out'], 'conditions.tsv'), 'a') as f:
            f.write(f'{t - j["start"]:.0f}\t{la[0]}\t{la[1]}\t{ab}\t{cp}\t{cap}\t{games}\n')

    def kill_job(self, j, why):
        pid = j['proc'].pid
        if not j['killing']:
            j['killing'] = time.time()
            j['why'] = why
            self.log(f'stop {j["job"]["id"]} pgid {pid}: {why}')
            try:
                os.killpg(pid, signal.SIGTERM)   # the job's own process group (start_new_session), nothing else
            except ProcessLookupError:
                pass
        elif time.time() - j['killing'] > self.c['kill_grace_s']:
            try:
                os.killpg(pid, signal.SIGKILL)
            except ProcessLookupError:
                pass

    def finish_record(self, job, slot, code, status, start, samples, note='', load_start=None, games_start=None):
        out = job['out']
        res = {'id': job['id'], 'name': job.get('name'), 'status': status, 'exit': code, 'measured': is_measured(job),
               'submitted': job.get('submitted'), 'started': time.strftime('%Y-%m-%d %H:%M:%S',
                                                                           time.localtime(start)),
               'ended': now_s(), 'wall_s': round(time.time() - start, 1),
               'queued_s': max(0.0, round(start - job.get('submitted_t', start), 1)), 'slot': slot,
               'priority': job.get('priority', False), 'out': out, 'note': note,
               'conditions': {'load_start': load_start or loadavg()}}
        if samples:
            ls = [s[0] for s in samples]
            res['conditions'].update(load_mean=round(sum(ls) / len(ls), 1), load_max=max(ls),
                                     builds_mean=round(sum(s[1] for s in samples) / len(samples), 1),
                                     builds_max=max(s[1] for s in samples),
                                     compile_procs_mean=round(sum(s[2] for s in samples) / len(samples), 1),
                                     compile_procs_max=max(s[2] for s in samples),
                                     build_cap=max(s[4] if len(s) > 4 else self.c['game_cap'] for s in samples),
                                     build_cap_min=min(s[4] if len(s) > 4 else self.c['game_cap'] for s in samples))
            gs = [s[3] for s in samples if len(s) > 3]
            if gs:
                res['conditions'].update(games_mean=round(sum(gs) / len(gs), 2), games_max=max(gs))
        res['slots'] = self.c['slots']
        res['solo'] = is_solo(job)
        if job.get('quiet_machine'):
            res['quiet_machine'] = {'stopped_build_pids': job.get('quiet_build_pids', []),
                                    'load_limit': QUIET_LOAD_LIMIT, 'wait_cap_s': QUIET_WAIT_CAP_S,
                                    'fps_valid_threshold': 30}
            qlog = os.path.join(out, 'runq.log')
            try:
                with open(qlog, errors='replace') as f:
                    for line in f:
                        if not line.startswith('quiet-machine gate: '):
                            continue
                        fields = dict(re.findall(r'(\w+)=([^\s]+)', line))
                        if all(k in fields for k in ('waited_s', 'load1', 'limit', 'cap_s', 'capped')):
                            res['quiet_machine'].update(waited_s=float(fields['waited_s']),
                                                        load1=float(fields['load1']),
                                                        load_limit=int(fields['limit']),
                                                        wait_cap_s=int(fields['cap_s']),
                                                        cap_reached=fields['capped'] == 'true')
            except OSError:
                pass
        if games_start is not None:
            res['conditions']['games_start'] = games_start
        g = max([x for x in (res['conditions'].get('games_max'), games_start) if x is not None], default=None)
        if g is not None:
            res['conditions']['full_speed'] = g <= 1
        run = job.get('run_dir') or out
        sj = rjson(os.path.join(run, 'summary.json'))
        if sj and sj.get('summary'):
            s = sj['summary']
            res['fps'] = {k: (round(s[k], 2) if isinstance(s.get(k), float) else s.get(k))
                          for k in ('fps_avg', 'fps_1pct_low', 'fps_01pct_low', 'ft_median', 'ft_p99', 'ft_worst',
                                    'frames') if k in s}
            if s.get('ft_worst'):
                res['fps']['fps_min'] = round(1000.0 / s['ft_worst'], 2)
            if job.get('quiet_machine'):
                res['fps']['valid'] = res['fps'].get('fps_avg') is not None and res['fps']['fps_avg'] >= 30
                if not res['fps']['valid'] and status == 'done':
                    status, code, note = 'invalid', 2, 'quiet-machine average FPS below 30'
                    res.update(status=status, exit=code, note=note)
        elif job.get('quiet_machine'):
            res['fps'] = {'fps_avg': None, 'fps_min': None, 'valid': False}
            if status == 'done':
                status, code, note = 'invalid', 2, 'quiet-machine FPS summary missing'
                res.update(status=status, exit=code, note=note)
        caps = os.path.join(run, 'captures')
        if os.path.isdir(caps):
            res['captures'] = sorted(f for f in os.listdir(caps) if f.endswith('.png'))
        extra = rjson(os.path.join(out, 'scene_result.json'))
        if extra:
            res['scene'] = extra
        log = os.path.join(run, 'game.log')
        res['log'] = log if os.path.exists(log) else os.path.join(out, 'runq.log')
        wjson(os.path.join(out, 'result.json'), res)
        line = (f'{job["id"]} {job.get("name") or ""} {status} exit {code} wall {res["wall_s"]} s '
                f'queued {res["queued_s"]} s load {res["conditions"]["load_start"][0]}'
                f'->{res["conditions"].get("load_mean", "?")} builds {res["conditions"].get("builds_mean", "?")}'
                f' games max {max(res["conditions"].get("games_max") or 0, games_start or 0)}/{res["slots"]}'
                + (' solo' if res['solo'] else '')
                + (f' build cap {res["conditions"]["build_cap"]}' if 'build_cap' in res['conditions'] else '')
                + (f' fps {res["fps"].get("fps_avg")}/{res["fps"].get("fps_1pct_low")}' if res.get('fps') else '')
                + (f' scene {extra.get("verdict")}' if extra else '') + (f' ({note})' if note else ''))
        with open(os.path.join(out, 'result.txt'), 'w') as f:
            f.write(line + '\n')
        wjson(os.path.join(D['done'], job['id'] + '.json'), res)
        self.log('done ' + line)
        return res

    def reap(self):
        t = time.time()
        for jid, j in list(self.jobs.items()):
            if t >= j['next_sample']:
                j['next_sample'] = t + 5
                self.sample(j, t)
            code = j['proc'].poll()
            to = j['job'].get('timeout_s') or 1800
            if code is None:
                if os.path.exists(os.path.join(D['running'], jid + '.cancel')):
                    self.kill_job(j, 'cancelled')
                elif t - j['start'] > to:
                    self.kill_job(j, f'timeout {to} s')
                continue
            status = {'cancelled': 'cancelled'}.get(j.get('why', ''), 'timeout' if j.get('why') else 'done')
            if code < 0:
                code = 128 - code
            if code == UNKNOWN_EXIT and j.get('adopted'):
                j['why'] = j.get('why') or 'adopted after a daemon restart; exit code unknown (see runq.log)'
            # stragglers in the job's own group (a game the job left running)
            try:
                os.killpg(j['proc'].pid, signal.SIGKILL)
            except (ProcessLookupError, PermissionError):
                pass
            self.finish_record(j['job'], j['slot'], code, status, j['start'], j['samples'], j.get('why', ''),
                               j['load_start'], j.get('games_start'))
            self.resume_builds(j.get('quiet_pids', []))
            if j['job'].get('clone_app', True) and j['job'].get('app'):
                shutil.rmtree(os.path.join(j['job']['out'], 'app'), ignore_errors=True)  # our own clone
            for suf in ('.json', '.run.json', '.cancel'):
                try:
                    os.unlink(os.path.join(D['running'], jid + suf))
                except OSError:
                    pass
            del self.jobs[jid]

    def write_state(self):
        wjson(STATE, {'pid': os.getpid(), 'updated': now_s(), 'nice': os.getpriority(os.PRIO_PROCESS, 0),
                      'slots': self.c['slots'], 'idle_cap': self.c['idle_cap'], 'game_cap': self.c['game_cap'],
                      'run_cap': self.c.get('run_cap', 12), 'build_cap_now': self.cap_now()[0],
                      'build_cap_why': self.cap_now()[1],
                      'tokens_held_back': self.held, 'games_outside_runq': self.outside,
                      'paused_until': self.c.get('paused_until') if paused(self.c) else None,
                      'running': {k: {'slot': v['slot'], 'pid': v['proc'].pid, 'name': v['job'].get('name'),
                                      'since_s': round(time.time() - v['start'])} for k, v in self.jobs.items()},
                      'queued': self.queued(), 'last_start_by_owner': self.last_start})

    def resume_builds(self, pids):
        for pid in pids:
            try:
                os.kill(pid, signal.SIGCONT)
            except (ProcessLookupError, PermissionError):
                pass

    def run(self):
        mkdirs()
        lk = os.open(DAEMON_LOCK, os.O_RDWR | os.O_CREAT, 0o644)
        try:
            fcntl.flock(lk, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return  # another daemon has it
        signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
        if os.getpriority(os.PRIO_PROCESS, 0) > 0:
            self.log(f'WARNING: the daemon runs at nice {os.getpriority(os.PRIO_PROCESS, 0)}; games inherit it')
        # jobs left in running/ by an earlier daemon: adopt the ones still alive (same pid, same process group; the
        # exit code comes from the job wrapper's exit file), record the dead ones as lost
        for f in os.listdir(D['running']):
            if f.endswith('.json') and not f.endswith('.run.json'):
                job = rjson(os.path.join(D['running'], f))
                rec = rjson(os.path.join(D['running'], f[:-5] + '.run.json')) or {}
                if job and rec.get('pid') and alive(rec['pid']):
                    st = time.mktime(time.strptime(rec['started'], '%Y-%m-%d %H:%M:%S'))
                    self.jobs[job['id']] = {'proc': Adopted(rec['pid'], job['out']), 'job': job, 'slot': rec['slot'],
                                            'start': st, 'samples': [], 'next_sample': 0.0,
                                            'load_start': rec.get('load_start'), 'killing': 0.0,
                                            'games_start': rec.get('games_start'), 'adopted': True,
                                            'quiet_pids': rec.get('quiet_pids', [])}
                    self.log(f'adopted {job["id"]} slot {rec["slot"]} pid {rec["pid"]}')
                    continue
                if job:
                    self.resume_builds(job.get('quiet_build_pids', []))
                    self.finish_record(job, -1, 2, 'lost', time.time(), [], 'the daemon restarted during the job')
                for suf in ('.json', '.run.json', '.cancel'):
                    try:
                        os.unlink(os.path.join(D['running'], f[:-5] + suf))
                    except OSError:
                        pass
        for qf, job in load_queue():
            stale = job.pop('quiet_build_pids', [])
            if stale:
                self.resume_builds(stale)
                wjson(os.path.join(D['queue'], qf), job)
        self.pool_open()
        self.log(f'daemon up pid {os.getpid()}, slots {self.c["slots"]}, build cap {self.c["idle_cap"]} idle / '
                 f'{self.c.get("run_cap", 12)} unmeasured games / {self.c["game_cap"]} measured')
        try:
            while True:
                self.c = cfg()
                self.reap()
                q = self.queued()
                self.outside = (games_outside({j['proc'].pid for j in self.jobs.values()})
                                if self.c.get('count_outside_games', True) else [])
                free = self.c['slots'] - len(self.outside)
                solo_running = any(is_solo(j['job']) for j in self.jobs.values())
                while q and not paused(self.c) and not solo_running and len(self.jobs) < free:
                    qf = self.pick(q)
                    if is_solo(rjson(os.path.join(D['queue'], qf)) or {}):
                        # a solo job holds the machine alone: start nothing else until the running games end
                        if self.jobs or self.outside:
                            break
                        solo_running = True
                    q.remove(qf)
                    self.launch(qf)
                self.throttle()
                self.write_state()
                time.sleep(1)
        finally:
            for j in self.jobs.values():
                self.resume_builds(j.get('quiet_pids', []))
            if self.held:
                os.write(self.fifo, b'+' * self.held)


# ------------------------------------------------------------------ scheduling
CLASSES = {'ship': 0, 'harness': 1, 'proof': 2, 'sweep': 3, 'perf': 4}
CLASS_NAMES = {v: k for k, v in CLASSES.items()}


def parse_class(v):
    v = str(v).strip().lower()
    if v in CLASSES:
        return CLASSES[v]
    try:
        return int(v)
    except ValueError:
        sys.exit(f'runq: unknown class {v} (ship, harness, proof, sweep, perf or a number)')


def job_class(j):
    if 'class' in j:
        return int(j['class'])
    return 0 if j.get('priority') else 3


def job_owner(j):
    return j.get('owner') or (j.get('name') or 'anon').split('-')[0]


def sched_key(j, running_by_owner, last_start):
    o = job_owner(j)
    return (job_class(j), 0 if j.get('bump') else 1, -j.get('bump_t', 0.0), running_by_owner.get(o, 0),
            last_start.get(o, 0.0), j.get('submitted_t', 0.0))


def history_wall():
    """Median wall time of finished jobs, by name (a trailing -N dropped) and by owner."""
    by_name, by_owner = {}, {}
    try:
        files = sorted(os.listdir(D['done']), key=lambda f: os.path.getmtime(os.path.join(D['done'], f)))[-300:]
    except OSError:
        files = []
    for f in files:
        r = rjson(os.path.join(D['done'], f)) or {}
        if r.get('status') not in ('done', 'timeout') or not r.get('wall_s'):
            continue
        by_name.setdefault(re.sub(r'-\d+$', '', r.get('name') or ''), []).append(r['wall_s'])
        by_owner.setdefault(job_owner(r), []).append(r['wall_s'])
    med = lambda v: sorted(v)[len(v) // 2]
    return {k: med(v) for k, v in by_name.items()}, {k: med(v) for k, v in by_owner.items()}


def estimate_s(j, hist):
    by_name, by_owner = hist
    n = re.sub(r'-\d+$', '', j.get('name') or '')
    if n in by_name:
        return by_name[n]
    if j.get('scene') or j.get('run_dir'):
        return max(60, j.get('timeout_s', 600) - 240 + 60)   # the duration plus the boot
    if job_owner(j) in by_owner:
        return by_owner[job_owner(j)]
    return min(j.get('timeout_s', 600), 600)


def plan(queued, running, slots, last_start, now=None, hist=None):
    """Simulate the scheduler. queued: [(qfile, job)]; running: [(job, started_t)]; slots: slots free of games
    outside runq. -> [(qfile, job, est_start_t, est_s)] in run order (the daemon picks the first)."""
    now = now or time.time()
    hist = hist or history_wall()
    busy = [(max(now + 30, t + estimate_s(j, hist)), job_owner(j)) for j, t in running]
    free_at = [now] * max(0, slots - len(busy)) + [e for e, _ in busy]
    if not free_at:
        free_at = [now + 3600]
    free_at = sorted(free_at)[:max(1, slots)]
    ls = dict(last_start)
    pending = list(queued)
    out = []
    while pending:
        t = min(free_at)
        busy = [(e, o) for e, o in busy if e > t]
        rbo = {}
        for _, o in busy:
            rbo[o] = rbo.get(o, 0) + 1
        pending.sort(key=lambda qj: sched_key(qj[1], rbo, ls))
        qf, j = pending.pop(0)
        est = estimate_s(j, hist)
        if is_solo(j):   # waits for every slot, then holds them all
            t = max(free_at)
            out.append((qf, j, t, est))
            free_at = [t + est] * len(free_at)
            busy = [(t + est, job_owner(j))]
            ls[job_owner(j)] = t
            continue
        out.append((qf, j, t, est))
        free_at.remove(t)
        free_at.append(t + est)
        busy.append((t + est, job_owner(j)))
        ls[job_owner(j)] = t
    return out


def load_queue():
    return [(f, rjson(os.path.join(D['queue'], f)) or {}) for f in
            sorted(f for f in os.listdir(D['queue']) if f.endswith('.json'))]


def is_measured(j):
    """A measured job (its FPS or timing is the result) gets the machine with builds at game_cap: solo jobs, timed
    benchmarks (BENCHMARK true in the route or scene), or --measured. Other games only need builds kept at run_cap."""
    if j.get('measured') is not None:
        return bool(j['measured'])
    if is_solo(j):
        return True
    try:
        if j.get('scene'):
            r = (rjson(j['scene']) or {}).get('route', {})
            return str(r.get('BO2ZM_BENCHMARK', r.get('REX_BO2ZM_BENCHMARK', ''))).lower() in ('true', '1')
        for c in j.get('cmd', []):
            if str(c).endswith('.route') and os.path.isfile(c):
                return any(re.match(r'\s*(REX_)?BO2ZM_BENCHMARK\s*=\s*(true|1)\b', l, re.I) for l in open(c))
    except Exception:
        pass
    return False


def is_solo(j):
    """Solo jobs run with no other game on the machine; class perf is solo unless submitted with --no-solo."""
    return bool(j.get('solo', job_class(j) == CLASSES['perf']))


def cmd_solo(argv):
    if len(argv) != 2 or argv[1] not in ('on', 'off'):
        sys.exit('runq: solo ID on|off')
    for f, j in load_queue():
        if f.endswith(argv[0] + '.json'):
            j['solo'] = argv[1] == 'on'
            wjson(os.path.join(D['queue'], f), j)
            print(f'{argv[0]}: solo {argv[1]}')
            return 0
    print(f'{argv[0]}: not queued')
    return 1


def cmd_priority(argv, bump=False):
    if (bump and len(argv) < 1) or (not bump and len(argv) != 2):
        sys.exit('runq: priority ID CLASS | bump ID')
    jid = argv[0]
    for f, j in load_queue():
        if f.endswith(jid + '.json'):
            if bump:
                j['bump'], j['bump_t'] = True, time.time()
            else:
                j['class'] = parse_class(argv[1])
            wjson(os.path.join(D['queue'], f), j)
            print(f'{jid}: class {CLASS_NAMES.get(job_class(j), job_class(j))}{" bumped" if j.get("bump") else ""}')
            return 0
    print(f'{jid}: not queued')
    return 1


# ------------------------------------------------------------------ client side
def new_id():
    return time.strftime('%m%d-%H%M%S-') + f'{os.getpid() % 10000:04d}'


def scene_route(scene, renderer, path):
    """Writes a boot_test route from a scene file (the map-sweep format: route, renderer_route, duration_s)."""
    lines = [f'# generated by runq from {scene["_path"]} ({renderer})', f'duration_s = {scene["duration_s"]}',
             f'players = {scene.get("players", 1)}']
    route = dict(scene.get('route') or {})
    route.update((scene.get('renderer_route') or {}).get(renderer, {}))
    for k, v in route.items():
        lines.append(f'{k} = {v}')
    with open(path, 'w') as f:
        f.write('\n'.join(lines) + '\n')


def cmd_submit(argv):
    import argparse
    ap = argparse.ArgumentParser(prog='runq submit')
    ap.add_argument('--app')
    ap.add_argument('--scene')
    ap.add_argument('--renderer', default='metal')
    ap.add_argument('--route')
    ap.add_argument('--name')
    ap.add_argument('--out')
    ap.add_argument('--priority', action='store_true', help='= --class ship')
    ap.add_argument('--class', dest='klass', help='ship, harness, proof, sweep (default), perf, or a number')
    ap.add_argument('--owner', help='fair-share owner (default $RUNQ_OWNER, else the name up to its first -)')
    ap.add_argument('--solo', action='store_true', default=None,
                    help='run with no other game on the machine (default for class perf); for FPS numbers and '
                         'timing-dependent bug proofs')
    ap.add_argument('--no-solo', dest='solo', action='store_false')
    ap.add_argument('--measured', action='store_true', default=None,
                    help='keep builds at game_cap (4) during the run (default: solo jobs and timed benchmarks)')
    ap.add_argument('--no-measured', dest='measured', action='store_false')
    ap.add_argument('--quiet-machine', action='store_true',
                    help=f'stop active builds, wait for load < {QUIET_LOAD_LIMIT} for at most '
                         f'{QUIET_WAIT_CAP_S} s, record actual load and avg/min FPS')
    ap.add_argument('--timeout', type=int)
    ap.add_argument('--env', action='append', default=[])
    ap.add_argument('--no-clone', action='store_true', help='run the app in place (one job at a time per app!)')
    ap.add_argument('--golden', help='scene runs: golden dir override')
    ap.add_argument('--no-diff', action='store_true')
    ap.add_argument('--wait', action='store_true')
    if '--' in argv:
        i = argv.index('--')
        a, cmd = ap.parse_args(argv[:i]), argv[i + 1:]
    else:
        a, cmd = ap.parse_args(argv), []
    mkdirs()
    jid = new_id()
    env = dict(e.split('=', 1) for e in a.env)
    if a.app:
        a.app = os.path.abspath(os.path.expanduser(a.app))
        if not os.path.isdir(a.app):
            sys.exit(f'runq: no app at {a.app}')
    bt = os.path.join(HERE, 'boot_test.sh')
    klass = 0 if a.priority else parse_class(a.klass) if a.klass else 3
    solo = a.solo if a.solo is not None else klass == CLASSES['perf']
    if a.quiet_machine:
        solo = True
    job = {'id': jid, 'submitted': now_s(), 'submitted_t': time.time(), 'priority': a.priority, 'class': klass,
           'solo': solo, 'app': a.app, 'clone_app': not a.no_clone, 'env': env}
    if a.measured is not None:
        job['measured'] = a.measured
    if a.quiet_machine:
        job.update(quiet_machine=True, measured=True)
    if a.scene:
        sp = os.path.abspath(os.path.expanduser(a.scene))
        scene = rjson(sp)
        if not scene:
            sys.exit(f'runq: cannot read scene {sp}')
        if not a.app:
            sys.exit('runq: --app is required with --scene')
        name = a.name or f'{scene.get("name", os.path.basename(sp)[:-5])}-{a.renderer}'
        out = os.path.abspath(os.path.expanduser(a.out)) if a.out else os.path.join(D['jobs'], f'{jid}-{name}')
        os.makedirs(out, exist_ok=True)
        scene['_path'] = sp
        scene_route(scene, a.renderer, os.path.join(out, 'scene.route'))
        job.update(name=name, out=out, run_dir=os.path.join(out, 'run'), scene=sp, renderer=a.renderer,
                   cmd=[sys.executable, '-I', os.path.join(HERE, 'runq'), '_scene', sp, a.renderer, '{APP}',
                        '{OUT}', '{PORT}'] + (['--golden', a.golden] if a.golden else [])
                   + (['--no-diff'] if a.no_diff else []),
                   timeout_s=a.timeout or int(scene['duration_s']) + 240)
    elif a.route:
        rp = os.path.abspath(os.path.expanduser(a.route))
        if not a.app:
            sys.exit('runq: --app is required with --route')
        name = a.name or os.path.basename(rp).split('.')[0]
        out = os.path.abspath(os.path.expanduser(a.out)) if a.out else os.path.join(D['jobs'], f'{jid}-{name}')
        dur = 600
        for line in open(rp):
            m = re.match(r'\s*duration_s\s*=\s*(\d+)', line)
            if m:
                dur = int(m.group(1))
        job.update(name=name, out=out, run_dir=os.path.join(out, 'run'),
                   cmd=[bt, '--app', '{APP}', '--route', rp, '--out', os.path.join(out, 'run'), '--port-offset',
                        '{PORT}'], timeout_s=a.timeout or dur + 240)
    elif cmd:
        name = a.name or os.path.basename(cmd[0])
        out = os.path.abspath(os.path.expanduser(a.out)) if a.out else os.path.join(D['jobs'], f'{jid}-{name}')
        job.update(name=name, out=out, cmd=cmd, cwd=os.getcwd(), timeout_s=a.timeout or 1800)
    else:
        sys.exit('runq submit: give --scene, --route or -- CMD')
    os.makedirs(job['out'], exist_ok=True)
    owner = a.owner or os.environ.get('RUNQ_OWNER')
    if owner:
        job['owner'] = owner
    wjson(os.path.join(job['out'], 'job.json'), job)
    wjson(os.path.join(D['queue'], f'{0 if a.priority else 1}-{time.time():.6f}-{jid}.json'), job)
    ensure_daemon()
    print(f'job {jid} out {job["out"]}', flush=True)
    if a.wait:
        sys.exit(cmd_wait([jid]))


def find_done(jid):
    return os.path.join(D['done'], jid + '.json')


def cmd_wait(ids):
    ensure_daemon(fatal=False)
    ids = [i for i in ids if i]
    pending = set(ids)
    kq = select.kqueue()
    dfd = os.open(D['done'], os.O_RDONLY)
    ev = select.kevent(dfd, filter=select.KQ_FILTER_VNODE, flags=select.KQ_EV_ADD | select.KQ_EV_CLEAR,
                       fflags=select.KQ_NOTE_WRITE)
    worst = 0
    while pending:
        for jid in sorted(pending):
            res = rjson(find_done(jid))
            if res:
                pending.discard(jid)
                try:
                    print(open(os.path.join(res['out'], 'result.txt')).read().rstrip(), flush=True)
                except OSError:
                    print(json.dumps(res), flush=True)
                worst = max(worst, res.get('exit', 2) if res.get('status') == 'done' else max(res.get('exit', 2), 2))
            elif not any(f.endswith(jid + '.json') for f in os.listdir(D['queue']) + os.listdir(D['running'])) \
                    and not find_done(jid):   # (it may have moved to done/ while we listed)
                print(f'{jid}: unknown job', flush=True)
                pending.discard(jid)
                worst = max(worst, 2)
        if pending:
            kq.control([ev], 1, 60)   # wakes when done/ changes; 60 s as a safety net
            ensure_daemon(fatal=False)
    os.close(dfd)
    return worst


def cmd_status(_argv):
    ensure_daemon()
    time.sleep(1.2)
    st = rjson(STATE) or {}
    up = bool(st.get('pid')) and daemon_running()
    print(f'daemon: {"up pid " + str(st["pid"]) if up else "down"} nice {st.get("nice")}  updated {st.get("updated")}  '
          f'load {loadavg()}')
    print(f'build throttle: cap now {st.get("build_cap_now")} ({st.get("build_cap_why", "")}; idle {st.get("idle_cap")}, '
          f'unmeasured games {st.get("run_cap")}, measured {st.get("game_cap")}), tokens held back {st.get("tokens_held_back")}, active buildq builds '
          f'{active_builds()}, compiler processes {compile_procs()}')
    if st.get('games_outside_runq'):
        print(f'games running outside runq (they take slots): pids {st["games_outside_runq"]}')
    if st.get('paused_until'):
        print(f'queue paused until {st["paused_until"]} (config.json paused_until)')
    for jid, r in (st.get('running') or {}).items():
        print(f'running {jid} slot {r["slot"]} pid {r["pid"]} {r["name"]} {r["since_s"]} s')
    now = time.time()
    running = []
    for jid, r in (st.get('running') or {}).items():
        jj = rjson(os.path.join(D['running'], jid + '.json')) or {'name': r.get('name')}
        running.append((jj, now - r.get('since_s', 0)))
    slots = (cfg().get('slots', 2)) - len(st.get('games_outside_runq') or [])
    start = now
    if st.get('paused_until'):
        hh, mm = map(int, st['paused_until'].split(':'))
        lt = time.localtime(now)
        start = max(now, time.mktime((lt.tm_year, lt.tm_mon, lt.tm_mday, hh, mm, 0, 0, 0, -1)))
    for qf, j, t, est in plan(load_queue(), running, max(1, slots), st.get('last_start_by_owner') or {}, now=start):
        k = job_class(j)
        print(f'queued  {j.get("id")} {j.get("name")}  class {CLASS_NAMES.get(k, k)}{" bumped" if j.get("bump") else ""}'
              f'{" solo" if is_solo(j) else ""}  owner {job_owner(j)}  est start {time.strftime("%H:%M", time.localtime(t))} (~{int(est // 60)} min)')
    done = sorted(os.listdir(D['done']), key=lambda f: os.path.getmtime(os.path.join(D['done'], f)))[-5:]
    for f in done:
        r = rjson(os.path.join(D['done'], f)) or {}
        print(f'done    {r.get("id")} {r.get("name")} {r.get("status")} exit {r.get("exit")} {r.get("out")}')


def cmd_cancel(ids):
    for jid in ids:
        for q in os.listdir(D['queue']):
            if q.endswith(jid + '.json'):
                job = rjson(os.path.join(D['queue'], q))
                os.unlink(os.path.join(D['queue'], q))
                if job:
                    wjson(os.path.join(D['done'], jid + '.json'),
                          {'id': jid, 'name': job.get('name'), 'status': 'cancelled', 'exit': 2, 'out': job['out'],
                           'note': f'dequeued by runq cancel (pid {os.getppid()}) at {now_s()} before it started'})
                    with open(os.path.join(job['out'], 'result.txt'), 'w') as f:
                        f.write(f'{jid} cancelled before start\n')
                print(f'{jid}: dequeued')
                break
        else:
            if os.path.exists(os.path.join(D['running'], jid + '.json')):
                open(os.path.join(D['running'], jid + '.cancel'), 'w').close()
                print(f'{jid}: stop requested')
            else:
                print(f'{jid}: not queued or running')


def cmd_install(_argv):
    mkdirs()
    for f in ('runq', 'boot_test.sh', 'perf_summary.py', 'make_video.sh', 'compare_video.py', 'scenediff.py',
              'scenes_gate.sh'):
        s = os.path.join(HERE, f)
        if os.path.exists(s):
            # copy then rename: bash reads a running script as it goes, so never rewrite boot_test.sh in place
            t = os.path.join(D['bin'], f'.{f}.{os.getpid()}')
            shutil.copy2(s, t)
            os.replace(t, os.path.join(D['bin'], f))
    if os.path.isdir(os.path.join(HERE, 'scenes')):
        shutil.copytree(os.path.join(HERE, 'scenes'), os.path.join(D['bin'], 'scenes'), dirs_exist_ok=True)
    b = os.path.join(D['bin'], 'buildq')
    if os.path.lexists(b):
        os.unlink(b)
    os.symlink('runq', b)
    print(f'installed in {D["bin"]} (runq, buildq, boot_test.sh and helpers)')


# ------------------------------------------------------------------ scene runner (inside a job)
def cmd_scene(argv):
    import argparse
    ap = argparse.ArgumentParser(prog='runq _scene')
    ap.add_argument('scene')
    ap.add_argument('renderer')
    ap.add_argument('app')
    ap.add_argument('out')
    ap.add_argument('port')
    ap.add_argument('--golden')
    ap.add_argument('--no-diff', action='store_true')
    a = ap.parse_args(argv)
    scene = rjson(a.scene)
    run = os.path.join(a.out, 'run')
    env = dict(os.environ)
    env.update({k: str(v) for k, v in (scene.get('env') or {}).items()})
    env.setdefault('CAPTURE_EVERY_S', str(scene.get('capture_every_s', 0) or 3600))
    env.setdefault('SHOT_EVERY_S', '100000')
    if scene.get('end_on_ready') and not a.no_diff:
        sd_ = os.path.join(HERE, 'scenediff.py')
        gd_ = a.golden or next((g for g in (os.path.join(os.path.dirname(a.scene), 'golden', scene.get('golden_name', scene['name'])),
                                            os.path.join(SPOOL, 'golden', scene.get('golden_name', scene['name']))) if os.path.isdir(g)), '')
        cmd = scene_diff_cmd(sd_, a.scene, os.path.join(run, 'logs'), gd_, a.out)
        cmd = cmd[:cmd.index('diff')] + ['ready', a.scene, os.path.join(run, 'logs')] + ([gd_] if gd_ else [])
        env['END_ON_CMD'] = ' '.join(shlex.quote(c) for c in cmd)
    eol = scene.get('end_on_log')
    if eol:
        env['END_ON_LOG'] = eol['text']
        env['END_ON_LOG_COUNT'] = str(eol.get('count', 1))
        env['END_GRACE_S'] = str(eol.get('grace_s', 2))
    # support_seed: a warm support folder (shader and pipeline caches, console id, launch options) cloned in before
    # the run; "{renderer}" in the path picks one per renderer. A missing seed is made from the first run that passes.
    support_seed = scene.get('support_seed')
    seed = os.path.expanduser(support_seed.replace('{renderer}', a.renderer).replace('{scene}', scene.get('name', 'scene'))) if support_seed else None
    seeded = False
    t0 = time.time()
    if seed and os.path.isdir(seed) and not os.environ.get('RUNQ_COLD'):
        os.makedirs(run, exist_ok=True)
        subprocess.run(['cp', '-cR', seed, os.path.join(run, 'support')])
        seeded = True
    # render the route now, not at submit, so a queued job runs the scene as it is when its turn comes
    scene['_path'] = a.scene
    scene_route(scene, a.renderer, os.path.join(a.out, 'scene.route'))
    bt = [os.path.join(HERE, 'boot_test.sh'), '--app', a.app, '--route', os.path.join(a.out, 'scene.route'), '--out',
          run, '--port-offset', a.port]
    rc = subprocess.run(bt, env=env).returncode
    res = {'scene': scene.get('name'), 'renderer': a.renderer, 'boot_test_exit': rc, 'wall_s': round(time.time() - t0),
           'support': 'seeded' if seeded else 'cold'}
    log = os.path.join(run, 'game.log')
    text = open(log, errors='replace').read() if os.path.exists(log) else ''
    res['missing_pass_log'] = [p for p in scene.get('pass_log', []) if p not in text]
    res['fail_log_hits'] = {p: text.count(p) for p in scene.get('fail_log', []) if p in text}
    try:
        launch = float(open(os.path.join(run, 'launch_time.txt')).read())
    except (OSError, ValueError):
        launch = None
    res['timeline'] = timeline(text, launch)
    verdict = 'PASS'
    if rc not in (0, 1) or res['missing_pass_log'] or res['fail_log_hits']:
        verdict = 'FAIL'
    if not a.no_diff and scene.get('golden') is not None:
        # golden frames: --golden, else <scene dir>/golden/<name>, else <spool>/golden/<name> (outside git)
        gd = a.golden or next((g for g in (os.path.join(os.path.dirname(a.scene), 'golden', scene.get('golden_name', scene['name'])),
                                           os.path.join(SPOOL, 'golden', scene.get('golden_name', scene['name']))) if os.path.isdir(g)),
                              os.path.join(SPOOL, 'golden', scene.get('golden_name', scene['name'])))
        sd = os.path.join(HERE, 'scenediff.py')
    if not a.no_diff and scene.get('golden') is not None and not (os.path.isdir(gd) and os.path.exists(sd)):
        res['diff'] = {'verdict': 'NO_GOLDEN', 'golden': gd}
        print(f'no golden frames in {gd}: diff skipped')
    elif not a.no_diff and scene.get('golden') is not None:
        r = subprocess.run(scene_diff_cmd(sd, a.scene, os.path.join(run, 'captures'), gd, a.out),
                           capture_output=True, text=True)
        print(r.stdout + r.stderr)
        d = rjson(os.path.join(a.out, 'diff.json')) or {}
        res['diff'] = d
        if r.returncode != 0 or d.get('verdict') != 'PASS':
            verdict = 'FAIL'
    # known_fail: [{"log": [texts, all in the game log], "note": ...}] marks a bug owned elsewhere: a FAIL that shows it
    # becomes XFAIL (not a harness failure); a PASS while any is listed becomes XPASS (the fix landed, drop the entry)
    kf = scene.get('known_fail') or []
    if verdict == 'FAIL':
        hit = next((k for k in kf if all(t in text for t in ([k['log']] if isinstance(k['log'], str) else k['log']))),
                   None)
        if hit:
            verdict = 'XFAIL'
            res['known_fail'] = hit
    elif kf:
        verdict = 'XPASS'
    res['verdict'] = verdict
    if seed and not seeded and rc in (0, 1) and not res['missing_pass_log'] and not os.path.isdir(seed) \
            and os.path.isdir(os.path.join(run, 'support', 'cache')):
        save_seed(os.path.join(run, 'support'), seed)
        res['seed_saved'] = seed
    wjson(os.path.join(a.out, 'scene_result.json'), res)
    print(f'scene {scene.get("name")} {a.renderer}: {verdict}  boot_test exit {rc}  timeline {res["timeline"]}'
          + (f'  missing {res["missing_pass_log"]}' if res['missing_pass_log'] else '')
          + (f'  fail_log {res["fail_log_hits"]}' if res['fail_log_hits'] else ''))
    return 0 if verdict in ('PASS', 'XFAIL', 'XPASS') else 1


def save_seed(support, seed):
    """Copy a run's support folder (without logs, captures and the data link) to a seed, atomically."""
    os.makedirs(os.path.dirname(seed), exist_ok=True)
    tmp = seed + f'.tmp{os.getpid()}'
    os.makedirs(tmp)
    for name in os.listdir(support):
        src = os.path.join(support, name)
        if name in ('logs', 'captures') or os.path.islink(src) or name.startswith('0000'):
            continue
        subprocess.run(['cp', '-cR', src, os.path.join(tmp, name)])
    try:
        os.rename(tmp, seed)
    except OSError:
        shutil.rmtree(tmp, ignore_errors=True)


def scene_diff_cmd(sd, scene, caps, golden, out):
    py = os.environ.get('RUNQ_DIFF_PYTHON') or ''
    if py:
        return [py, '-I', sd, 'diff', scene, caps, golden, '--json', os.path.join(out, 'diff.json')]
    return ['uv', 'run', '-q', '--no-project', '--with', 'numpy', '--with', 'pillow', 'python', '-I', sd, 'diff',
            scene, caps, golden, '--json', os.path.join(out, 'diff.json')]


TL_MARKS = [('log_start', None), ('renderer_ready', 'Metal startup: preparation completed'),
            ('menus', 'menus.lua installed'), ('lobby', 'test start: local lobby opened'),
            ('map_picked', ' picked'), ('match_start', ' started'),
            ('in_match', ("the game's client is in a match", 'player in a match', 'controller 0 is in a match')),
            ('spot', '[spot] standing at'), ('first_capture', '[capture] /'), ('last_capture', None)]


def timeline(text, launch=None):
    """Seconds from launch (boot_test's launch_time.txt; else the log's first line) to the boot milestones."""
    import datetime

    def ts(line):
        m = re.match(r'^\[(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d(?:\.\d+)?)\]', line)
        if not m:
            return None
        return datetime.datetime.strptime(m.group(1), '%Y-%m-%d %H:%M:%S.%f' if '.' in m.group(1)
                                          else '%Y-%m-%d %H:%M:%S').timestamp()
    lines = [(ts(l), l) for l in text.splitlines()]
    lines = [(t, l) for t, l in lines if t is not None and 'Script pad' not in l]
    out = {}
    if not lines:
        return out
    t0 = launch or lines[0][0]
    out['log_start'] = round(lines[0][0] - t0, 1)
    for key, needle in TL_MARKS:
        if needle is None:
            continue
        needles = needle if isinstance(needle, tuple) else (needle,)
        for t, l in lines:
            if any(n in l for n in needles) and (key not in ('map_picked', 'match_start') or 'test start:' in l):
                out[key] = round(t - t0, 1)
                break
    caps = [t for t, l in lines if '[capture] /' in l]
    if caps:
        out['last_capture'] = round(caps[-1] - t0, 1)
    out['log_end'] = round(lines[-1][0] - t0, 1)
    return out


# ------------------------------------------------------------------ buildq
def buildq(argv):
    tokens, ship, i = 1, False, 0
    while i < len(argv):
        if argv[i] == '-t':
            tokens, i = int(argv[i + 1]), i + 2
        elif argv[i] == '--ship':
            ship, i = True, i + 1
        elif argv[i] == '--':
            i += 1
            break
        elif argv[i] in ('-h', '--help'):
            print(__doc__)
            return 0
        else:
            break
    cmd = argv[i:]
    if not cmd:
        sys.exit('usage: buildq [-t N] [--ship] [--] CMD ARGS...')
    ensure_daemon()
    base = os.path.basename(cmd[0])
    jobserver = base == 'ninja' or (base == 'cmake' and '--build' in cmd)
    if jobserver:
        cmd = strip_jobs(cmd)
        tokens = 1   # the build's own first job; ninja reads the rest from the pool job by job
    c = cfg()
    tokens = max(1, min(tokens, c['game_cap']))
    rec = os.path.join(D['builds'], f'{os.getpid()}.json')
    wjson(rec, {'pid': os.getpid(), 'cmd': cmd, 'cwd': os.getcwd(), 'tokens': tokens, 'jobserver': jobserver,
                'started': now_s()})
    fifo = os.open(FIFO, os.O_RDWR | os.O_NONBLOCK)
    lk = os.open(POOL_LOCK, os.O_RDWR | os.O_CREAT, 0o666)
    got = 0
    waited = time.time()
    try:
        while got < tokens:
            fcntl.flock(lk, fcntl.LOCK_SH)   # the daemon repairs the pool only when no build holds this
            try:
                b = os.read(fifo, tokens - got)
                got += len(b)
            except BlockingIOError:
                pass
            if got < tokens:
                if got == 0:
                    fcntl.flock(lk, fcntl.LOCK_UN)
                time.sleep(0.5)
        w = time.time() - waited
        if w > 2:
            print(f'buildq: waited {w:.0f} s for build tokens (a game is running or the pool is busy)',
                  file=sys.stderr)
        env = dict(os.environ)
        env.pop('CMAKE_BUILD_PARALLEL_LEVEL', None)
        if jobserver:
            env['MAKEFLAGS'] = f'-j --jobserver-auth=fifo:{FIFO}'
        pre = None if ship else (lambda: os.nice(15))
        p = subprocess.Popen(cmd, env=env, preexec_fn=pre, start_new_session=True)
        wjson(rec, {'pid': os.getpid(), 'child_pid': p.pid, 'cmd': cmd, 'cwd': os.getcwd(), 'tokens': tokens,
                    'jobserver': jobserver, 'started': now_s()})
        while True:
            try:
                return p.wait()
            except KeyboardInterrupt:
                p.send_signal(signal.SIGINT)
    finally:
        if got:
            os.write(fifo, b'+' * got)
        fcntl.flock(lk, fcntl.LOCK_UN)
        os.close(lk)
        os.close(fifo)
        try:
            os.unlink(rec)
        except OSError:
            pass


def strip_jobs(cmd):
    out, i = [], 0
    while i < len(cmd):
        a = cmd[i]
        if a in ('-j', '--parallel'):
            i += 2 if i + 1 < len(cmd) and cmd[i + 1].isdigit() else 1
            continue
        if re.fullmatch(r'-j\d+|--parallel=\d+', a):
            i += 1
            continue
        out.append(a)
        i += 1
    return out


def main():
    if os.path.basename(sys.argv[0]) == 'buildq':
        sys.exit(buildq(sys.argv[1:]))
    if len(sys.argv) < 2 or sys.argv[1] in ('-h', '--help', 'help'):
        print(__doc__)
        return
    sub, argv = sys.argv[1], sys.argv[2:]
    if sub == '_daemon':
        Daemon().run()
    elif sub == '_quiet-wait':
        if argv and argv[0] == '--':
            argv = argv[1:]
        if not argv:
            sys.exit('runq _quiet-wait: missing command')
        start = time.monotonic()
        capped = False
        while loadavg()[0] >= QUIET_LOAD_LIMIT:
            remaining = QUIET_WAIT_CAP_S - (time.monotonic() - start)
            if remaining <= 0:
                capped = True
                break
            time.sleep(min(2, remaining))
        waited = round(time.monotonic() - start, 1)
        load = loadavg()[0]
        print(f'quiet-machine gate: waited_s={waited} load1={load:.2f} limit={QUIET_LOAD_LIMIT} '
              f'cap_s={QUIET_WAIT_CAP_S} capped={str(capped).lower()}', flush=True)
        os.execvpe(argv[0], argv, os.environ)
    elif sub == '_scene':
        sys.exit(cmd_scene(argv))
    elif sub == 'submit':
        cmd_submit(argv)
    elif sub == 'wait':
        sys.exit(cmd_wait(argv))
    elif sub == 'status':
        cmd_status(argv)
    elif sub == 'cancel':
        cmd_cancel(argv)
    elif sub == 'priority':
        sys.exit(cmd_priority(argv))
    elif sub == 'bump':
        sys.exit(cmd_priority(argv, bump=True))
    elif sub == 'solo':
        sys.exit(cmd_solo(argv))
    elif sub == 'result':
        for jid in argv:
            r = rjson(find_done(jid))
            print(open(os.path.join(r['out'], 'result.txt')).read().rstrip() if r else f'{jid}: not done')
    elif sub == 'install':
        cmd_install(argv)
    elif sub == 'buildq':
        sys.exit(buildq(argv))
    else:
        sys.exit(f'runq: unknown command {sub}')


if __name__ == '__main__':
    main()
