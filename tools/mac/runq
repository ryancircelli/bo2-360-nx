def cmd_cancel(ids):
    for jid in ids:
        for q in os.listdir(D['queue']):
            if q.endswith(jid + '.json'):
                job = rjson(os.path.join(D['queue'], q))
                os.unlink(os.path.join(D['queue'], q))
                if job:
                    wjson(os.path.join(D['done'], jid + '.json'),
                          {'id': jid, 'name': job.get('name'), 'status': 'cancelled', 'exit': 2, 'out': job['out'],
                           'note': f'dequeued by runq cancel (pid {os.getppid()}) at {now_s()} before it started'})
                    with open(os.path.join(job['out'], 'result.txt'), 'w') as f:
                        f.write(f'{jid} cancelled before start\n')
                print(f'{jid}: dequeued')
                break
        else:
            if os.path.exists(os.path.join(D['running'], jid + '.json')):
                open(os.path.join(D['running'], jid + '.cancel'), 'w').close()
