def read_job_log(path, start_offset):
    if start_offset is None:
        return ''
    try:
        with open(path, 'rb') as log:
            log.seek(max(0, int(start_offset)))
            return log.read().decode(errors='replace')
    except (OSError, ValueError, TypeError):
        return ''


def parse_quiet_machine_log(text):
    gate = {}
    power_failure = None
    for line in text.splitlines():
        if line.startswith('quiet-machine gate: '):
            fields = dict(re.findall(r'(\w+)=([^\s]+)', line))
            if all(k in fields for k in ('waited_s', 'load1', 'limit', 'cap_s', 'capped')):
                gate.update(waited_s=float(fields['waited_s']), load1=float(fields['load1']),
                            load_limit=int(fields['limit']), wait_cap_s=int(fields['cap_s']),
                            cap_reached=fields['capped'] == 'true')
        elif line.startswith('power-machine gate: '):
            fields = dict(re.findall(r'(\w+)=([^\s]+)', line))
            for key in ('connected', 'ac', 'charging'):
                if key in fields:
                    gate['power_' + key] = fields[key] == 'true'
            for key in ('watts', 'charge'):
                if key in fields:
                    gate['power_' + key] = int(fields[key])
            if fields.get('failed') == 'unavailable':
                power_failure = 'power telemetry unavailable'
        elif line.startswith('power-machine gate failed: '):
            power_failure = line.split('power-machine gate failed: ', 1)[1].strip()
    return gate, power_failure


def cpu_active_processes(processes, previous):
    active, live = [], set()
    for proc in processes:
        pid = proc['pid']
        live.add(pid)
        old = previous.get(pid, proc['cpu_s'])
        delta = max(0.0, proc['cpu_s'] - old)
        previous[pid] = proc['cpu_s']
        if delta >= COMPILE_CPU_DELTA_THRESHOLD_S:
            active.append({**proc, 'cpu_delta_s': round(delta, 3)})
    for pid in set(previous) - live:
        previous.pop(pid, None)
    return active, previous


def process_cwds(pids):
    """Read cwd for new compiler PIDs in one lsof call to keep sampling overhead low."""
    pids = sorted({int(pid) for pid in pids})
    if not pids:
        return {}
    try:
        out = subprocess.run(['/usr/sbin/lsof', '-a', '-p', ','.join(map(str, pids)), '-d', 'cwd', '-Fpn'],
                             capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return {}
    result, current = {}, None
    for line in out.splitlines():
        if line.startswith('p'):
            try:
                current = int(line[1:])
            except ValueError:
                current = None
        elif line.startswith('n') and current is not None:
            result[current] = line[1:]
    return result


def observe_compiler_activity(processes, previous, activity, now, cwd_by_pid):
    """Aggregate compiler CPU and runnable observation time; return per-sample CPU-active processes."""
    active, live = [], set()
    for proc in processes:
        pid = proc['pid']
        live.add(pid)
        old = previous.get(pid, proc['cpu_s'])
        stopped = process_is_stopped(proc)
        delta = 0.0 if stopped else max(0.0, proc['cpu_s'] - old)
        previous[pid] = proc['cpu_s']
        seen = activity.setdefault(pid, {
            'pid': pid, 'ppid': proc['ppid'], 'exe': proc['exe'], 'command': proc['command'],
            'cwd': cwd_by_pid.get(pid), 'first_seen': now, 'last_seen': now, 'cpu_delta_s': 0.0,
            'observed_s': 0.0, 'ps_elapsed_s': proc.get('elapsed_s', 0.0), 'last_active_seen': None,
        })
        if stopped:
            seen['last_active_seen'] = None
        else:
            if seen.get('last_active_seen') is not None:
                seen['observed_s'] = round(seen.get('observed_s', 0.0) +
                                           max(0.0, now - seen['last_active_seen']), 2)
            seen['last_active_seen'] = now
        seen.update(ppid=proc['ppid'], exe=proc['exe'], command=proc['command'],
                    ps_elapsed_s=proc.get('elapsed_s', seen.get('ps_elapsed_s', 0.0)),
                    state=proc.get('state'), stopped=stopped, last_seen=now)
        if seen.get('cwd') is None and cwd_by_pid.get(pid):
            seen['cwd'] = cwd_by_pid[pid]
        seen['cpu_delta_s'] = round(seen.get('cpu_delta_s', 0.0) + delta, 3)
        if delta >= COMPILE_CPU_DELTA_THRESHOLD_S:
            active.append({**proc, 'cwd': seen.get('cwd'), 'cpu_delta_s': round(delta, 3)})
    for pid in set(previous) - live:
        previous.pop(pid, None)
    return active


PRE_FREEZE_GRACE_S = 15.0


def meaningful_compiler_activity(activity):
    """Compiler activity that invalidates a measured run. Entries flagged pre_freeze are buildq-owned compilers that
    slipped past the launch-time SIGSTOP (spawned in the same second) and were frozen in the grace window: the CPU they
    used before the freeze is not the run's fault (job 1113-190418-5121, clang 2.47 CPU-s)."""
    return [p for p in activity.values()
            if not p.get('pre_freeze') and (p.get('cpu_delta_s', 0.0) > COMPILER_INVALID_CPU_S or
            (p.get('observed_s', 0.0) > COMPILER_INVALID_WALL_S and
             p.get('cpu_delta_s', 0.0) >= COMPILER_IDLE_CPU_S))]


def freeze_late_buildq_compilers(j, owned, now_mono, start_mono, kill=os.kill):
    """In the first PRE_FREEZE_GRACE_S of a quiet/perf run, SIGSTOP buildq-owned processes the launch freeze missed and
    flag their activity entries pre_freeze. Returns the pids newly frozen."""
    if now_mono - start_mono > PRE_FREEZE_GRACE_S:
        return []
    frozen = []
    qp = j.setdefault('quiet_pids', [])
    for pid in owned:
        ent = j.get('compiler_activity', {}).get(pid)
        if ent is None:
            continue
        ent['pre_freeze'] = True
        if pid not in qp:
            qp.append(pid)
            try:
                kill(pid, signal.SIGSTOP)
                frozen.append(pid)
            except (ProcessLookupError, PermissionError):
                pass
    return frozen


