def wanted_power_mode(running_jobs):
    """Owner rule 2026-11-12: measured (quiet-machine) runs execute in Low Power Mode (1), everything else -- builds,
    picture checks, idle -- in High Power Mode (2). A running job with env RUNQ_POWERMODE=keep sets the mode itself."""
    if any((j.get('env') or {}).get('RUNQ_POWERMODE') == 'keep' for j in running_jobs):
        return None
    return 1 if any(j.get('quiet_machine') for j in running_jobs) else 2


