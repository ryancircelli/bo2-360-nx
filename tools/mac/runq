def oldest_build_wait_s(now=None):
    now = time.time() if now is None else now
    waits = []
    for f in os.listdir(D['builds']):
        if not f.endswith('.json'):
            continue
        b = rjson(os.path.join(D['builds'], f)) or {}
        registered = b.get('registered') or b.get('started')
        if b.get('pid') and alive(b['pid']) and registered:
            try:
                started = time.mktime(time.strptime(registered, '%Y-%m-%d %H:%M:%S'))
                waits.append(max(0, now - started))
            except ValueError:
                continue
    return max(waits, default=0)


# ------------------------------------------------------------------ daemon
def daemon_running():
    mkdirs()
    fd = os.open(DAEMON_LOCK, os.O_RDWR | os.O_CREAT, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        return True
    fcntl.flock(fd, fcntl.LOCK_UN)
    os.close(fd)
    return False


def spawn_detached_daemon(executable):
    """Double-fork so the daemon is orphaned before the submitting command returns."""
    first = os.fork()
    if first:
        os.waitpid(first, 0)
        return
    try:
        os.setsid()
        second = os.fork()
        if second:
            os._exit(0)
        null_fd = os.open(os.devnull, os.O_RDONLY)
        os.dup2(null_fd, 0)
        log_fd = os.open(DLOG, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
        os.dup2(log_fd, 1)
        os.dup2(log_fd, 2)
        os.execv(sys.executable, [sys.executable, '-I', executable, '_daemon'])
    except BaseException as e:
        try:
            os.write(2, f'runq: detached daemon start failed: {e}\\n'.encode())
        except OSError:
            pass
    os._exit(1)


def ensure_daemon(fatal=True):
    if daemon_running():
        return True
    if os.getpriority(os.PRIO_PROCESS, 0) > 0:
        print('runq: starting the daemon from a niced shell; games would inherit the nice value. Run any runq '
              'command once without nice first.', file=sys.stderr)
    me = os.path.realpath(__file__)
    spawn_detached_daemon(me)
    for _ in range(100):
        st = rjson(STATE) or {}
        if st.get('pid') and alive(st['pid']) and daemon_running():
            return True
        time.sleep(0.1)
    if daemon_running():   # the lock is held: a daemon is up but has not written its state yet
        return True
    if fatal:
        sys.exit('runq: the daemon did not start; see ' + DLOG)
    print('runq: the daemon did not start (see ' + DLOG + '); still waiting', file=sys.stderr, flush=True)
    return False


class Adopted:
    """A job started by an earlier daemon: not our child, so poll by pid and read the wrapper's exit file."""
    def __init__(self, pid, out):
        self.pid, self.out = pid, out

    def poll(self):
        if alive(self.pid):
            return None
        try:
            return int(open(os.path.join(self.out, EXIT_FILE)).read().strip())
        except (OSError, ValueError):
            return UNKNOWN_EXIT


EXIT_FILE = '.runq_exit'
UNKNOWN_EXIT = 125   # an adopted job that left no exit file (started before the job wrapper existed, or killed)
# every job runs under this wrapper so a restarted daemon can still learn the exit code
WRAP = ['/bin/sh', '-c', '"$@"; c=$?; echo $c > "$RUNQ_OUT/' + EXIT_FILE + '"; exit $c', 'runq-job']


class Daemon:
    def __init__(self):
        self.c = cfg()
        self.held = 0           # build tokens the daemon holds back while games run
        self.power_checked_at = 0.0
        self.power_status = None
        self.power_hold = None
        self.perf_hold = None
        self.last_external_build_activity = None
        self.protected_pids = process_ancestors(os.getpid())
        self.jobs = {}          # id -> {proc, job, slot, start, samples, cancel}
        self.quiet_starting = False
        self.last_repair = 0.0
        self.outside = []
        st = rjson(STATE) or {}
        self.last_start = st.get('last_start_by_owner') or {}
        self.last_external_build_activity = restorable_external_activity(
            st.get('last_external_build_activity'), st.get('last_external_build_activity_source'))
        self.last_external_build_activity_source = ('outside' if self.last_external_build_activity is not None else None)
        self.build_interleave_until = float(self.c.get('build_interleave_until') or st.get('build_interleave_until') or 0)
        if self.build_interleave_until > time.time() + BUILD_INTERLEAVE_WINDOW_S:
            self.build_interleave_until = time.time() + BUILD_INTERLEAVE_WINDOW_S
        self.perf_batch = set(st.get('perf_batch') or [])
        self.stop_requested = False
        self.handoff = False
        self.freeze_outside = False

    def log(self, msg):
        print(f'[{now_s()}] {msg}', flush=True)

    # --- token pool
    def pool_open(self):
        if not os.path.exists(FIFO):
            os.mkfifo(FIFO, 0o666)
        self.fifo = os.open(FIFO, os.O_RDWR | os.O_NONBLOCK)  # keeps the fifo's contents alive while the daemon runs
        # Never block here: with builds running (pool.lock shared) their open fifo kept the tokens of the last daemon,
        # which returned the ones it held back; the 30 s repair evens the pool out once the builds are done.
        self.refill()

    def drain(self):
        n = 0
        while True:
            try:
                b = os.read(self.fifo, 64)
            except BlockingIOError:
                return n
            if not b:
                return n
            n += len(b)

    def refill(self, force=False):
        """With no build running (pool.lock free), the pool must hold exactly idle_cap - held tokens: lost tokens (a
        build killed with SIGKILL) come back and extras go."""
        lk = os.open(POOL_LOCK, os.O_RDWR | os.O_CREAT, 0o666)
        try:
            fcntl.flock(lk, fcntl.LOCK_EX | (0 if force else fcntl.LOCK_NB))
        except OSError:
            os.close(lk)
            return
        try:
            had = self.drain()
            want = max(0, self.c['idle_cap'] - self.held)
            os.write(self.fifo, b'+' * want)
            if had != want and not force:
                self.log(f'pool repaired: {had} tokens -> {want}')
        finally:
            fcntl.flock(lk, fcntl.LOCK_UN)
            os.close(lk)

    def cap_now(self):
        """(cap, why): game_cap while a measured job runs, run_cap while only unmeasured games run (games started
        outside runq count as unmeasured), idle_cap with no game."""
        build_window = self.build_interleave_active()
        quiet = [j['job'].get('name', j['job']['id']) for j in self.jobs.values()
                 if j['job'].get('quiet_machine') or is_solo(j['job']) or
                 job_class(j['job']) == CLASSES['perf']]
        if build_window and not quiet and not self.quiet_starting:
            measured = [j['job'].get('name', j['job']['id']) for j in self.jobs.values()
                        if is_measured(j['job'])]
            if measured:
                return self.c['game_cap'], 'build window with measured game(s): ' + ', '.join(measured)
            if self.jobs or self.outside:
                return min(self.c.get('run_cap', 12), self.c['idle_cap']), \
                    f'build window with {len(self.jobs) + len(self.outside)} unmeasured game(s)'
            return self.c['idle_cap'], 'build window: no solo jobs; idle build cap'
        # Builds stay up while ordinary games still drain ahead of a speed batch (a 29 min Forza drive froze every build
        # for the whole drain, 11-23); the cap drops to 0 only when no such game remains or a quiet job is starting.
        draining = [j for j in self.jobs.values() if not (is_solo(j['job']) or j['job'].get('quiet_machine') or
                                                           job_class(j['job']) == CLASSES['perf'])]
        if quiet or self.quiet_starting or (self.perf_batch and not draining):
            return 0, 'quiet machine: ' + (', '.join(quiet) if quiet else 'preparing')
        measured = [j['job'].get('name', j['job']['id']) for j in self.jobs.values() if is_measured(j['job'])]
        if measured:
            return self.c['game_cap'], 'measured: ' + ', '.join(measured)
        if self.jobs or self.outside:
            return min(self.c.get('run_cap', 12), self.c['idle_cap']), \
                f'{len(self.jobs) + len(self.outside)} unmeasured game(s)'
        return self.c['idle_cap'], 'no game'

    def throttle(self):
        cap, why = self.cap_now()
        if cap != getattr(self, 'cap', None):
            self.log(f'build cap {getattr(self, "cap", "-")} -> {cap} ({why})')
            self.cap, self.cap_why = cap, why
        target = max(0, self.c['idle_cap'] - cap)
        while self.held < target:
            try:
                b = os.read(self.fifo, target - self.held)
            except BlockingIOError:
                break
            self.held += len(b)
        if self.held > target:
            os.write(self.fifo, b'+' * (self.held - target))
            self.held = target
        if time.time() - self.last_repair > 30:
            self.last_repair = time.time()
            self.refill()

    # --- jobs
    def queued(self):
        return sorted(f for f in os.listdir(D['queue']) if f.endswith('.json'))

    def pick(self, q):
        """The next job: lowest class, then bumped jobs, then the owner with the fewest running jobs who was served
        longest ago, then FIFO."""
        rbo = {}
        for j in self.jobs.values():
            o = job_owner(j['job'])
            rbo[o] = rbo.get(o, 0) + 1
        jobs = [(f, rjson(os.path.join(D['queue'], f)) or {}) for f in q]
        jobs.sort(key=lambda fj: sched_key(fj[1], rbo, self.last_start))
        return jobs[0][0]

    def launch(self, qfile):
        src = os.path.join(D['queue'], qfile)
        job = rjson(src)
        if not job:
            if os.path.exists(src):
                os.unlink(src)
            return   # (or the laptop worker claimed it between pick and launch)
        used = {j['slot'] for j in self.jobs.values()}
        slot = min(set(range(self.c['slots'])) - used)
        out = job['out']
        os.makedirs(out, exist_ok=True)
        app = job.get('app') or ''
        if app and job.get('clone_app', True):
            dst = os.path.join(out, 'app', os.path.basename(app.rstrip('/')))
            if os.path.exists(dst):
                shutil.rmtree(os.path.dirname(dst))
            os.makedirs(os.path.dirname(dst))
            r = subprocess.run(['cp', '-cR', app, dst], capture_output=True, text=True)  # APFS clone: no copy
            if r.returncode:
                self.finish_record(job, slot, 2, 'error', time.time(), [], f'app clone failed: {r.stderr.strip()}')
                os.unlink(src)
                return
            app = dst
        port = str(self.c['port_base'] + 2000 * slot)
        subst = {'{APP}': app, '{OUT}': out, '{PORT}': port, '{SLOT}': str(slot), '{IN}': os.path.join(out, 'in')}
        if job.get('inputs'):   # same layout the laptop worker builds: {IN}/<basename> (symlinks here, nothing to copy)
            os.makedirs(subst['{IN}'], exist_ok=True)
            for ip in job['inputs']:
                link = os.path.join(subst['{IN}'], os.path.basename(ip.rstrip('/')))
                if not os.path.lexists(link):
                    os.symlink(ip, link)
        cmd = [subst.get(a, a) if a in subst else (a.replace('{OUT}', out).replace('{IN}', subst['{IN}']) if job.get('where') else a)
               for a in job['cmd']]
        cmd = [re.sub(r'\{(APP|OUT|PORT|SLOT|IN)\}', lambda m: subst['{' + m.group(1) + '}'], a) for a in cmd]
        quiet_pids = []
        exec_lock_fd = None
        if job.get('quiet_machine') or is_solo(job) or job_class(job) == CLASSES['perf']:
            # Class-perf always means a measured quiet-machine run, even if an older
            # queued manifest omitted --quiet-machine.
            if job.get('quiet_machine') or job_class(job) == CLASSES['perf']:
                job['quiet_machine'] = True
            self.quiet_starting = True
            exec_lock_fd = os.open(BUILD_EXEC_LOCK, os.O_RDWR | os.O_CREAT, 0o666)
            fcntl.flock(exec_lock_fd, fcntl.LOCK_EX)
            self.throttle()
            def stop_build_pid(pid):
                if pid in quiet_pids or pid in self.protected_pids or not alive(pid):
                    return
                # Persist intent first: recovery may SIGCONT a process that was not stopped yet, harmlessly.
                quiet_pids.append(pid)
                job['quiet_build_pids'] = quiet_pids
                wjson(src, job)
                try:
                    os.kill(pid, signal.SIGSTOP)
                except (ProcessLookupError, PermissionError):
                    pass

            if getattr(self, 'freeze_outside', False) and (job.get('quiet_machine') or job_class(job) == CLASSES['perf']):
                compiler_processes()   # refreshes PROCESS_SNAPSHOT
                held = [p['pid'] for p in PROCESS_SNAPSHOT if is_build_activity_process(p)
                        and p['pid'] not in self.protected_pids]
                for pid in held:
                    stop_build_pid(pid)
                self.log(f'froze {len(held)} outside build process(es) for {job["id"]}')
            builds = registered_buildq_builds()
            roots = {int(pid) for build in builds for pid in (build.get('pid'), build.get('child_pid')) if pid}
            # Stop every token owner before inspecting children so none can spawn another compiler.
            for pid in roots:
                stop_build_pid(pid)
            if compiler_processes() is not None:
                for pid in buildq_owned_processes(PROCESS_SNAPSHOT):
                    stop_build_pid(pid)
            else:
                for pid in roots:
                    for child in process_tree(pid):
                        stop_build_pid(child)
            job['quiet_build_pids'] = quiet_pids
            wjson(src, job)  # recover the suspension even if the daemon exits before Popen/run.json
            if job.get('quiet_machine'):
                cmd = [sys.executable, '-I', os.path.join(HERE, 'runq'), '_quiet-wait', '--'] + cmd
        env = dict(os.environ)
        env['REX_AUDIO_MUTE'] = 'true'  # owner rule: test games never make sound
        # owner 11-22: test games grabbed his real keyboards/receivers; tests never open real USB input devices
        env['SDL_HIDAPI_LIBUSB'] = '0'
        env['SDL_JOYSTICK_HIDAPI'] = '0'
        env.update(job.get('env') or {})
        env.update(RUNQ_HOST='mac', RUNQ_JOB=job['id'], RUNQ_SLOT=str(slot), RUNQ_OUT=out, BO2_NET_PORT_OFFSET=port)
        if job_class(job) == CLASSES['perf']:
            env['RUNQ_PERF_GUARD'] = 'true'
            if not job.get('quiet_machine'):
                cmd = [sys.executable, '-I', os.path.join(HERE, 'runq'), '_perf-wait', '--'] + cmd
        start = time.time()
        la = loadavg()
        rec = {'id': job['id'], 'pid': None, 'slot': slot, 'started': now_s(), 'load_start': la,
               'cmd': cmd, 'games_start': len(self.jobs) + 1 + len(self.outside)}
        qlog = os.path.join(out, 'runq.log')
        log = open(qlog, 'ab')
        job['runq_log_offset'] = os.fstat(log.fileno()).st_size
        wjson(src, job)
        try:
            try:
                os.unlink(os.path.join(out, EXIT_FILE))
            except OSError:
                pass
            proc = subprocess.Popen(WRAP + cmd, cwd=job.get('cwd') or out, env=env, stdin=subprocess.DEVNULL, stdout=log,
                                    stderr=subprocess.STDOUT, start_new_session=True)
        except BaseException as e:
            log.close()
            try:
                self.finish_record(job, slot, 2, 'error', start, [], f'cannot start: {e}')
                os.unlink(src)
            finally:
                self.resume_builds(quiet_pids)
                self.quiet_starting = False
                if exec_lock_fd is not None:
                    fcntl.flock(exec_lock_fd, fcntl.LOCK_UN)
                    os.close(exec_lock_fd)
            if isinstance(e, OSError):
                return
            raise
        log.close()
        registered = False
        try:
            rec['pid'] = proc.pid
            rec['quiet_pids'] = quiet_pids
            os.replace(src, os.path.join(D['running'], job['id'] + '.json'))
            wjson(os.path.join(D['running'], job['id'] + '.run.json'), rec)
            with open(os.path.join(out, 'conditions.tsv'), 'w') as f:
                f.write('t_s\tload1\tload5\tactive_builds\tcompile_procs\tbuild_cap\tgames\tcompile_details_json\n')
            self.last_start[job_owner(job)] = time.time()
            compiler_baseline = compiler_processes() or []
            self.jobs[job['id']] = {'proc': proc, 'job': job, 'slot': slot, 'start': start, 'samples': [],
                                    'next_sample': 0.0, 'load_start': la, 'killing': 0.0,
                                    'games_start': len(self.jobs) + 1 + len(self.outside), 'quiet_pids': quiet_pids,
                                    'compiler_cpu_prev': {p['pid']: p['cpu_s'] for p in compiler_baseline},
                                    'compiler_activity': {},
                                    'process_cpu_prev': {p['pid']: p['cpu_s'] for p in PROCESS_SNAPSHOT},
                                    'process_cpu_totals': {}}
            registered = True
            self.quiet_starting = False
            self.log(f'start {job["id"]} slot {slot} pid {proc.pid} load {la[0]}: {shlex.join(cmd)[:300]}')
            self.write_state()
        finally:
            if not registered:
                try:
                    os.killpg(proc.pid, signal.SIGTERM)
                except (ProcessLookupError, PermissionError):
                    pass
                self.resume_builds(quiet_pids)
                self.quiet_starting = False
            if exec_lock_fd is not None:
                fcntl.flock(exec_lock_fd, fcntl.LOCK_UN)
                os.close(exec_lock_fd)

    def sample(self, j, t):
        la = loadavg()
        compilers = compiler_processes()
        stopped_pids = confirmed_stopped_pids(j.get('quiet_pids', []), PROCESS_SNAPSHOT) \
            if compilers is not None else set()
        ab = active_builds(stopped_pids)
        activity = j.setdefault('compiler_activity', {})
        new_pids = [] if compilers is None else [p['pid'] for p in compilers if p['pid'] not in activity]
        cwds = process_cwds(new_pids)
        hot = [] if compilers is None else observe_compiler_activity(
            compilers, j.setdefault('compiler_cpu_prev', {}), activity, time.monotonic(), cwds)
        if compilers is not None and (j['job'].get('quiet_machine') or job_class(j['job']) == CLASSES['perf']):
            try:
                freeze_late_buildq_compilers(j, buildq_owned_processes(PROCESS_SNAPSHOT), time.time(), j['start'])
            except Exception as e:
                self.log(f'late freeze failed: {e!r}')
        cp = -1 if compilers is None else len(hot)
        totals = j.setdefault('process_cpu_totals', {})
        previous = j.setdefault('process_cpu_prev', {})
        for proc in PROCESS_SNAPSHOT:
            pid = proc['pid']
            old = previous.get(pid, proc['cpu_s'])
            delta = max(0.0, proc['cpu_s'] - old)
            previous[pid] = proc['cpu_s']
            if delta > 0:
                item = totals.setdefault(pid, {'pid': pid, 'ppid': proc['ppid'], 'exe': proc['exe'],
                                               'command': proc['command'], 'cpu_s': 0.0})
                item.update(ppid=proc['ppid'], exe=proc['exe'], command=proc['command'])
                item['cpu_s'] += delta
        cap = self.cap_now()[0]
        games = len(self.jobs) + len(self.outside)
        j['samples'].append((la[0], ab, cp, games, cap, hot))
        # A job may rename or delete its own output folder; that must not take the daemon down.
        os.makedirs(j['job']['out'], exist_ok=True)
        with open(os.path.join(j['job']['out'], 'conditions.tsv'), 'a') as f:
            details = json.dumps(hot, separators=(',', ':')).replace('\t', ' ').replace('\n', ' ')
            f.write(f'{t - j["start"]:.0f}\t{la[0]}\t{la[1]}\t{ab}\t{cp}\t{cap}\t{games}\t{details}\n')

    def kill_job(self, j, why):
        pid = j['proc'].pid
        if not j['killing']:
            j['killing'] = time.time()
            j['why'] = why
            self.log(f'stop {j["job"]["id"]} pgid {pid}: {why}')
            try:
                os.killpg(pid, signal.SIGTERM)   # the job's own process group (start_new_session), nothing else
            except ProcessLookupError:
                pass
        elif time.time() - j['killing'] > self.c['kill_grace_s']:
            try:
                os.killpg(pid, signal.SIGKILL)
            except ProcessLookupError:
                pass

    def finish_record(self, job, slot, code, status, start, samples, note='', load_start=None, games_start=None,
                      process_cpu_totals=None, compiler_activity=None):
        out = job['out']
        res = {'id': job['id'], 'name': job.get('name'), 'status': status, 'exit': code, 'measured': is_measured(job),
               'submitted': job.get('submitted'), 'started': time.strftime('%Y-%m-%d %H:%M:%S',
                                                                           time.localtime(start)),
               'ended': now_s(), 'wall_s': round(time.time() - start, 1),
               'queued_s': max(0.0, round(start - job.get('submitted_t', start), 1)), 'slot': slot,
               'priority': job.get('priority', False), 'out': out, 'note': note,
               'conditions': {'load_start': load_start or loadavg()}}
        if samples:
            ls = [s[0] for s in samples]
            res['conditions'].update(load_mean=round(sum(ls) / len(ls), 1), load_max=max(ls),
                                     builds_mean=round(sum(s[1] for s in samples) / len(samples), 1),
                                     builds_max=max(s[1] for s in samples),
                                     compile_procs_mean=round(sum(s[2] for s in samples) / len(samples), 1),
                                     compile_procs_max=max(s[2] for s in samples),
                                     build_cap=max(s[4] if len(s) > 4 else self.c['game_cap'] for s in samples),
                                     build_cap_min=min(s[4] if len(s) > 4 else self.c['game_cap'] for s in samples))
            res['conditions']['compiler_processes_seen'] = sorted(
                (compiler_activity or {}).values(), key=lambda p: p.get('cpu_delta_s', 0), reverse=True)
            res['conditions']['meaningful_compiler_processes'] = meaningful_compiler_activity(
                compiler_activity or {})
            gs = [s[3] for s in samples if len(s) > 3]
            if gs:
                res['conditions'].update(games_mean=round(sum(gs) / len(gs), 2), games_max=max(gs))
        res['slots'] = self.c['slots']
        res['solo'] = is_solo(job)
        if job.get('quiet_machine'):
            res['quiet_machine'] = {'stopped_build_pids': job.get('quiet_build_pids', []),
                                    'load_limit': QUIET_LOAD_LIMIT, 'wait_cap_s': QUIET_WAIT_CAP_S,
                                    'fps_valid_threshold': 30,
                                    'fps_required': quiet_fps_required(job),
                                    'minimum_adapter_watts': int((job.get('env') or {}).get(
                                        'RUNQ_MIN_ADAPTER_W', QUIET_MIN_ADAPTER_W))}
            qlog = os.path.join(out, 'runq.log')
            res['quiet_machine']['runq_log_offset'] = job.get('runq_log_offset')
            gate, power_failure = parse_quiet_machine_log(
                read_job_log(qlog, job.get('runq_log_offset')))
            res['quiet_machine'].update(gate)
            if power_failure:
                status, code, note = 'invalid', 2, 'power preflight: ' + power_failure
                res.update(status=status, exit=code, note=note)
        if games_start is not None:
            res['conditions']['games_start'] = games_start
        g = max([x for x in (res['conditions'].get('games_max'), games_start) if x is not None], default=None)
        if g is not None:
            res['conditions']['full_speed'] = g <= 1
        run = job.get('run_dir') or out
        sj = rjson(os.path.join(run, 'summary.json'))
        if sj and sj.get('summary'):
            s = sj['summary']
            res['fps'] = {k: (round(s[k], 2) if isinstance(s.get(k), float) else s.get(k))
                          for k in ('fps_avg', 'fps_1pct_low', 'fps_01pct_low', 'ft_median', 'ft_p99', 'ft_worst',
                                    'frames') if k in s}
            if job.get('no_fps'):
                res['fps'].update(valid=None, required=False)
            if s.get('ft_worst'):
                res['fps']['fps_min'] = round(1000.0 / s['ft_worst'], 2)
            if quiet_fps_required(job):
                res['fps']['valid'] = res['fps'].get('fps_avg') is not None and res['fps']['fps_avg'] >= 30
                if not res['fps']['valid'] and status == 'done':
                    status, code, note = 'invalid', 2, 'quiet-machine average FPS below 30'
                    res.update(status=status, exit=code, note=note)
                if res['fps']['valid'] and status == 'done':
                    h = perf_tsv_health(run)
                    if h:
                        res['fps']['bin_min'], res['fps']['bin_median'] = round(h[0], 2), round(h[1], 2)
                    if h and h[0] < COLLAPSE_RATIO * h[1]:
                        res['fps']['valid'] = False
                        status, code, note = 'invalid', 2, \
                            f'collapsed run: a 60 s bin fell to {h[0]:.1f} fps vs median {h[1]:.1f}; rerun'
                        res.update(status=status, exit=code, note=note)
                    elif (res['fps'].get('fps_avg') or 0) >= VSYNC_CAP_FPS:
                        res['fps']['capped'] = True    # flag, not invalid: some jobs want to show 60 is held
                        note = (note + '; ' if note else '') + 'fps at vsync cap: no speed signal'
                        res.update(note=note)
        elif job.get('quiet_machine'):
            res['fps'] = {'fps_avg': None, 'fps_min': None,
                          'valid': False if quiet_fps_required(job) else None}
            if not quiet_fps_required(job):
                res['fps']['required'] = False
        if not sj and quiet_missing_summary_invalid(job, status):
            status, code, note = 'invalid', 2, 'quiet-machine FPS summary missing'
            res.update(status=status, exit=code, note=note)
        if status == 'done' and perf_guard_required(job):
            meaningful = res['conditions'].get('meaningful_compiler_processes', [])
            if meaningful:
                names = ', '.join(f"{p['exe']}[{p['pid']}] {p.get('cpu_delta_s', 0)} CPU-s "
                                  f"cwd={p.get('cwd') or '?'} ppid={p.get('ppid')}" for p in meaningful[:8])
                status, code, note = 'invalid', 2, f'perf run overlapped {len(meaningful)} meaningful compiler process(es)' + \
                    (f': {names}' if names else '')
                res.update(status=status, exit=code, note=note)
        caps = os.path.join(run, 'captures')
        if os.path.isdir(caps):
            res['captures'] = sorted(f for f in os.listdir(caps) if f.endswith('.png'))
        extra = rjson(os.path.join(out, 'scene_result.json'))
        if extra:
            res['scene'] = extra
        log = os.path.join(run, 'game.log')
        res['log'] = log if os.path.exists(log) else os.path.join(out, 'runq.log')
        load_high = res['conditions'].get('load_max', 0) >= QUIET_LOAD_LIMIT
        if perf_guard_required(job) and (status == 'invalid' or load_high):
            top = top_cpu_processes(process_cpu_totals or {})
            path = os.path.join(out, 'top-processes.json')
            wjson(path, {'sampled_cpu_seconds': True, 'threshold_note': 'top cumulative CPU deltas sampled during run',
                         'processes': top})
            res['conditions']['top_processes_file'] = path
        wjson(os.path.join(out, 'result.json'), res)
        line = (f'{job["id"]} {job.get("name") or ""} {status} exit {code} wall {res["wall_s"]} s '
                f'queued {res["queued_s"]} s load {res["conditions"]["load_start"][0]}'
                f'->{res["conditions"].get("load_mean", "?")} builds {res["conditions"].get("builds_mean", "?")}'
                f' games max {max(res["conditions"].get("games_max") or 0, games_start or 0)}/{res["slots"]}'
                + (' solo' if res['solo'] else '')
                + (f' build cap {res["conditions"]["build_cap"]}' if 'build_cap' in res['conditions'] else '')
                + (f' fps {res["fps"].get("fps_avg")}/{res["fps"].get("fps_1pct_low")}' if res.get('fps') else '')
                + (f' scene {extra.get("verdict")}' if extra else '') + (f' ({note})' if note else ''))
        with open(os.path.join(out, 'result.txt'), 'w') as f:
            f.write(line + '\n')
        wjson(os.path.join(D['done'], job['id'] + '.json'), res)
        self.log('done ' + line)
        return res

    def reap(self):
        t = time.time()
        for jid, j in list(self.jobs.items()):
            if t >= j['next_sample']:
                j['next_sample'] = t + 1
                self.sample(j, t)
            code = j['proc'].poll()
            to = j['job'].get('timeout_s') or 1800
            if code is None:
                if os.path.exists(os.path.join(D['running'], jid + '.cancel')):
                    self.kill_job(j, 'cancelled')
                elif t - j['start'] > to:
                    self.kill_job(j, f'timeout {to} s')
                continue
            status = {'cancelled': 'cancelled'}.get(j.get('why', ''), 'timeout' if j.get('why') else 'done')
            if code < 0:
                code = 128 - code
            if code == UNKNOWN_EXIT and j.get('adopted'):
                j['why'] = j.get('why') or 'adopted after a daemon restart; exit code unknown (see runq.log)'
            # stragglers in the job's own group (a game the job left running)
            try:
                os.killpg(j['proc'].pid, signal.SIGKILL)
            except (ProcessLookupError, PermissionError):
                pass
            try:
                self.finish_record(j['job'], j['slot'], code, status, j['start'], j['samples'], j.get('why', ''),
                                   j['load_start'], j.get('games_start'), j.get('process_cpu_totals'),
                                   j.get('compiler_activity'))
            finally:
                self.resume_builds(j.get('quiet_pids', []))
            if j['job'].get('clone_app', True) and j['job'].get('app'):
                shutil.rmtree(os.path.join(j['job']['out'], 'app'), ignore_errors=True)  # our own clone
            for suf in ('.json', '.run.json', '.cancel'):
                try:
                    os.unlink(os.path.join(D['running'], jid + suf))
                except OSError:
                    pass
            del self.jobs[jid]
            self.perf_batch.discard(jid)
            if is_solo(j['job']) or j['job'].get('quiet_machine'):
                builds_waiting = active_builds()
                wait_s = oldest_build_wait_s()
                if should_open_build_window(builds_waiting, wait_s):
                    self.build_interleave_until = max(self.build_interleave_until,
                                                      time.time() + BUILD_INTERLEAVE_WINDOW_S)
                    self.log(f'build window opened after {jid}: {builds_waiting} buildq job(s), '
                             'oldest waited ' + f'{int(wait_s)}s; up to {BUILD_INTERLEAVE_WINDOW_S}s')

    def build_interleave_active(self):
        if not self.build_interleave_until:
            return False
        builds_waiting = active_builds()
        if not builds_waiting:
            self.log('build interleave ended: no waiting buildq jobs')
            self.build_interleave_until = 0.0
            return False
        remaining = self.build_interleave_until - time.time()
        if remaining <= 0:
            self.log(f'build interleave ended: {builds_waiting} buildq job(s) remain after '
                     f'{BUILD_INTERLEAVE_WINDOW_S}s')
            self.build_interleave_until = 0.0
            return False
        return True

    def write_state(self):
        wjson(STATE, {'pid': os.getpid(), 'updated': now_s(), 'nice': os.getpriority(os.PRIO_PROCESS, 0),
                      'slots': self.c['slots'], 'idle_cap': self.c['idle_cap'], 'game_cap': self.c['game_cap'],
                      'run_cap': self.c.get('run_cap', 12), 'build_cap_now': self.cap_now()[0],
                      'build_cap_why': self.cap_now()[1],
                      'tokens_held_back': self.held, 'games_outside_runq': self.outside,
                      'paused_until': self.c.get('paused_until') if paused(self.c) else None,
                      'build_interleave_until': self.build_interleave_until,
                      'build_interleave_window_s': BUILD_INTERLEAVE_WINDOW_S,
                      'power_hold': self.power_hold,
                      'perf_hold': self.perf_hold,
                      'last_external_build_activity': self.last_external_build_activity,
                      'last_external_build_activity_source': self.last_external_build_activity_source,
                      'power_status': self.power_status,
                      'running': {k: {'slot': v['slot'], 'pid': v['proc'].pid, 'name': v['job'].get('name'),
                                      'solo': is_solo(v['job']),
                                      'quiet_machine': bool(v['job'].get('quiet_machine')),
                                      'since_s': round(time.time() - v['start'])} for k, v in self.jobs.items()},
                      'quiet_starting': self.quiet_starting,
                      'queued': self.queued(), 'last_start_by_owner': self.last_start})

    def resume_builds(self, pids):
        for pid in pids:
            try:
                os.kill(pid, signal.SIGCONT)
            except (ProcessLookupError, PermissionError):
                pass

    def run(self):
        mkdirs()
        lk = os.open(DAEMON_LOCK, os.O_RDWR | os.O_CREAT, 0o644)
        try:
            fcntl.flock(lk, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return  # another daemon has it
        # TERM / `runq restart`: hand over now. Running games and builds are not touched (each game has its own session
        # and exit-code wrapper); the next daemon adopts them. USR1 keeps the old behaviour: stop launching, wait for
        # every job and build to drain, then exit (needs a quiet machine, which a busy queue never gets).
        signal.signal(signal.SIGTERM, lambda *_: setattr(self, 'handoff', True))
        signal.signal(signal.SIGUSR1, lambda *_: setattr(self, 'stop_requested', True))
        if os.getpriority(os.PRIO_PROCESS, 0) > 0:
            self.log(f'WARNING: the daemon runs at nice {os.getpriority(os.PRIO_PROCESS, 0)}; games inherit it')
        # jobs left in running/ by an earlier daemon: adopt the ones still alive (same pid, same process group; the
        # exit code comes from the job wrapper's exit file), record the dead ones as lost
        for f in os.listdir(D['running']):
            if f.endswith('.json') and not f.endswith('.run.json'):
                job = rjson(os.path.join(D['running'], f))
                rec = rjson(os.path.join(D['running'], f[:-5] + '.run.json')) or {}
                if job and rec.get('pid') and alive(rec['pid']):
                    st = time.mktime(time.strptime(rec['started'], '%Y-%m-%d %H:%M:%S'))
                    self.jobs[job['id']] = {'proc': Adopted(rec['pid'], job['out']), 'job': job, 'slot': rec['slot'],
                                            'start': st, 'samples': [], 'next_sample': 0.0,
                                            'load_start': rec.get('load_start'), 'killing': 0.0,
                                            'games_start': rec.get('games_start'), 'adopted': True,
                                            'quiet_pids': rec.get('quiet_pids', [])}
                    self.log(f'adopted {job["id"]} slot {rec["slot"]} pid {rec["pid"]}')
                    continue
                if job:
                    self.resume_builds(job.get('quiet_build_pids', []))
                    self.finish_record(job, -1, 2, 'lost', time.time(), [], 'the daemon restarted during the job')
                for suf in ('.json', '.run.json', '.cancel'):
                    try:
                        os.unlink(os.path.join(D['running'], f[:-5] + suf))
                    except OSError:
                        pass
        for qf, job in load_queue():
            stale = job.pop('quiet_build_pids', [])
            if stale:
                self.resume_builds(stale)
                wjson(os.path.join(D['queue'], qf), job)
        self.pool_open()
        self.log(f'daemon up pid {os.getpid()}, slots {self.c["slots"]}, build cap {self.c["idle_cap"]} idle / '
                 f'{self.c.get("run_cap", 12)} unmeasured games / {self.c["game_cap"]} measured')
        try:
            while True:
                self.c = cfg()
                self.reap()
                want_mode = wanted_power_mode([v['job'] for v in self.jobs.values()])
                if want_mode is not None and want_mode != getattr(self, 'power_mode', None):
                    ok = set_power_mode(want_mode)
                    self.log(f'power mode -> {"low" if want_mode == 1 else "high"}'
                             f'{"" if ok else " FAILED (sudoers entry missing?)"}')
                    self.power_mode = want_mode
                q = self.queued()
                qjobs = [(qf, rjson(os.path.join(D['queue'], qf)) or {}) for qf in q]
                needs_power = any(j.get('quiet_machine') or job_class(j) == CLASSES['perf'] for _, j in qjobs)
                if needs_power and time.time() - self.power_checked_at >= 15:
                    try:
                        self.power_status = power_source()
                    except RuntimeError as e:
                        self.power_status = {'error': str(e)}
                    self.power_checked_at = time.time()
                if needs_power:
                    self.power_hold = next((reason for _, job in qjobs
                                            if (reason := adapter_hold_reason(job, self.power_status))), None)
                else:
                    self.power_hold = None
                activity = external_build_activity()
                now = time.time()
                if activity is None:
                    self.last_external_build_activity = now
                    self.last_external_build_activity_source = 'unknown'
                elif activity:
                    self.last_external_build_activity = now
                    self.last_external_build_activity_source = 'outside'
                self.perf_hold = (perf_activity_hold_reason(os.path.exists(HOLD_PERF_FILE),
                                                           self.last_external_build_activity, now)
                                  if any(j.get('quiet_machine') or job_class(j) == CLASSES['perf']
                                         for _, j in qjobs) else None)
                # Bounded wait: outside builds (cmake/ninja started without buildq) never go quiet on a busy day, so a
                # speed job held by one for perf_hold_max_s (default 900) runs anyway; launch() freezes those builds
                # for the run and resumes them after.
                self.freeze_outside = False
                if self.perf_hold == 'held: outside build':
                    oldest = max((now - j.get('submitted_t', now) for _, j in qjobs
                                  if j.get('quiet_machine') or job_class(j) == CLASSES['perf']), default=0)
                    if oldest >= float(self.c.get('perf_hold_max_s', PERF_HOLD_MAX_S)):
                        self.perf_hold, self.freeze_outside = None, True
                        if not getattr(self, 'freeze_logged', False):
                            self.log(f'speed job waited {int(oldest)}s behind outside builds: it runs now and the '
                                     'outside builds are frozen for the run')
                        self.freeze_logged = True
                    else:
                        self.freeze_logged = False
                qids = {j.get('id') for _, j in qjobs}
                power_eligible = {j.get('id') for _, j in qjobs
                                  if not adapter_hold_reason(j, self.power_status)}
                perf_eligible = {j.get('id') for _, j in qjobs if j.get('id') in power_eligible and
                                 (not (j.get('quiet_machine') or job_class(j) == CLASSES['perf']) or
                                  self.perf_hold is None)}
                # Held speed work must not keep a batch open and block builds or non-speed jobs.
                self.perf_batch.intersection_update(perf_eligible | set(self.jobs))
                self.perf_batch.intersection_update(qids | set(self.jobs))
                self.perf_batch.update(bumped_perf_jobs(qjobs, perf_eligible))
                if not self.perf_batch:
                    waiting_perf = [(qf, j) for qf, j in qjobs
                                    if job_class(j) == CLASSES['perf'] and j.get('id') in perf_eligible]
                    batch_n = max(1, int(self.c.get('perf_batch_size', 3)))
                    batch_age = max(1, int(self.c.get('perf_batch_age_s', PERF_BATCH_AGE_S)))
                    running_by_owner = {}
                    for active in self.jobs.values():
                        owner = job_owner(active['job'])
                        running_by_owner[owner] = running_by_owner.get(owner, 0) + 1
                    selected, batch_kind, oldest_age = (choose_perf_batch(
                        waiting_perf, time.time(), batch_n, batch_age, running_by_owner, self.last_start)
                        if not self.stop_requested else ([], False, 0))
                    if selected:
                        self.perf_batch = set(selected)
                        if batch_kind == 'urgent':
                            self.log(f'urgent perf batch opened: {next(iter(self.perf_batch))}')
                        elif batch_kind == 'bump':
                            self.log(f'bumped perf job opened next: {next(iter(self.perf_batch))}')
                        else:
                            self.log(f'perf batch opened: {len(self.perf_batch)} job(s), oldest waited '
                                     f'{int(oldest_age)}s; builds and non-speed work held until batch drains')
                if self.stop_requested and not self.jobs:
                    # A TERM stops new launches; release the perf hold so token-waiting buildq jobs can finish.
                    self.perf_batch.clear()
                    self.build_interleave_until = 0.0
                self.outside = (games_outside({j['proc'].pid for j in self.jobs.values()})
                                if self.c.get('count_outside_games', True) else [])
                free = self.c['slots'] - len(self.outside)
                solo_running = any(is_solo(j['job']) for j in self.jobs.values())
                # Speed-run starvation clock. It restarts while a speed job runs or none is waiting; a hold (outside
                # build, power) neither restarts it nor counts as starved, so checks keep flowing during a hold.
                perf_waiting = any(job_class(j) == CLASSES['perf'] and j.get('id') in power_eligible for _, j in qjobs)
                if not perf_waiting or any(job_class(j['job']) == CLASSES['perf'] for j in self.jobs.values()):
                    self.perf_seen = time.time()
                starved = perf_starved(getattr(self, 'perf_seen', 0.0), time.time(), bool(self.perf_batch),
                                       self.perf_hold)
                if starved and not getattr(self, 'starve_logged', False):
                    self.log(f'speed runs starved {PERF_STARVE_S}s: proof and sweep jobs wait for a speed run')
                self.starve_logged = starved
                while q and not self.stop_requested and not paused(self.c) and not solo_running and len(self.jobs) < free:
                    interleave_active = self.build_interleave_active()
                    compiler_busy = (not self.freeze_outside and
                                     (outside_compile_procs() if self.perf_batch else compile_procs()) != 0)
                    builds_busy = active_builds() > 0
                    jobs_per_owner = []
                    for qf in q:
                        job = rjson(os.path.join(D['queue'], qf)) or {}
                        if adapter_hold_reason(job, self.power_status):
                            continue
                        if not mac_may_run(job):
                            continue
                        if self.perf_hold and (job.get('quiet_machine') or job_class(job) == CLASSES['perf']):
                            continue
                        if not allowed_during_perf_batch(job, self.perf_batch, interleave_active, starved):
                            continue
                        if not self.perf_batch and job_class(job) == CLASSES['perf']:
                            continue
                        if defer_perf_for_activity(job, interleave_active, builds_busy, compiler_busy,
                                                   bool(self.perf_batch)):
                            continue
                        if defer_solo_for_build_window(job, interleave_active):
                            continue
                        jobs_per_owner.append((qf, job))
                    non_speed_running = sum(job_class(j['job']) != CLASSES['perf'] for j in self.jobs.values())
                    non_speed_cap = max(1, int(self.c.get('non_speed_parallel', self.c['slots'])))
                    gated, drain = solo_gate(jobs_per_owner, not (self.jobs or self.outside), time.time(),
                                             float(self.c.get('solo_max_wait_s', SOLO_MAX_WAIT_S)))
                    if drain and drain.get('id') != getattr(self, 'drain_logged', None):
                        self.drain_logged = drain.get('id')
                        self.log(f'solo drain: {drain.get("id")} waited {int(time.time() - drain.get("submitted_t", 0))}s; '
                                 'no new games start until the running ones end')
                    allowed = set(gated)
                    candidates = [qf for qf, job in jobs_per_owner if qf in allowed and
                                  (self.perf_batch or non_speed_running < non_speed_cap)]
                    if not candidates:
                        break
                    qf = self.pick(candidates)
                    if is_solo(rjson(os.path.join(D['queue'], qf)) or {}):
                        solo_running = True   # (the gate only lets a solo job through on an empty machine)
                    q.remove(qf)
                    self.launch(qf)
                if time.time() - getattr(self, 'remote_checked', 0) >= 5:
                    self.remote_checked = time.time()
                    try:
                        reap_remote()
                    except Exception as e:   # never let laptop bookkeeping stop the Mac queue
                        self.log(f'reap_remote failed: {e!r}')
                self.throttle()
                self.write_state()
                if self.handoff:
                    self.log(f'handoff: daemon exits now; {len(self.jobs)} running job(s) and all builds keep going '
                             'and are adopted by the next daemon')
                    break
                if self.stop_requested and can_finish_daemon_shutdown(
                        len(self.jobs), active_builds(), compile_procs()):
                    self.log('graceful daemon stop: runq jobs and buildq/compiler activity drained')
                    break
                time.sleep(1)
        finally:
            for j in self.jobs.values():
                if not self.handoff:   # on a handoff a running solo job still needs its builds frozen
                    self.resume_builds(j.get('quiet_pids', []))
            if self.held:
                os.write(self.fifo, b'+' * self.held)


# ------------------------------------------------------------------ scheduling
CLASSES = {'ship': 0, 'harness': 1, 'proof': 2, 'sweep': 3, 'perf': 4}
CLASS_NAMES = {v: k for k, v in CLASSES.items()}


def parse_class(v):
    v = str(v).strip().lower()
    if v in CLASSES:
        return CLASSES[v]
    try:
        return int(v)
    except ValueError:
        sys.exit(f'runq: unknown class {v} (ship, harness, proof, sweep, perf or a number)')


def job_class(j):
    if 'class' in j:
        return int(j['class'])
    return 0 if j.get('priority') else 3


def job_owner(j):
    return j.get('owner') or (j.get('name') or 'anon').split('-')[0]


PERF_HOLD_MAX_S = 900   # a speed job held by outside builds this long runs anyway, outside builds frozen
SOLO_MAX_WAIT_S = 600   # a queued solo job lets other games keep flowing this long, then the machine drains for it


def solo_gate(entries, machine_empty, now, max_wait):
    """Which queued jobs may start now. entries: [(qfile, job)] already passed the hold filters. A solo job needs the
    machine alone, but while games run it must not block the others (2026-11-22: a solo proof at the head held four
    non-solo jobs for ~10 min with free slots). So: a quiet machine may start anything, but once the oldest solo job
    has waited max_wait it goes first and nothing else starts (drain). A busy machine runs non-solo jobs until then.
    -> (eligible qfiles, drain solo job or None)"""
    solos = [(qf, j) for qf, j in entries if is_solo(j)]
    others = [qf for qf, j in entries if not is_solo(j)]
    aged = [(qf, j) for qf, j in solos if now - j.get('submitted_t', now) >= max_wait]
    if aged:
        return ([qf for qf, _ in solos] if machine_empty else []), min(aged, key=lambda x: x[1].get('submitted_t', now))[1]
    if machine_empty:
        return [qf for qf, _ in entries], None
    return others, None


def sched_key(j, running_by_owner, last_start):
    o = job_owner(j)
    return (job_class(j), 0 if j.get('bump') else 1, -j.get('bump_t', 0.0), running_by_owner.get(o, 0),
            last_start.get(o, 0.0), j.get('submitted_t', 0.0))


def choose_perf_batch(waiting_perf, now, batch_n, batch_age, running_by_owner, last_start):
    """Return IDs for an urgent one-job batch or a fair N/age-triggered perf block."""
    bumped = sorted(((qf, j) for qf, j in waiting_perf if j.get('bump')),
                    key=lambda fj: sched_key(fj[1], running_by_owner, last_start))
    oldest_age = max((now - j.get('submitted_t', now) for _, j in waiting_perf), default=0)
    if bumped:
        return [bumped[0][1]['id']], 'bump', oldest_age
    urgent = sorted(((qf, j) for qf, j in waiting_perf if j.get('urgent')),
                    key=lambda fj: fj[1].get('submitted_t', 0))
    if urgent:
        return [urgent[0][1]['id']], 'urgent', oldest_age
    if len(waiting_perf) < batch_n and oldest_age < batch_age:
        return [], None, oldest_age
    ordered = sorted(waiting_perf, key=lambda fj: sched_key(fj[1], running_by_owner, last_start))
    return [j['id'] for _, j in ordered[:batch_n]], 'batch', oldest_age


def bumped_perf_jobs(qjobs, power_eligible):
    """Include a newly bumped queued speed job in an already-open batch, regardless of owner rotation."""
    return {j.get('id') for _, j in qjobs
            if j.get('id') in power_eligible and job_class(j) == CLASSES['perf'] and j.get('bump')}


PERF_STARVE_S = 600   # checks may pass an open speed batch this long after speed work last ran; then they wait


def perf_starved(last_perf_t, now, batch_open, perf_hold):
    return bool(batch_open) and not perf_hold and now - last_perf_t > PERF_STARVE_S


def allowed_during_perf_batch(job, selected, interleave_active, starved=False):
    """Preserve class order during a speed batch: higher classes may pass, lower classes wait. Once the batch has gone
    PERF_STARVE_S without a speed run (starved), proof and sweep jobs wait too: a steady stream of checks kept speed
    runs from ever starting (2026-11-13, 35 min after a restart with 13 speed jobs queued)."""
    if not selected:
        return True
    klass = job_class(job)
    if starved and CLASSES['harness'] < klass < CLASSES['perf']:
        return False   # also inside a build window: a 400 s check started there outlasts it and blocks the solo run
    if interleave_active:
        return True
    if klass > CLASSES['perf']:
        return False
    return klass != CLASSES['perf'] or job.get('id') in selected


def history_wall():
    """Median wall time of finished jobs, by name (a trailing -N dropped) and by owner."""
    by_name, by_owner = {}, {}
    try:
        files = sorted(os.listdir(D['done']), key=lambda f: os.path.getmtime(os.path.join(D['done'], f)))[-300:]
    except OSError:
        files = []
    for f in files:
        r = rjson(os.path.join(D['done'], f)) or {}
        if r.get('status') not in ('done', 'timeout') or not r.get('wall_s'):
            continue
        by_name.setdefault(re.sub(r'-\d+$', '', r.get('name') or ''), []).append(r['wall_s'])
        by_owner.setdefault(job_owner(r), []).append(r['wall_s'])
    med = lambda v: sorted(v)[len(v) // 2]
    return {k: med(v) for k, v in by_name.items()}, {k: med(v) for k, v in by_owner.items()}


def estimate_s(j, hist):
    by_name, by_owner = hist
    n = re.sub(r'-\d+$', '', j.get('name') or '')
    if n in by_name:
        return by_name[n]
    if j.get('scene') or j.get('run_dir'):
        return max(60, j.get('timeout_s', 600) - 240 + 60)   # the duration plus the boot
    if job_owner(j) in by_owner:
        return by_owner[job_owner(j)]
    return min(j.get('timeout_s', 600), 600)


def plan(queued, running, slots, last_start, now=None, hist=None):
    """Simulate the scheduler. queued: [(qfile, job)]; running: [(job, started_t)]; slots: slots free of games
    outside runq. -> [(qfile, job, est_start_t, est_s)] in run order (the daemon picks the first)."""
    now = now or time.time()
    hist = hist or history_wall()
    busy = [(max(now + 30, t + estimate_s(j, hist)), job_owner(j)) for j, t in running]
    free_at = [now] * max(0, slots - len(busy)) + [e for e, _ in busy]
    if not free_at:
        free_at = [now + 3600]
    free_at = sorted(free_at)[:max(1, slots)]
    ls = dict(last_start)
    pending = list(queued)
    out = []
    while pending:
        t = min(free_at)
        busy = [(e, o) for e, o in busy if e > t]
        rbo = {}
        for _, o in busy:
            rbo[o] = rbo.get(o, 0) + 1
        pending.sort(key=lambda qj: sched_key(qj[1], rbo, ls))
        # a solo job waits behind non-solo work until it has waited solo_max_wait_s (see solo_gate)
        aged = [x for x in pending if is_solo(x[1]) and t - x[1].get('submitted_t', t) >= SOLO_MAX_WAIT_S]
        plain = [x for x in pending if not is_solo(x[1])]
        pick_ = aged[0] if aged else (plain[0] if plain else pending[0])
        pending.remove(pick_)
        qf, j = pick_
        est = estimate_s(j, hist)
        if is_solo(j):   # waits for every slot, then holds them all
            t = max(free_at)
            out.append((qf, j, t, est))
            free_at = [t + est] * len(free_at)
            busy = [(t + est, job_owner(j))]
            ls[job_owner(j)] = t
            continue
        out.append((qf, j, t, est))
        free_at.remove(t)
        free_at.append(t + est)
        busy.append((t + est, job_owner(j)))
        ls[job_owner(j)] = t
    return out


def load_queue():
    return [(f, rjson(os.path.join(D['queue'], f)) or {}) for f in
            sorted(f for f in os.listdir(D['queue']) if f.endswith('.json'))]


def is_measured(j):
    """A measured job (its FPS or timing is the result) gets the machine with builds at game_cap: solo jobs, timed
    benchmarks (BENCHMARK true in the route or scene), or --measured. Other games only need builds kept at run_cap."""
    if j.get('measured') is not None:
        return bool(j['measured'])
    if is_solo(j):
        return True
    try:
        if j.get('scene'):
            r = (rjson(j['scene']) or {}).get('route', {})
            return str(r.get('BO2ZM_BENCHMARK', r.get('REX_BO2ZM_BENCHMARK', ''))).lower() in ('true', '1')
        for c in j.get('cmd', []):
            if str(c).endswith('.route') and os.path.isfile(c):
                return any(re.match(r'\s*(REX_)?BO2ZM_BENCHMARK\s*=\s*(true|1)\b', l, re.I) for l in open(c))
    except Exception:
        pass
    return False


def solo_has_speed_signal(j):
    """Solo exists to keep a speed number clean. A job may hold the machine alone only if it yields one: a route run
    (boot_test records FPS), a timed benchmark scene, a --quiet-machine bench, or a job submitted with --timing (it
    measures its own speed/frame timing, or proves a frame-rate-dependent bug). Builds, trace captures, harvests and
    picture-only checks never need the machine alone."""
    if j.get('timing') or j.get('quiet_machine'):
        return True
    if j.get('scene'):
        r = (rjson(j['scene']) or {}).get('route', {})
        return str(r.get('BO2ZM_BENCHMARK', r.get('REX_BO2ZM_BENCHMARK', ''))).lower() in ('true', '1')
    return job_uses_boot_test(j)


NO_SIGNAL_SOLO_MSG = ('solo is only for jobs that produce a speed number, and this one gets no FPS from runq. '
                      'If it measures its own speed/frame timing or proves a frame-rate-dependent bug, add --timing; '
                      'otherwise drop --solo (class perf: add --no-solo or pick another class).')


def is_solo(j):
    """Solo jobs run with no other game on the machine; class perf is solo unless submitted with --no-solo."""
    return bool(j.get('solo', job_class(j) == CLASSES['perf']))


def cmd_restart(argv):
    """runq restart: load new runq code without touching running jobs or builds. The old daemon hands over (TERM) and a
    new one adopts every running job. Takes a few seconds; queued jobs just wait."""
    mkdirs()
    st = rjson(STATE) or {}
    pid = st.get('pid')
    if pid and alive(pid) and daemon_running():
        os.kill(pid, signal.SIGTERM)
        for _ in range(150):   # the daemon checks every second
            if not daemon_running():
                break
            time.sleep(0.2)
        else:
            sys.exit(f'runq restart: daemon {pid} did not exit within 30 s (kill -9 it; jobs are adopted either way)')
    ensure_daemon()
    st = rjson(STATE) or {}
    print(f'runq: daemon restarted, pid {st.get("pid")}; adopted jobs are in {DLOG}')


def cmd_solo(argv):
    if len(argv) != 2 or argv[1] not in ('on', 'off'):
        sys.exit('runq: solo ID on|off')
    for f, j in load_queue():
        if f.endswith(argv[0] + '.json'):
            if argv[1] == 'on' and not solo_has_speed_signal(j):
                print(f'{argv[0]}: refused: {NO_SIGNAL_SOLO_MSG}')
                return 1
            j['solo'] = argv[1] == 'on'
            wjson(os.path.join(D['queue'], f), j)
            print(f'{argv[0]}: solo {argv[1]}')
            return 0
    print(f'{argv[0]}: not queued')
    return 1


def cmd_priority(argv, bump=False):
    if (bump and len(argv) < 1) or (not bump and len(argv) != 2):
        sys.exit('runq: priority ID CLASS | bump ID')
    jid = argv[0]
    for f, j in load_queue():
        if f.endswith(jid + '.json'):
            if bump:
                j['bump'], j['bump_t'] = True, time.time()
            else:
                j['class'] = parse_class(argv[1])
            wjson(os.path.join(D['queue'], f), j)
            print(f'{jid}: class {CLASS_NAMES.get(job_class(j), job_class(j))}{" bumped" if j.get("bump") else ""}')
            return 0
    print(f'{jid}: not queued')
    return 1


# ------------------------------------------------------------------ client side
def new_id():
    return time.strftime('%m%d-%H%M%S-') + f'{os.getpid() % 10000:04d}'


def scene_route(scene, renderer, path):
    """Writes a boot_test route from a scene file (the map-sweep format: route, renderer_route, duration_s)."""
    lines = [f'# generated by runq from {scene["_path"]} ({renderer})', f'duration_s = {scene["duration_s"]}',
             f'players = {scene.get("players", 1)}']
    route = dict(scene.get('route') or {})
    route.update((scene.get('renderer_route') or {}).get(renderer, {}))
    for k, v in route.items():
        lines.append(f'{k} = {v}')
    with open(path, 'w') as f:
        f.write('\n'.join(lines) + '\n')


def cmd_submit(argv):
    import argparse
    ap = argparse.ArgumentParser(prog='runq submit')
    ap.add_argument('--app')
    ap.add_argument('--scene')
    ap.add_argument('--renderer', default='metal')
    ap.add_argument('--route')
    ap.add_argument('--name')
    ap.add_argument('--out')
    ap.add_argument('--priority', action='store_true', help='= --class ship')
    ap.add_argument('--class', dest='klass', help='ship, harness, proof, sweep (default), perf, or a number')
    ap.add_argument('--owner', help='fair-share owner (default $RUNQ_OWNER, else the name up to its first -)')
    ap.add_argument('--solo', action='store_true', default=None,
                    help='run with no other game on the machine (default for class perf); for FPS numbers and '
                         'timing-dependent bug proofs')
    ap.add_argument('--no-solo', dest='solo', action='store_false')
    ap.add_argument('--measured', action='store_true', default=None,
                    help='keep builds at game_cap (4) during the run (default: solo jobs and timed benchmarks)')
    ap.add_argument('--no-measured', dest='measured', action='store_false')
    ap.add_argument('--quiet-machine', action='store_true',
                    help=f'stop active builds, wait for load < {QUIET_LOAD_LIMIT} for at most '
                         f'{QUIET_WAIT_CAP_S} s, record actual load and avg/min FPS')
    ap.add_argument('--no-fps', action='store_true',
                    help='with --quiet-machine, skip FPS summary validity for offline/non-game jobs')
    ap.add_argument('--timing', action='store_true',
                    help='the job measures its own speed/frame timing or proves a frame-rate-dependent bug; required '
                         'for --solo (and class perf) on --scene/-- CMD jobs that get no FPS from runq')
    ap.add_argument('--urgent', action='store_true', help='class-perf only: request an immediate one-job speed batch')
    ap.add_argument('--timeout', type=int)
    ap.add_argument('--where', choices=('mac', 'any', 'laptop'), default='mac')
    ap.add_argument('--input', action='append', default=[], help='Mac path copied to {IN}/<name> (with --where)')
    ap.add_argument('--env', action='append', default=[])
    ap.add_argument('--no-clone', action='store_true', help='run the app in place (one job at a time per app!)')
    ap.add_argument('--golden', help='scene runs: golden dir override')
    ap.add_argument('--no-diff', action='store_true')
    ap.add_argument('--wait', action='store_true')
    if '--' in argv:
        i = argv.index('--')
        a, cmd = ap.parse_args(argv[:i]), argv[i + 1:]
    else:
        a, cmd = ap.parse_args(argv), []
    mkdirs()
    jid = new_id()
    env = dict(e.split('=', 1) for e in a.env)
    if a.app:
        a.app = os.path.abspath(os.path.expanduser(a.app))
        if not os.path.isdir(a.app):
            sys.exit(f'runq: no app at {a.app}')
    bt = os.path.join(HERE, 'boot_test.sh')
    klass = 0 if a.priority else parse_class(a.klass) if a.klass else 3
    if a.no_fps and not a.quiet_machine:
        sys.exit('runq submit: --no-fps requires --quiet-machine')
    if a.where != 'mac' and (a.app or a.scene or a.route or a.quiet_machine or a.solo or a.urgent or not cmd
                             or klass == CLASSES['perf']):
        sys.exit('runq submit: --where any|laptop is for plain `-- CMD` jobs only (no --app/--scene/--route/--solo/'
                 '--quiet-machine/--urgent/class perf): the laptop has no game and no GPU')
    if a.urgent and klass != CLASSES['perf']:
        sys.exit('runq submit: --urgent is only valid for class perf')
    solo = a.solo if a.solo is not None else klass == CLASSES['perf']
    if a.quiet_machine:
        solo = True
    job = {'id': jid, 'submitted': now_s(), 'submitted_t': time.time(), 'priority': a.priority, 'class': klass,
           'solo': solo, 'app': a.app, 'clone_app': not a.no_clone, 'env': env}
    if a.urgent:
        job['urgent'] = True
    if a.measured is not None:
        job['measured'] = a.measured
    if a.quiet_machine:
        job.update(quiet_machine=True, measured=True)
    if a.no_fps:
        job['no_fps'] = True
    if a.timing:
        job['timing'] = True
    if a.scene:
        sp = os.path.abspath(os.path.expanduser(a.scene))
        scene = rjson(sp)
        if not scene:
            sys.exit(f'runq: cannot read scene {sp}')
        if not a.app:
            sys.exit('runq: --app is required with --scene')
        name = a.name or f'{scene.get("name", os.path.basename(sp)[:-5])}-{a.renderer}'
        out = os.path.abspath(os.path.expanduser(a.out)) if a.out else os.path.join(D['jobs'], f'{jid}-{name}')
        os.makedirs(out, exist_ok=True)
        scene['_path'] = sp
        scene_route(scene, a.renderer, os.path.join(out, 'scene.route'))
        job.update(name=name, out=out, run_dir=os.path.join(out, 'run'), scene=sp, renderer=a.renderer,
                   cmd=[sys.executable, '-I', os.path.join(HERE, 'runq'), '_scene', sp, a.renderer, '{APP}',
                        '{OUT}', '{PORT}'] + (['--golden', a.golden] if a.golden else [])
                   + (['--no-diff'] if a.no_diff else []),
                   timeout_s=a.timeout or int(scene['duration_s']) + 240)
    elif a.route:
        rp = os.path.abspath(os.path.expanduser(a.route))
        if not a.app:
            sys.exit('runq: --app is required with --route')
        name = a.name or os.path.basename(rp).split('.')[0]
        out = os.path.abspath(os.path.expanduser(a.out)) if a.out else os.path.join(D['jobs'], f'{jid}-{name}')
        dur = 600
        for line in open(rp):
            m = re.match(r'\s*duration_s\s*=\s*(\d+)', line)
            if m:
                dur = int(m.group(1))
        job.update(name=name, out=out, run_dir=os.path.join(out, 'run'),
                   cmd=[bt, '--app', '{APP}', '--route', rp, '--out', os.path.join(out, 'run'), '--port-offset',
                        '{PORT}'], timeout_s=a.timeout or dur + 240)
    elif cmd:
        name = a.name or os.path.basename(cmd[0])
        out = os.path.abspath(os.path.expanduser(a.out)) if a.out else os.path.join(D['jobs'], f'{jid}-{name}')
        job.update(name=name, out=out, cmd=cmd, cwd=os.getcwd(), timeout_s=a.timeout or 1800)
    else:
        sys.exit('runq submit: give --scene, --route or -- CMD')
    if solo and not solo_has_speed_signal(job):
        sys.exit(f'runq submit: {NO_SIGNAL_SOLO_MSG}')
    os.makedirs(job['out'], exist_ok=True)
    if a.where != 'mac':
        job['where'] = a.where
    if a.input:
        job['inputs'] = [os.path.abspath(os.path.expanduser(i)) for i in a.input]
        for i in job['inputs']:
            if not os.path.exists(i):
                sys.exit(f'runq: no input {i}')
    owner = a.owner or os.environ.get('RUNQ_OWNER')
    if owner:
        job['owner'] = owner
    wjson(os.path.join(job['out'], 'job.json'), job)
    wjson(os.path.join(D['queue'], f'{0 if a.priority else 1}-{time.time():.6f}-{jid}.json'), job)
    ensure_daemon()
    print(f'job {jid} out {job["out"]}', flush=True)
    if a.wait:
        sys.exit(cmd_wait([jid]))


# ------------------------------------------------------------------ the laptop pull worker's side (Mac end)
def laptop_state():
    hb = rjson(LAPTOP_HB) or {}
    if not hb.get('t'):
        return {'state': 'unreachable'}
    age = round(time.time() - hb['t'])
    state = 'unreachable' if age > LAPTOP_FRESH_S else ('busy' if hb.get('busy') else 'idle')
    return dict(hb, state=state, age_s=age)


def mac_may_run(job, hb=None):
    """May the Mac daemon start this queued job? `laptop` never; `any` only while the laptop is busy or silent."""
    w = job.get('where', 'mac')
    if w == 'mac':
        return True
    if w == 'laptop':
        return False
    return (hb or laptop_state())['state'] != 'idle'


def _write_hb(worker, busy, load):
    wjson(LAPTOP_HB, {'t': time.time(), 'busy': busy, 'load': load, 'worker': worker, 'updated': now_s()})


def remote_claim(worker, load=None):
    """Called over ssh by the laptop worker when idle: atomically move the best eligible queued job to remote/ and
    print its manifest (nothing when none). rename() is the claim: the Mac daemon launching the same file loses cleanly."""
    mkdirs()
    _write_hb(worker, False, load)
    rbo = {}
    jobs = []
    for qf, j in load_queue():
        if j.get('where') in ('any', 'laptop'):
            jobs.append((qf, j))
    if not jobs:
        return None
    jobs.sort(key=lambda fj: sched_key(fj[1], rbo, {}))
    for qf, j in jobs:
        dst = os.path.join(D['remote'], j['id'] + '.json')
        try:
            os.rename(os.path.join(D['queue'], qf), dst)
        except OSError:
            continue
        j['_qname'] = qf
        j['claim'] = {'worker': worker, 'started': now_s(), 'beat': time.time()}
        wjson(dst, j)
        return j
    return None


def remote_beat(worker, jid, load=None):
    """-> 'ok' or 'cancel' (stop the job) or 'lost' (the Mac no longer holds this claim: kill it)."""
    _write_hb(worker, True, load)
    path = os.path.join(D['remote'], jid + '.json')
    j = rjson(path)
    if not j or j.get('claim', {}).get('worker') != worker:
        return 'lost'
    j['claim']['beat'] = time.time()
    wjson(path, j)
    return 'cancel' if os.path.exists(os.path.join(D['remote'], jid + '.cancel')) else 'ok'


def _remote_drop(jid):
    for suf in ('.json', '.cancel'):
        try:
            os.unlink(os.path.join(D['remote'], jid + suf))
        except OSError:
            pass


def remote_requeue(j, why):
    """A laptop job that died, timed out or lost its worker goes back to the queue (3 tries, then `any` runs on the Mac
    and `laptop` is recorded lost)."""
    jid = j['id']
    j['attempts'] = j.get('attempts', 0) + 1
    j.setdefault('history', []).append({'t': now_s(), 'why': why})
    j.pop('claim', None)
    if j['attempts'] >= LAPTOP_MAX_ATTEMPTS:
        if j.get('where') == 'any':
            j['where'] = 'mac'
        else:
            _remote_drop(jid)
            _record_remote(j, 'lost', 2, 0, f'laptop gave up after {j["attempts"]} tries: {why}')
            return 'lost'
    qn = j.pop('_qname', None) or f'1-{time.time():.6f}-{jid}.json'
    wjson(os.path.join(D['queue'], qn), j)
    _remote_drop(jid)
    return 'requeued'


def _record_remote(j, status, code, wall, note=''):
    out = j['out']
    res = {'id': j['id'], 'name': j.get('name'), 'status': status, 'exit': code, 'host': 'laptop', 'out': out,
           'submitted': j.get('submitted'), 'ended': now_s(), 'wall_s': wall, 'note': note, 'attempts': j.get('attempts', 0) + 1,
           'conditions': {'load_start': [], 'full_speed': None}}
    wjson(os.path.join(out, 'result.json'), res)
    line = f'{j["id"]} {j.get("name") or ""} {status} exit {code} wall {wall} s on laptop' + (f' ({note})' if note else '')
    with open(os.path.join(out, 'result.txt'), 'w') as f:
        f.write(line + '\n')
    wjson(os.path.join(D['done'], j['id'] + '.json'), res)
    return res


def remote_finish(worker, jid, code, wall, how):
    """how: 'exit' (a real result, whatever the code), 'killed' (signal), 'timeout', 'cancelled'. Outputs are already
    rsynced into the job's out dir on the Mac."""
    path = os.path.join(D['remote'], jid + '.json')
    j = rjson(path)
    if not j or j.get('claim', {}).get('worker') != worker:
        return 'lost'
    if how in ('killed', 'timeout'):
        return remote_requeue(j, f'{how} on the laptop (exit {code})')
    _remote_drop(jid)
    _record_remote(j, 'cancelled' if how == 'cancelled' else 'done', code, wall,
                   'cancelled' if how == 'cancelled' else '')
    return 'done'


def reap_remote(now=None):
    """Daemon: requeue claims with no beat for LAPTOP_LEASE_S; honour cancels whose worker is gone."""
    now = now or time.time()
    for f in os.listdir(D['remote']):
        if not f.endswith('.json'):
            continue
        j = rjson(os.path.join(D['remote'], f))
        if not j:
            continue
        beat = j.get('claim', {}).get('beat', 0)
        if now - beat > LAPTOP_LEASE_S:
            if os.path.exists(os.path.join(D['remote'], j['id'] + '.cancel')):
                _remote_drop(j['id'])
                _record_remote(j, 'cancelled', 2, 0, 'cancelled; the laptop worker vanished')
            else:
                remote_requeue(j, f'no beat from the laptop worker for {int(now - beat)} s')


def find_done(jid):
    return os.path.join(D['done'], jid + '.json')


def cmd_wait(ids):
    ensure_daemon(fatal=False)
    ids = [i for i in ids if i]
    pending = set(ids)
    kq = select.kqueue()
    dfd = os.open(D['done'], os.O_RDONLY)
    ev = select.kevent(dfd, filter=select.KQ_FILTER_VNODE, flags=select.KQ_EV_ADD | select.KQ_EV_CLEAR,
                       fflags=select.KQ_NOTE_WRITE)
    worst = 0
    while pending:
        for jid in sorted(pending):
            res = rjson(find_done(jid))
            if res:
                pending.discard(jid)
                try:
                    print(open(os.path.join(res['out'], 'result.txt')).read().rstrip(), flush=True)
                except OSError:
                    print(json.dumps(res), flush=True)
                worst = max(worst, res.get('exit', 2) if res.get('status') == 'done' else max(res.get('exit', 2), 2))
            elif not any(f.endswith(jid + '.json') for f in os.listdir(D['queue']) + os.listdir(D['running']) + os.listdir(D['remote'])) \
                    and not find_done(jid):   # (it may have moved to done/ while we listed)
                print(f'{jid}: unknown job', flush=True)
                pending.discard(jid)
                worst = max(worst, 2)
        if pending:
            kq.control([ev], 1, 60)   # wakes when done/ changes; 60 s as a safety net
            ensure_daemon(fatal=False)
    os.close(dfd)
    return worst


