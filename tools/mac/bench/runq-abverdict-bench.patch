+def bench_of(out):
+    try: j=json.load(open(os.path.join(out,'result.json')))
+    except (OSError,ValueError): return None,'no result.json'
+    b=j.get('bench')
+    if not b: return None,'no bench result (window not reached?)'
+    if j.get('status') not in ('done',None): return None,'runq status '+str(j.get('status'))
+    if b.get('stall_frames') and b['stall_frames']>0.01*b['frames']: return None,'%d stall frames (guest clock ran on wall time)'%b['stall_frames']
+    return b,None
+def bench_verdict(a,b,eff,z=2.5):
+    """a, b: per-run costs (lower = faster). Welch se of the relative difference; FASTER/SLOWER/SAME/MORE."""
+    ma,mb=st.mean(a),st.mean(b); d=ma/mb-1   # >0: B costs less = faster
+    se=math.sqrt(st.variance(a)/len(a)+st.variance(b)/len(b))/mb
+    if abs(d)>z*se and abs(d)>0.002: return ('FASTER' if d>0 else 'SLOWER'),d,se
+    if abs(d)+1.96*se<eff: return 'SAME',d,se
+    return 'MORE',d,se
